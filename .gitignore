*cvn*.pdf
cvn/

# Python
__pycache__/

# Configuración personal / de editor y de herramientas locales
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
/.claude/
/.idea
