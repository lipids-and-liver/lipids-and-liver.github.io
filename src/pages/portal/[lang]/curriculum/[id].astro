---
import CurriculumDetailPage from '../../../../components/pages/CurriculumDetailPage.astro';
import { getAllSlugs, type Locale } from '../../../../utils/i18n';

export async function getStaticPaths() {
  const slugs = await getAllSlugs('team');
  const locales: Locale[] = ['eu', 'en'];
  const paths = [];
  for (const lang of locales) {
    for (const id of slugs) {
      paths.push({ params: { lang, id } });
    }
  }
  return paths;
}

const { lang, id } = Astro.params;
---

<CurriculumDetailPage id={id!} lang={lang as Locale} />
