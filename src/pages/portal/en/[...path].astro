---
// El inglés pasó a ser el idioma por defecto del portal (oct. 2026): /portal/en/* -> /portal/*
// Mantiene vivos los enlaces antiguos a la versión inglesa.
import { getAllSlugs } from '../../../utils/i18n';

export async function getStaticPaths() {
  // getStaticPaths se ejecuta aislado: las listas tienen que vivir aquí dentro
  const sections = ['', 'alumni', 'colaboraciones', 'contacto', 'curriculum', 'divulgacion', 'docencia', 'grupo',
    'lineas', 'noticias', 'patentes', 'proyectos', 'publicaciones', 'tesis', 'unete'];
  const details = { curriculum: 'team', lineas: 'research', noticias: 'news', tesis: 'theses' } as const;

  const paths: (string | undefined)[] = sections.map(s => s || undefined);
  for (const [section, collection] of Object.entries(details)) {
    for (const id of await getAllSlugs(collection)) paths.push(`${section}/${id}`);
  }
  return paths.map(path => ({ params: { path }, props: { target: path } }));
}

const { target } = Astro.props;
return Astro.redirect(target ? `/portal/${target}/` : '/portal/', 301);
---
