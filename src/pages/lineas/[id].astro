---
// URL corta heredada: /lineas/<id> -> /portal/lineas/<id>
import { getAllSlugs } from '../../utils/i18n';

export async function getStaticPaths() {
  const slugs = await getAllSlugs('research');
  return slugs.map(id => ({ params: { id } }));
}

return Astro.redirect(`/portal/lineas/${Astro.params.id}`, 301);
---
