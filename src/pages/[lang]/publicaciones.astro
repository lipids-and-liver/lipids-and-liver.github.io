---
import PublicationsPage from '../../components/pages/PublicationsPage.astro';
import type { Locale } from '../../utils/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'eu' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
---

<PublicationsPage lang={lang as Locale} />
