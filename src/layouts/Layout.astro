---
import { getTranslations, getLocalizedPath, getPathWithoutLocale, DEFAULT_LOCALE, LOCALES, type Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
  lang?: Locale;
  isHoldingPage?: boolean;
}

const {
  currentPage = "home",
  lang = DEFAULT_LOCALE,
  isHoldingPage = false
} = Astro.props;

const t = getTranslations(lang);
const title = Astro.props.title || t.site_title;
const description = Astro.props.description || t.site_description;
const currentPath = Astro.url.pathname;
const basePath = getPathWithoutLocale(currentPath);

// La página "En construcción" de la raíz mantiene el español como idioma por defecto (/, /eu/, /en/)
const holdingPath = (l: Locale) => (l === 'es' ? '/' : `/${l}/`);
const homeLink = isHoldingPage ? holdingPath(lang) : getLocalizedPath('/', lang);
const langLinks = LOCALES.map(code => ({
  code,
  label: code.toUpperCase(),
  href: isHoldingPage ? holdingPath(code) : getLocalizedPath(basePath, code),
}));
// Versiones alternativas para buscadores (x-default = idioma principal del portal)
const siteUrl = Astro.site ? Astro.site.origin : '';
const alternates = isHoldingPage ? [] : [
  ...langLinks.map(l => ({ hreflang: l.code, href: siteUrl + l.href })),
  { hreflang: 'x-default', href: siteUrl + getLocalizedPath(basePath, DEFAULT_LOCALE) },
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>

  <!-- Meta Tags for SEO & Institutional Branding -->
  <meta name="description" content={description} />
  <meta name="keywords" content="Lipids and Liver, UPV/EHU, Biocruces Bizkaia, Patricia Aspichueta, MAFLD, NASH, Tesis Doctorales, Lipidómica, Fisiología, Hepatología, Espectrometría de Masas" />
  
  <!-- Anti-Indexing during Development: Block all search engine bots -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Custom Institutional Stylesheet -->
  <link rel="stylesheet" href="/assets/css/styles.css" />

  <!-- Umami Analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="3b088faa-e063-478c-8b7e-d4aaec85a1dd"></script>

  <!-- Apply dismissed alert before first paint (avoids flash) -->
  <script is:inline>
    try {
      if (sessionStorage.getItem('lipids_demo_alert_dismissed') === '1') {
        document.documentElement.classList.add('demo-alert-hidden');
      }
    } catch(e) {}
  </script>
</head>
<body>

  <!-- Demo Notice Banner (Discreet & Dismissible, only in /portal/) -->
  {!isHoldingPage && (
    <aside class="demo-alert-banner" id="demo-alert-banner" role="alert" aria-label={t.demo_alert_aria}>
      <div class="container demo-alert-content">
        <div class="demo-alert-left">
          <span class="demo-alert-badge" data-title={t.demo_badge_title}>
            <i class="fas fa-flask"></i> {t.demo_alert_badge || "Versión Demo"}
          </span>
          <span class="demo-alert-text">
            {t.demo_alert_text || "Web en desarrollo: la información y datos mostrados son provisionales y están en proceso de validación."}
          </span>
        </div>
        <div class="demo-alert-right">
          <a href="https://www.ehu.eus/es/web/lipidsliver" target="_blank" rel="noopener" class="demo-alert-link" title={t.demo_official_title}>
            <span>{t.demo_alert_link || "Web Oficial UPV/EHU"}</span> <i class="fas fa-external-link-alt" style="font-size: 0.68rem;"></i>
          </a>
          <button type="button" class="demo-alert-close" id="btn-close-demo-alert" title={t.demo_alert_hide} aria-label={t.demo_alert_close}>
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    </aside>
  )}

  <!-- Top Institutional Bar -->
  <div class="top-institutional-bar">
    <div class="container top-bar-content">
      <div class="top-bar-left">
        <a href="https://www.ehu.eus" target="_blank" rel="noopener"><i class="fas fa-university"></i> {t.ehu_name_full}</a>
        <span>&bull;</span>
        <a href="https://www.biocrucesbizkaia.org" target="_blank" rel="noopener"><i class="fas fa-hospital-user"></i> IIS Biocruces Bizkaia</a>
      </div>
      <div class="top-bar-right">
        <span>{t.top_bar_dept}</span>
      </div>
    </div>
  </div>

  <!-- Main Institutional Header -->
  <header class="site-header" id="site-header">
    <div class="container">
      <div class="header-main-row">
        <!-- Marca de grupo de investigación según el manual de marca EHU (pág. 21):
             imagotipo EHU | Ikerketa taldea - Grupo de investigación | logo propio -->
        <div class="brand-logos-container">
          <a href={homeLink} class="brand-lockup-link">
            <img src="/assets/images/logo/marca_ehu_lipids_liver.svg" alt="EHU · Ikerketa taldea · Grupo de investigación · Lipids & Liver" class="brand-lockup-img" />
          </a>
          <div class="header-title-box">
            <span class="header-title-main">Lipids &amp; Liver</span>
            <span class="header-title-sub">{t.header_sub}</span>
          </div>
        </div>

        <div class="header-actions">
          <!-- Language Switcher -->
          <div class="lang-selector" id="lang-switch-group" role="group" aria-label={t.nav_language}>
            {langLinks.map(l => (
              <a href={l.href} class={`lang-btn ${lang === l.code ? 'active' : ''}`} hreflang={l.code} lang={l.code} aria-current={lang === l.code ? 'true' : undefined} data-lang={l.code}>{l.label}</a>
            ))}
          </div>

          <!-- Botón del menú hamburguesa (solo visible en pantallas estrechas) -->
          <button
            type="button"
            class="nav-toggle"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="main-nav-panel"
            aria-label={t.nav_menu_open}
            data-label-open={t.nav_menu_open}
            data-label-close={t.nav_menu_close}
          >
            <i class="fas fa-bars" aria-hidden="true"></i>
            <span class="nav-toggle-text">{t.nav_menu}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="nav-bar-row" id="main-nav-panel" aria-label={t.nav_menu}>
      <div class="container">
        <!-- Selector de idioma dentro del panel (solo en móvil, donde no cabe en la cabecera) -->
        <div class="lang-selector nav-panel-lang" role="group" aria-label={t.nav_language}>
          {langLinks.map(l => (
            <a href={l.href} class={`lang-btn ${lang === l.code ? 'active' : ''}`} hreflang={l.code} lang={l.code} aria-current={lang === l.code ? 'true' : undefined}>{l.label}</a>
          ))}
        </div>
        {isHoldingPage ? (
          <ul class="nav-menu" id="main-nav-links">
            <li class="nav-menu-item"><a href="#hero" class="active">{t.nav_home}</a></li>
            <li class="nav-menu-item"><a href="#resumen">{t.about_title}</a></li>
            <li class="nav-menu-item"><a href="#contacto">{t.nav_contact}</a></li>
          </ul>
        ) : (
          <ul class="nav-menu" id="main-nav-links">
            <!-- 1. Inicio -->
            <li class="nav-menu-item">
              <a href={getLocalizedPath('/', lang)} class={currentPage === 'home' ? 'active' : ''}>
                <i class="fas fa-home"></i> <span>{t.nav_home}</span>
              </a>
            </li>

            <!-- 2. El Grupo (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/grupo', lang)} class={`nav-dropdown-trigger ${['about', 'team', 'curriculum', 'alumni', 'collaborations'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_group || 'El Grupo'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/grupo', lang)}>
                    <i class="fas fa-landmark"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_about || 'Presentación'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_about}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/curriculum', lang)}>
                    <i class="fas fa-users"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_team || 'Personal e Investigadores'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_team}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/alumni', lang)}>
                    <i class="fas fa-user-graduate"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_alumni || 'Antiguos Miembros'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_alumni}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/colaboraciones', lang)}>
                    <i class="fas fa-project-diagram"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_collaborations || 'Alianzas y Colaboraciones'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_collab}</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 3. Investigación (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/lineas', lang)} class={`nav-dropdown-trigger ${['lines', 'projects', 'theses', 'pubs'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_research || 'Investigación'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/lineas', lang)}>
                    <i class="fas fa-microscope"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_lines || 'Líneas de Investigación'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_lines}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/proyectos', lang)}>
                    <i class="fas fa-hand-holding-usd"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_projects || 'Proyectos Financiados'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_projects}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/publicaciones', lang)}>
                    <i class="fas fa-book-open"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_pubs || 'Publicaciones Científicas'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_pubs}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/tesis', lang)}>
                    <i class="fas fa-graduation-cap"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_theses || 'Tesis Doctorales'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_theses}</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 4. Servicios & Transferencia (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/patentes', lang)} class={`nav-dropdown-trigger ${['patents', 'resources', 'outreach'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_transfer || 'Servicios & Transferencia'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/patentes', lang)}>
                    <i class="fas fa-certificate"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_patents || 'Propiedad Industrial y Patentes'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_patents}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/recursos', lang)}>
                    <i class="fas fa-lock-open"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">
                        {t.nav_resources || 'Ciencia Abierta y Protocolos'}
                        <span style="background:#ffedd5; color:#c2410c; font-size:0.68rem; font-weight:700; padding:2px 6px; border-radius:4px; margin-left:6px; border:1px solid #fdba74; display:inline-block; vertical-align:middle;">{t.phase2_badge}</span>
                      </span>
                      <span class="dropdown-link-sub">{t.nav_sub_resources}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/divulgacion', lang)}>
                    <i class="fas fa-heartbeat"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">
                        {t.nav_outreach || 'Divulgación y Salud Hepática'}
                        <span style="background:#ffedd5; color:#c2410c; font-size:0.68rem; font-weight:700; padding:2px 6px; border-radius:4px; margin-left:6px; border:1px solid #fdba74; display:inline-block; vertical-align:middle;">{t.phase2_badge}</span>
                      </span>
                      <span class="dropdown-link-sub">{t.nav_sub_outreach}</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 5. Formación & Talento (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/docencia', lang)} class={`nav-dropdown-trigger ${['training', 'join'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_training || 'Formación & Talento'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/docencia', lang)}>
                    <i class="fas fa-chalkboard-teacher"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_training || 'Docencia y Formación'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_training}</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/unete', lang)}>
                    <i class="fas fa-user-plus"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_join || 'Únete al Grupo'}</span>
                      <span class="dropdown-link-sub">{t.nav_sub_join}</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 6. Noticias -->
            <li class="nav-menu-item">
              <a href={getLocalizedPath('/noticias', lang)} class={currentPage === 'news' ? 'active' : ''}>
                <i class="fas fa-newspaper"></i> <span>{t.nav_news || 'Noticias'}</span>
              </a>
            </li>

            <!-- 7. Contacto -->
            <li class="nav-menu-item nav-menu-contact" style="margin-left:auto">
              <a href={getLocalizedPath('/contacto', lang)} class={`nav-contact-link ${currentPage === 'contact' ? 'active' : ''}`}>
                <i class="fas fa-envelope"></i> <span>{t.nav_contact}</span>
              </a>
            </li>
          </ul>
        )}
      </div>
    </nav>

    <!-- Contextual Utility Sub-Bar for Quick Selectors -->
    {Astro.slots.has('nav-extra') && (
      <div class="nav-sub-bar">
        <div class="container nav-sub-container">
          <div class="nav-sub-context">
            {currentPage === 'curriculum' && (
              <span class="nav-sub-badge"><i class="fas fa-users"></i> {t.nav_team}</span>
            )}
            {currentPage === 'theses' && (
              <span class="nav-sub-badge"><i class="fas fa-graduation-cap"></i> {t.theses_page_title}</span>
            )}
            {currentPage === 'lines' && (
              <span class="nav-sub-badge"><i class="fas fa-microscope"></i> {t.lines_title}</span>
            )}
            {currentPage === 'projects' && (
              <span class="nav-sub-badge"><i class="fas fa-hand-holding-usd"></i> {t.projects_title || 'Proyectos Financiados'}</span>
            )}
            {currentPage === 'news' && (
              <span class="nav-sub-badge"><i class="fas fa-newspaper"></i> {t.news_title || 'Noticias y Actualidad'}</span>
            )}
            {currentPage === 'alumni' && (
              <span class="nav-sub-badge"><i class="fas fa-user-graduate"></i> {t.alumni_title || 'Antiguos Miembros y Alumni'}</span>
            )}
          </div>
          <div class="nav-sub-action">
            <slot name="nav-extra" />
          </div>
        </div>
      </div>
    )}
  </header>

  <main>
    <slot />
  </main>

  <!-- Institutional Footer with Both Logos -->
  <footer class="institutional-footer">
    <!-- Franja clara de logos institucionales en su versión original a color -->
    <div class="footer-logos-strip">
      <div class="container footer-logos-row">
        <img src="/assets/images/logo/marca_ehu_lipids_liver.svg" alt="EHU · Ikerketa taldea · Grupo de investigación · Lipids & Liver" class="footer-logo-img" loading="lazy" />
      </div>
    </div>

    <div class="container">
      <div class="footer-grid-inst">
        <div>
          <h4>{t.hero_title}</h4>
          <p set:html={t.footer_desc}></p>
        </div>
        <div>
          <h4>{t.nav_group_group || 'El Grupo'} &amp; {t.nav_group_research || 'Investigación'}</h4>
          {isHoldingPage ? (
            <ul class="footer-links-inst">
              <li><a href="#hero">{t.nav_home}</a></li>
              <li><a href="#resumen">{t.about_title}</a></li>
              <li><a href="#contacto">{t.nav_contact}</a></li>
            </ul>
          ) : (
            <ul class="footer-links-inst">
              <li><a href={getLocalizedPath('/', lang)}>{t.nav_home}</a></li>
              <li><a href={getLocalizedPath('/grupo', lang)}>{t.nav_about}</a></li>
              <li><a href={getLocalizedPath('/lineas', lang)}>{t.nav_lines}</a></li>
              <li><a href={getLocalizedPath('/proyectos', lang)}>{t.nav_projects || 'Proyectos Financiados'}</a></li>
              <li><a href={getLocalizedPath('/curriculum', lang)}>{t.nav_team}</a></li>
              <li><a href={getLocalizedPath('/tesis', lang)}>{t.theses_page_title}</a></li>
              <li><a href={getLocalizedPath('/publicaciones', lang)}>{t.pubs_title}</a></li>
            </ul>
          )}
        </div>
        <div>
          <h4>{t.nav_group_services || 'Servicios'} &amp; {t.nav_group_training || 'Talento'}</h4>
          <ul class="footer-links-inst">
            <li>
              <a href={getLocalizedPath('/patentes', lang)}>
                {t.nav_patents || 'Propiedad Industrial y Patentes'}
              </a>
            </li>
            <li>
              <a href={getLocalizedPath('/recursos', lang)}>
                {t.nav_resources || 'Ciencia Abierta y Protocolos'}
                <span style="background:#ffedd5; color:#c2410c; font-size:0.65rem; font-weight:700; padding:1px 5px; border-radius:3px; margin-left:5px; border:1px solid #fdba74; display:inline-block;">{t.phase2_badge_short}</span>
              </a>
            </li>
            <li><a href={getLocalizedPath('/docencia', lang)}>{t.nav_training || 'Docencia y Formación'}</a></li>
            <li><a href={getLocalizedPath('/unete', lang)}>{t.nav_join || 'Únete al Grupo'}</a></li>
            <li>
              <a href={getLocalizedPath('/alumni', lang)}>
                {t.nav_alumni || 'Antiguos Miembros'}
              </a>
            </li>
            <li><a href={getLocalizedPath('/noticias', lang)}>{t.nav_news || 'Noticias y Actualidad'}</a></li>
            <li>
              <a href={getLocalizedPath('/divulgacion', lang)}>
                {t.nav_outreach || 'Divulgación Científica'}
                <span style="background:#ffedd5; color:#c2410c; font-size:0.65rem; font-weight:700; padding:1px 5px; border-radius:3px; margin-left:5px; border:1px solid #fdba74; display:inline-block;">{t.phase2_badge_short}</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h4>{t.footer_interest}</h4>
          <ul class="footer-links-inst">
            <li><a href="https://www.ehu.eus" target="_blank" rel="noopener">{t.ehu_name_short}</a></li>
            <li><a href="https://www.biocrucesbizkaia.org" target="_blank" rel="noopener">IIS Biocruces Bizkaia</a></li>
            <li><a href="https://ehu-ibio.org" target="_blank" rel="noopener">EHU-iBio</a></li>
            <li><a href="https://www.ciberehd.org" target="_blank" rel="noopener">CIBERehd (ISCIII)</a></li>
            <li><a href="https://easl.eu" target="_blank" rel="noopener">EASL - European Liver Community</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-copyright">
        <div>&copy; 2026 {t.footer_copy}</div>
        <div>{t.footer_location}</div>
      </div>
    </div>
  </footer>

  <!-- Institutional Demo Disclaimer Modal (Prominent & Clear, Shown Initially in /portal/) -->
  {!isHoldingPage && (
    <div class="demo-modal-backdrop" id="demo-disclaimer-modal" role="dialog" aria-modal="true" aria-labelledby="demo-modal-title">
      <div class="demo-modal-card">
        <button type="button" class="demo-modal-close" id="btn-close-demo-modal" aria-label={t.demo_modal_close}>
          <i class="fas fa-times"></i>
        </button>

        <div class="demo-modal-header">
          <div class="demo-modal-icon-badge">
            <i class="fas fa-flask"></i>
          </div>
          <div>
            <div class="demo-modal-tag"><i class="fas fa-exclamation-triangle"></i> {t.demo_alert_badge || "Versión Demo"}</div>
            <h2 class="demo-modal-title" id="demo-modal-title">{t.demo_modal_title}</h2>
            <p class="demo-modal-subtitle">{t.demo_modal_sub}</p>
          </div>
        </div>

        <div class="demo-modal-body">
          <p class="demo-modal-lead">{t.demo_modal_p1}</p>

          <div class="demo-modal-warning-box">
            <div class="demo-warning-header">
              <i class="fas fa-info-circle"></i>
              <span>{t.demo_modal_box_title}</span>
            </div>
            <p>{t.demo_modal_box_text}</p>
          </div>

          <div class="demo-modal-official-box">
            <div class="demo-official-label">{t.demo_modal_official_note}</div>
            <a href="https://www.ehu.eus/es/web/lipidsliver" target="_blank" rel="noopener" class="demo-official-link-card">
              <div class="demo-official-link-left">
                <i class="fas fa-university"></i>
                <div>
                  <span class="demo-official-link-name">{t.demo_official_portal_name}</span>
                  <span class="demo-official-link-url">https://www.ehu.eus/es/web/lipidsliver</span>
                </div>
              </div>
              <i class="fas fa-external-link-alt" style="color:var(--text-muted); font-size:0.85rem;"></i>
            </a>
          </div>
        </div>

        <div class="demo-modal-footer">
          <button type="button" class="btn-demo-modal-accept" id="btn-accept-demo-modal">
            <i class="fas fa-check"></i> {t.demo_modal_btn_accept}
          </button>
          <a href="https://www.ehu.eus/es/web/lipidsliver" target="_blank" rel="noopener" class="btn-demo-modal-secondary">
            <i class="fas fa-external-link-alt"></i> {t.demo_modal_btn_official}
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Navigation menu logic -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Navigation: hamburger panel and accordion dropdowns below 1100px
      const header = document.getElementById('site-header');
      const navToggle = document.getElementById('nav-toggle');
      const navPanel = document.getElementById('main-nav-panel');
      const dropdownItems = Array.from(document.querySelectorAll('.nav-menu-item.has-dropdown'));
      const compactNav = window.matchMedia('(max-width: 1100px)');

      // aria-expanded solo tiene sentido en el panel (en escritorio se despliega al pasar el ratón)
      const setDropdown = (item, open) => {
        item.classList.toggle('open', open);
        const trigger = item.querySelector('.nav-dropdown-trigger');
        if (!trigger) return;
        if (compactNav.matches) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        else trigger.removeAttribute('aria-expanded');
      };

      const setMenu = (open, { focusToggle = false } = {}) => {
        if (!header || !navToggle) return;
        header.classList.toggle('nav-open', open);
        navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        navToggle.setAttribute('aria-label', open ? navToggle.dataset.labelClose : navToggle.dataset.labelOpen);
        const icon = navToggle.querySelector('i');
        if (icon) icon.className = open ? 'fas fa-xmark' : 'fas fa-bars';
        if (!open) dropdownItems.forEach(item => setDropdown(item, false));
        if (focusToggle) navToggle.focus();
      };

      if (navToggle) {
        navToggle.addEventListener('click', () => setMenu(!header.classList.contains('nav-open')));
      }

      // En el panel, el título de cada grupo despliega su lista (acordeón) en lugar de navegar:
      // su destino es siempre el primer enlace de la lista
      dropdownItems.forEach(item => {
        const trigger = item.querySelector('.nav-dropdown-trigger');
        if (!trigger) return;
        setDropdown(item, false);
        trigger.addEventListener('click', (e) => {
          if (!compactNav.matches) return;
          e.preventDefault();
          const willOpen = !item.classList.contains('open');
          dropdownItems.forEach(other => setDropdown(other, other === item && willOpen));
        });
      });

      // Cerrar con Esc, al pulsar fuera o al elegir un destino
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header && header.classList.contains('nav-open')) {
          setMenu(false, { focusToggle: true });
        }
      });
      document.addEventListener('click', (e) => {
        if (header && header.classList.contains('nav-open') && !header.contains(e.target)) setMenu(false);
      });
      if (navPanel) {
        navPanel.addEventListener('click', (e) => {
          const link = e.target.closest('a');
          if (link && !link.classList.contains('nav-dropdown-trigger')) setMenu(false);
        });
      }

      // Al pasar a escritorio, el panel deja de existir: restablecer estado
      compactNav.addEventListener('change', () => {
        setMenu(false);
        dropdownItems.forEach(item => setDropdown(item, false));
      });

      // 2. Demo Alert Banner dismissal
      const closeAlertBtn = document.getElementById('btn-close-demo-alert');
      const alertBanner = document.getElementById('demo-alert-banner');
      if (closeAlertBtn && alertBanner) {
        closeAlertBtn.addEventListener('click', () => {
          alertBanner.classList.add('is-dismissed');
          document.documentElement.classList.add('demo-alert-hidden');
          try {
            sessionStorage.setItem('lipids_demo_alert_dismissed', '1');
          } catch (e) {}
        });
      }

      // 3. Demo Disclaimer Modal logic (Auto-opens on first visit to /portal/)
      const demoModal = document.getElementById('demo-disclaimer-modal');
      const acceptBtn = document.getElementById('btn-accept-demo-modal');
      const closeDemoModalBtn = document.getElementById('btn-close-demo-modal');

      function closeDemoModal() {
        if (!demoModal) return;
        demoModal.classList.remove('is-active');
        document.body.style.overflow = '';
        try {
          sessionStorage.setItem('lipids_demo_modal_seen', '1');
        } catch(e) {}
      }

      function openDemoModal() {
        if (!demoModal) return;
        demoModal.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      }

      if (demoModal) {
        try {
          if (sessionStorage.getItem('lipids_demo_modal_seen') !== '1') {
            setTimeout(openDemoModal, 250);
          }
        } catch(e) {
          setTimeout(openDemoModal, 250);
        }

        if (acceptBtn) acceptBtn.addEventListener('click', closeDemoModal);
        if (closeDemoModalBtn) closeDemoModalBtn.addEventListener('click', closeDemoModal);

        demoModal.addEventListener('click', (e) => {
          if (e.target === demoModal) closeDemoModal();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && demoModal.classList.contains('is-active')) {
            closeDemoModal();
          }
        });

        // Clickable badge in top banner allows reopening the modal anytime
        const topDemoTrigger = document.querySelector('.demo-alert-badge');
        if (topDemoTrigger) {
          topDemoTrigger.style.cursor = 'pointer';
          topDemoTrigger.title = topDemoTrigger.dataset.title || '';
          topDemoTrigger.addEventListener('click', openDemoModal);
        }
      }
    });
  </script>
</body>
</html>
