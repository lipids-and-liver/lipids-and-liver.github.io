---
import { getTranslations, getLocalizedPath, getPathWithoutLocale, type Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
  lang?: Locale;
  isHoldingPage?: boolean;
}

const {
  title = "Lipids & Liver - Grupo de Investigación Consolidado | UPV/EHU & IIS Biocruces Bizkaia",
  description = "Página oficial del Grupo de Investigación Consolidado Lipids & Liver de la Universidad del País Vasco (UPV/EHU) e Instituto Sanitario Biocruces Bizkaia. Investigación en esteatosis hepática (MAFLD), cáncer hepático, lipidómica, tesis doctorales y exposoma.",
  currentPage = "home",
  lang = "es",
  isHoldingPage = false
} = Astro.props;

const t = getTranslations(lang);
const currentPath = Astro.url.pathname;
const basePath = getPathWithoutLocale(currentPath);

const homeLink = isHoldingPage ? (lang === 'es' ? '/' : `/${lang}/`) : getLocalizedPath('/', lang);
const langEsLink = isHoldingPage ? '/' : getLocalizedPath(basePath, 'es');
const langEuLink = isHoldingPage ? '/eu/' : getLocalizedPath(basePath, 'eu');
const langEnLink = isHoldingPage ? '/en/' : getLocalizedPath(basePath, 'en');
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Meta Tags for SEO & Institutional Branding -->
  <meta name="description" content={description} />
  <meta name="keywords" content="Lipids and Liver, UPV/EHU, Biocruces Bizkaia, Patricia Aspichueta, MAFLD, NASH, Tesis Doctorales, Lipidómica, Fisiología, Hepatología, Espectrometría de Masas" />
  
  <!-- Anti-Indexing during Development: Block all search engine bots -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Custom Institutional Stylesheet -->
  <link rel="stylesheet" href="/assets/css/styles.css" />

  <!-- Prevent alert flash if previously dismissed in session -->
  <script is:inline>
    try {
      if (sessionStorage.getItem('lipids_demo_alert_dismissed') === '1') {
        document.documentElement.classList.add('demo-alert-hidden');
      }
    } catch(e) {}
  </script>
</head>
<body>

  <!-- Demo Notice Banner (Discreet & Dismissible, only in /portal/) -->
  {!isHoldingPage && (
    <aside class="demo-alert-banner" id="demo-alert-banner" role="alert" aria-label="Aviso de versión de desarrollo">
      <div class="container demo-alert-content">
        <div class="demo-alert-left">
          <span class="demo-alert-badge">
            <i class="fas fa-flask"></i> {t.demo_alert_badge || "Versión Demo"}
          </span>
          <span class="demo-alert-text">
            {t.demo_alert_text || "Web en desarrollo: la información y datos mostrados son provisionales y están en proceso de validación."}
          </span>
        </div>
        <div class="demo-alert-right">
          <a href="https://www.ehu.eus/es/web/lipidsliver" target="_blank" rel="noopener" class="demo-alert-link" title="Consultar web institucional oficial actual">
            <span>{t.demo_alert_link || "Web Oficial UPV/EHU"}</span> <i class="fas fa-external-link-alt" style="font-size: 0.68rem;"></i>
          </a>
          <button type="button" class="demo-alert-close" id="btn-close-demo-alert" title="Ocultar aviso" aria-label="Cerrar aviso">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    </aside>
  )}

  <!-- Top Institutional Bar -->
  <div class="top-institutional-bar">
    <div class="container top-bar-content">
      <div class="top-bar-left">
        <a href="https://www.ehu.eus" target="_blank" rel="noopener"><i class="fas fa-university"></i> Universidad del País Vasco / Euskal Herriko Unibertsitatea</a>
        <span>&bull;</span>
        <a href="https://www.biocrucesbizkaia.org" target="_blank" rel="noopener"><i class="fas fa-hospital-user"></i> IIS Biocruces Bizkaia</a>
      </div>
      <div class="top-bar-right">
        <span>{t.top_bar_dept}</span>
      </div>
    </div>
  </div>

  <!-- Main Institutional Header -->
  <header class="site-header" id="site-header">
    <div class="container">
      <div class="header-main-row">
        <!-- Dual Logos Container: EHU Logo + Group Logo -->
        <div class="brand-logos-container">
          <a href={homeLink}>
            <img src="/assets/images/logo/ehu_logo_positiboa.svg" alt="UPV/EHU Logo" class="ehu-logo-img" id="ehu-header-logo" />
          </a>
          <div class="brand-divider"></div>
          <a href={homeLink}>
            <img src="/assets/images/logo/lipid_liver_logo.png" alt="Lipids & Liver Logo" class="group-logo-img" />
          </a>
          <div class="header-title-box">
            <span class="header-title-main">Lipids &amp; Liver</span>
            <span class="header-title-sub">{t.header_sub}</span>
          </div>
        </div>

        <div class="header-actions">
          <!-- Language Switcher -->
          <div class="lang-selector" id="lang-switch-group">
            <a href={langEsLink} class={`lang-btn ${lang === 'es' ? 'active' : ''}`} style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;" data-lang="es">ES</a>
            <a href={langEuLink} class={`lang-btn ${lang === 'eu' ? 'active' : ''}`} style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;" data-lang="eu">EU</a>
            <a href={langEnLink} class={`lang-btn ${lang === 'en' ? 'active' : ''}`} style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;" data-lang="en">EN</a>
          </div>

          <!-- Theme Toggle -->
          <button class="theme-toggle-btn" id="theme-toggle" title={t.theme_toggle_title} data-light={t.theme_light} data-dark={t.theme_dark}>
            <i class="fas fa-moon"></i> <span class="theme-toggle-text">{t.theme_dark}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="nav-bar-row">
      <div class="container">
        {isHoldingPage ? (
          <ul class="nav-menu" id="main-nav-links">
            <li class="nav-menu-item"><a href="#hero" class="active">{t.nav_home}</a></li>
            <li class="nav-menu-item"><a href="#resumen">{t.about_title}</a></li>
            <li class="nav-menu-item"><a href="#contacto">{t.nav_contact}</a></li>
          </ul>
        ) : (
          <ul class="nav-menu" id="main-nav-links">
            <!-- 1. Inicio -->
            <li class="nav-menu-item">
              <a href={getLocalizedPath('/', lang)} class={currentPage === 'home' ? 'active' : ''}>
                <i class="fas fa-home"></i> <span>{t.nav_home}</span>
              </a>
            </li>

            <!-- 2. El Grupo (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/#about', lang)} class={`nav-dropdown-trigger ${['about', 'team', 'curriculum', 'alumni'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_group || 'El Grupo'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/#about', lang)}>
                    <i class="fas fa-landmark"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_about || 'Presentación'}</span>
                      <span class="dropdown-link-sub">Perfil e instalaciones del grupo</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/#team', lang)}>
                    <i class="fas fa-users"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_team || 'Personal e Investigadores'}</span>
                      <span class="dropdown-link-sub">PDI, postdocs, predocs y técnicos</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/curriculum', lang)}>
                    <i class="fas fa-id-card"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_cv_portal || 'Portal de Currículums'}</span>
                      <span class="dropdown-link-sub">CVs y perfiles de los miembros</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/alumni', lang)}>
                    <i class="fas fa-user-graduate"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_alumni || 'Antiguos Miembros (Alumni)'}</span>
                      <span class="dropdown-link-sub">Puestos actuales de los doctores</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/#collaborations', lang)}>
                    <i class="fas fa-project-diagram"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_collaborations || 'Alianzas y Colaboraciones'}</span>
                      <span class="dropdown-link-sub">Hospitales, centros y consorcios</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 3. Investigación (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/#lines', lang)} class={`nav-dropdown-trigger ${['lines', 'projects', 'theses', 'pubs'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_research || 'Investigación'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/#lines', lang)}>
                    <i class="fas fa-microscope"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_lines || 'Líneas de Investigación'}</span>
                      <span class="dropdown-link-sub">MASH, cáncer hepático, ómicas</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/proyectos', lang)}>
                    <i class="fas fa-hand-holding-usd"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_projects || 'Proyectos Financiados'}</span>
                      <span class="dropdown-link-sub">Plan Nacional, Gobierno Vasco, FEDER</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/publicaciones', lang)}>
                    <i class="fas fa-book-open"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_pubs || 'Publicaciones Científicas'}</span>
                      <span class="dropdown-link-sub">Artículos JCR con filtros temáticos</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/tesis', lang)}>
                    <i class="fas fa-graduation-cap"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_theses || 'Tesis Doctorales'}</span>
                      <span class="dropdown-link-sub">Tesis en curso y defendidas</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 4. Servicios & Recursos (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/sgiker', lang)} class={`nav-dropdown-trigger ${['sgiker', 'resources', 'training'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_services || 'Servicios & Recursos'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/sgiker', lang)}>
                    <i class="fas fa-flask"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_sgiker || 'Unidad de Lipidómica SGIker'}</span>
                      <span class="dropdown-link-sub">UHPLC-MS/MS, tarifas y solicitudes</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/recursos', lang)}>
                    <i class="fas fa-lock-open"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_resources || 'Ciencia Abierta y Protocolos'}</span>
                      <span class="dropdown-link-sub">SOPs validados y datos FAIR</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/#training', lang)}>
                    <i class="fas fa-chalkboard-teacher"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_training || 'Docencia y Formación'}</span>
                      <span class="dropdown-link-sub">Grados, Másteres y Doctorado</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 5. Sociedad & Novedades (Dropdown) -->
            <li class="nav-menu-item has-dropdown">
              <a href={getLocalizedPath('/noticias', lang)} class={`nav-dropdown-trigger ${['news', 'outreach', 'join'].includes(currentPage) ? 'active' : ''}`}>
                <span>{t.nav_group_impact || 'Sociedad & Novedades'}</span> <i class="fas fa-chevron-down nav-caret"></i>
              </a>
              <ul class="nav-dropdown-menu">
                <li>
                  <a href={getLocalizedPath('/noticias', lang)}>
                    <i class="fas fa-newspaper"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_news || 'Noticias y Sala de Prensa'}</span>
                      <span class="dropdown-link-sub">Avances, congresos y premios</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/divulgacion', lang)}>
                    <i class="fas fa-heartbeat"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_outreach || 'Divulgación y Salud Hepática'}</span>
                      <span class="dropdown-link-sub">Guías para pacientes y Zientzia Astea</span>
                    </div>
                  </a>
                </li>
                <li>
                  <a href={getLocalizedPath('/unete', lang)}>
                    <i class="fas fa-user-plus"></i>
                    <div class="dropdown-link-text">
                      <span class="dropdown-link-title">{t.nav_join || 'Únete al Grupo'}</span>
                      <span class="dropdown-link-sub">Oportunidades TFG, TFM, FPU/FPI</span>
                    </div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- 6. Contacto -->
            <li class="nav-menu-item nav-menu-contact" style="margin-left:auto">
              <a href={getLocalizedPath('/#contact', lang)} class="nav-contact-link">
                <i class="fas fa-envelope"></i> <span>{t.nav_contact}</span>
              </a>
            </li>
          </ul>
        )}
      </div>
    </nav>

    <!-- Contextual Utility Sub-Bar for Quick Selectors -->
    {Astro.slots.has('nav-extra') && (
      <div class="nav-sub-bar">
        <div class="container nav-sub-container">
          <div class="nav-sub-context">
            {currentPage === 'curriculum' && (
              <span class="nav-sub-badge"><i class="fas fa-id-card"></i> {t.nav_cv_portal}</span>
            )}
            {currentPage === 'theses' && (
              <span class="nav-sub-badge"><i class="fas fa-graduation-cap"></i> {t.theses_page_title}</span>
            )}
            {currentPage === 'lines' && (
              <span class="nav-sub-badge"><i class="fas fa-microscope"></i> {t.lines_title}</span>
            )}
            {currentPage === 'projects' && (
              <span class="nav-sub-badge"><i class="fas fa-hand-holding-usd"></i> {t.projects_title || 'Proyectos Financiados'}</span>
            )}
            {currentPage === 'news' && (
              <span class="nav-sub-badge"><i class="fas fa-newspaper"></i> {t.news_title || 'Noticias y Actualidad'}</span>
            )}
            {currentPage === 'alumni' && (
              <span class="nav-sub-badge"><i class="fas fa-user-graduate"></i> {t.alumni_title || 'Antiguos Miembros y Alumni'}</span>
            )}
          </div>
          <div class="nav-sub-action">
            <slot name="nav-extra" />
          </div>
        </div>
      </div>
    )}
  </header>

  <main>
    <slot />
  </main>

  <!-- Institutional Footer with Both Logos -->
  <footer class="institutional-footer">
    <div class="container">
      <div class="footer-logos-row">
        <img src="/assets/images/logo/ehu_logo_negatiboa.svg" alt="UPV/EHU Logo" style="height:44px" />
        <div style="width:1px; height:36px; background:rgba(255,255,255,0.2)"></div>
        <img src="/assets/images/logo/lipid_liver_logo.png" alt="Lipids & Liver Logo" style="height:48px; filter: brightness(0) invert(1);" />
      </div>

      <div class="footer-grid-inst">
        <div>
          <h4>{t.hero_title}</h4>
          <p set:html={t.footer_desc}></p>
        </div>
        <div>
          <h4>{t.footer_nav}</h4>
          {isHoldingPage ? (
            <ul class="footer-links-inst">
              <li><a href="#hero">{t.nav_home}</a></li>
              <li><a href="#resumen">{t.about_title}</a></li>
              <li><a href="#contacto">{t.nav_contact}</a></li>
            </ul>
          ) : (
            <ul class="footer-links-inst">
              <li><a href={getLocalizedPath('/', lang)}>{t.nav_home}</a></li>
              <li><a href={getLocalizedPath('/#about', lang)}>{t.nav_about}</a></li>
              <li><a href={getLocalizedPath('/#lines', lang)}>{t.nav_lines}</a></li>
              <li><a href={getLocalizedPath('/proyectos', lang)}>{t.nav_projects || 'Proyectos Financiados'}</a></li>
              <li><a href={getLocalizedPath('/#team', lang)}>{t.nav_team}</a></li>
              <li><a href={getLocalizedPath('/tesis', lang)}>{t.theses_page_title}</a></li>
              <li><a href={getLocalizedPath('/publicaciones', lang)}>{t.pubs_title}</a></li>
              <li><a href={getLocalizedPath('/sgiker', lang)}>{t.nav_sgiker || 'Unidad Lipidómica SGIker'}</a></li>
              <li><a href={getLocalizedPath('/noticias', lang)}>{t.nav_news || 'Noticias y Actualidad'}</a></li>
              <li><a href={getLocalizedPath('/recursos', lang)}>{t.nav_resources || 'Ciencia Abierta y Protocolos'}</a></li>
              <li><a href={getLocalizedPath('/divulgacion', lang)}>{t.nav_outreach || 'Divulgación Científica'}</a></li>
              <li><a href={getLocalizedPath('/unete', lang)}>{t.nav_join || 'Únete al Grupo'}</a></li>
              <li><a href={getLocalizedPath('/alumni', lang)}>{t.nav_alumni || 'Antiguos Miembros (Alumni)'}</a></li>
              <li><a href={getLocalizedPath('/curriculum', lang)}>{t.nav_cv_portal}</a></li>
            </ul>
          )}
        </div>
        <div>
          <h4>{t.footer_interest}</h4>
          <ul class="footer-links-inst">
            <li><a href="https://www.ehu.eus" target="_blank" rel="noopener">Universidad del País Vasco (UPV/EHU)</a></li>
            <li><a href="https://www.biocrucesbizkaia.org" target="_blank" rel="noopener">IIS Biocruces Bizkaia</a></li>
            <li><a href="https://www.ehu.eus/es/web/sgiker" target="_blank" rel="noopener">SGIker UPV/EHU (Lipidómica)</a></li>
            <li><a href="https://www.ciberehd.org" target="_blank" rel="noopener">CIBERehd (ISCIII)</a></li>
            <li><a href="https://easl.eu" target="_blank" rel="noopener">EASL - European Liver Community</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-copyright">
        <div>&copy; 2026 {t.footer_copy}</div>
        <div>{t.footer_location}</div>
      </div>
    </div>
  </footer>

  <!-- Institutional Demo Disclaimer Modal (Prominent & Clear, Shown Initially in /portal/) -->
  {!isHoldingPage && (
    <div class="demo-modal-backdrop" id="demo-disclaimer-modal" role="dialog" aria-modal="true" aria-labelledby="demo-modal-title">
      <div class="demo-modal-card">
        <button type="button" class="demo-modal-close" id="btn-close-demo-modal" aria-label="Cerrar ventana emergente">
          <i class="fas fa-times"></i>
        </button>

        <div class="demo-modal-header">
          <div class="demo-modal-icon-badge">
            <i class="fas fa-flask"></i>
          </div>
          <div>
            <div class="demo-modal-tag"><i class="fas fa-exclamation-triangle"></i> {t.demo_alert_badge || "Versión Demo"}</div>
            <h2 class="demo-modal-title" id="demo-modal-title">{t.demo_modal_title}</h2>
            <p class="demo-modal-subtitle">{t.demo_modal_sub}</p>
          </div>
        </div>

        <div class="demo-modal-body">
          <p class="demo-modal-lead">{t.demo_modal_p1}</p>

          <div class="demo-modal-warning-box">
            <div class="demo-warning-header">
              <i class="fas fa-info-circle"></i>
              <span>{t.demo_modal_box_title}</span>
            </div>
            <p>{t.demo_modal_box_text}</p>
          </div>

          <div class="demo-modal-official-box">
            <div class="demo-official-label">{t.demo_modal_official_note}</div>
            <a href="https://www.ehu.eus/es/web/lipidsliver" target="_blank" rel="noopener" class="demo-official-link-card">
              <div class="demo-official-link-left">
                <i class="fas fa-university"></i>
                <div>
                  <span class="demo-official-link-name">Portal Oficial Lipids &amp; Liver en UPV/EHU</span>
                  <span class="demo-official-link-url">https://www.ehu.eus/es/web/lipidsliver</span>
                </div>
              </div>
              <i class="fas fa-external-link-alt" style="color:var(--text-muted); font-size:0.85rem;"></i>
            </a>
          </div>
        </div>

        <div class="demo-modal-footer">
          <button type="button" class="btn-demo-modal-accept" id="btn-accept-demo-modal">
            <i class="fas fa-check"></i> {t.demo_modal_btn_accept}
          </button>
          <a href="https://www.ehu.eus/es/web/lipidsliver" target="_blank" rel="noopener" class="btn-demo-modal-secondary">
            <i class="fas fa-external-link-alt"></i> {t.demo_modal_btn_official}
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Theme Toggle logic -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Theme setup
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      updateThemeUI(savedTheme);

      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme');
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          updateThemeUI(next);
        });
      }

      function updateThemeUI(theme) {
        const icon = document.querySelector('#theme-toggle i');
        const text = document.querySelector('#theme-toggle .theme-toggle-text');
        const ehuLogo = document.getElementById('ehu-header-logo');
        const themeBtn = document.getElementById('theme-toggle');
        const lightText = themeBtn ? themeBtn.dataset.light || 'Modo Claro' : 'Modo Claro';
        const darkText = themeBtn ? themeBtn.dataset.dark || 'Modo Oscuro' : 'Modo Oscuro';

        if (icon) icon.className = theme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
        if (text) text.textContent = theme === 'dark' ? lightText : darkText;
        if (ehuLogo) ehuLogo.src = theme === 'dark' 
          ? '/assets/images/logo/ehu_logo_negatiboa.svg' 
          : '/assets/images/logo/ehu_logo_positiboa.svg';
      }

      // 2. Dropdown menu behavior for mobile & keyboard navigation
      const dropdownItems = document.querySelectorAll('.nav-menu-item.has-dropdown');
      dropdownItems.forEach(item => {
        const trigger = item.querySelector('.nav-dropdown-trigger');
        if (trigger) {
          trigger.addEventListener('click', (e) => {
            if (window.innerWidth <= 992) {
              const isOpen = item.classList.contains('open');
              if (!isOpen) {
                e.preventDefault();
                dropdownItems.forEach(d => d.classList.remove('open'));
                item.classList.add('open');
              }
            }
          });
        }
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.has-dropdown')) {
          dropdownItems.forEach(item => item.classList.remove('open'));
        }
      });

      // 3. Demo Alert Banner dismissal
      const closeAlertBtn = document.getElementById('btn-close-demo-alert');
      const alertBanner = document.getElementById('demo-alert-banner');
      if (closeAlertBtn && alertBanner) {
        closeAlertBtn.addEventListener('click', () => {
          alertBanner.classList.add('is-dismissed');
          document.documentElement.classList.add('demo-alert-hidden');
          try {
            sessionStorage.setItem('lipids_demo_alert_dismissed', '1');
          } catch (e) {}
        });
      }

      // 4. Demo Disclaimer Modal logic (Auto-opens on first visit to /portal/)
      const demoModal = document.getElementById('demo-disclaimer-modal');
      const acceptBtn = document.getElementById('btn-accept-demo-modal');
      const closeDemoModalBtn = document.getElementById('btn-close-demo-modal');

      function closeDemoModal() {
        if (!demoModal) return;
        demoModal.classList.remove('is-active');
        document.body.style.overflow = '';
        try {
          sessionStorage.setItem('lipids_demo_modal_seen', '1');
        } catch(e) {}
      }

      function openDemoModal() {
        if (!demoModal) return;
        demoModal.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      }

      if (demoModal) {
        try {
          if (sessionStorage.getItem('lipids_demo_modal_seen') !== '1') {
            setTimeout(openDemoModal, 250);
          }
        } catch(e) {
          setTimeout(openDemoModal, 250);
        }

        if (acceptBtn) acceptBtn.addEventListener('click', closeDemoModal);
        if (closeDemoModalBtn) closeDemoModalBtn.addEventListener('click', closeDemoModal);

        demoModal.addEventListener('click', (e) => {
          if (e.target === demoModal) closeDemoModal();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && demoModal.classList.contains('is-active')) {
            closeDemoModal();
          }
        });

        // Clickable badge in top banner allows reopening the modal anytime
        const topDemoTrigger = document.querySelector('.demo-alert-badge');
        if (topDemoTrigger) {
          topDemoTrigger.style.cursor = 'pointer';
          topDemoTrigger.title = 'Ver aviso detallado de la versión demo';
          topDemoTrigger.addEventListener('click', openDemoModal);
        }
      }
    });
  </script>
</body>
</html>
