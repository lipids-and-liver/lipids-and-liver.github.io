    function setCinemaLang(lang) {
      document.querySelectorAll('.lang-btn-cinema').forEach(b => {
        const btnLang = (b.getAttribute('data-cinema-lang') || b.textContent).trim().toLowerCase();
        if (btnLang === lang) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });

      const d = translations[lang] || translations.es;
      const setTxt = (id, val, isHtml = false) => {
        const el = document.getElementById(id);
        if (el) {
          if (isHtml) el.innerHTML = val;
          else el.textContent = val;
        }
      };
      setTxt('txt-header-tag', d.header_tag);
      setTxt('txt-btn-drawer', d.btn_drawer);
      setTxt('txt-hero-pill', d.hero_pill);
      setTxt('txt-hero-stat', d.hero_stat);
      setTxt('txt-headline', d.headline, true);
      setTxt('txt-lead', d.lead);
      setTxt('txt-btn-contact', d.btn_contact);
      setTxt('txt-btn-dossier', d.btn_dossier);
      setTxt('txt-prog-label', d.prog_label);
      setTxt('txt-st1', d.st1);
      setTxt('txt-st2', d.st2);
      setTxt('txt-st3', d.st3);
      setTxt('txt-st4', d.st4);
      setTxt('txt-fig-title', d.fig_title);
      setTxt('txt-fig-sub', d.fig_sub);
      setTxt('txt-fig-prog', d.fig_prog);

      setTxt('txt-p1-badge', d.p1_badge);
      setTxt('txt-p1-title', d.p1_title);
      setTxt('txt-p1-desc', d.p1_desc);
      setTxt('txt-p1-tag-oncology', d.p1_tag_oncology);
      setTxt('txt-p1-tag-exposome', d.p1_tag_exposome);

      setTxt('txt-p2-badge', d.p2_badge);
      setTxt('txt-p2-title', d.p2_title);
      setTxt('txt-p2-desc', d.p2_desc);
      setTxt('txt-p2-stat-lbl', d.p2_stat_lbl);
      setTxt('txt-p2-stat-extra', d.p2_stat_extra, true);

      setTxt('txt-p3-badge', d.p3_badge);
      setTxt('txt-p3-title', d.p3_title);
      setTxt('txt-p3-desc', d.p3_desc);
      setTxt('txt-p3-stat-lbl', d.p3_stat_lbl);
      setTxt('txt-p3-stat-extra', d.p3_stat_extra, true);

      setTxt('txt-p4-badge', d.p4_badge);
      setTxt('txt-p4-title', d.p4_title);
      setTxt('txt-p4-desc', d.p4_desc);
      setTxt('txt-p4-tag-med', d.p4_tag_med, true);
      setTxt('txt-p4-tag-goyri', d.p4_tag_goyri, true);

      setTxt('txt-m-c-title', d.m_c_title);
      setTxt('txt-m-c-desc', d.m_c_desc);
      setTxt('txt-m-c-role', d.m_c_role, true);
      setTxt('txt-m-c-dept', d.m_c_dept, true);
      setTxt('txt-m-c-btn', d.m_c_close);

      setTxt('txt-m-d-title', d.m_d_title);
      setTxt('txt-m-d-desc', d.m_d_desc, true);
      setTxt('txt-m-d-list', d.m_d_list, true);
      setTxt('txt-m-d-btn', d.m_d_close);

      setTxt('txt-footer-tag', d.footer_tag);
      setTxt('txt-btn-current-web', d.btn_current_web);
      setTxt('txt-top-current-web', d.top_current_web);
      setTxt('txt-footer-current-web', d.footer_current_web);

      document.documentElement.lang = lang;

      // Update URL smoothly if on standard web server
      try {
        const currentPath = window.location.pathname;
        if (currentPath === '/' || currentPath === '/eu/' || currentPath === '/en/') {
          const targetPath = lang === 'es' ? '/' : '/' + lang + '/';
          if (currentPath !== targetPath && window.history && window.history.pushState) {
            window.history.pushState({ lang: lang }, '', targetPath);
          }
        }
      } catch (e) {
        // Ignore in restricted environments
      }
    }

    function toggleModal(id, open) {
      const modal = document.getElementById('modal-' + id);
      if (modal) {
        if (open) {
          modal.classList.add('open');
          document.body.style.overflow = 'hidden';
        } else {
          modal.classList.remove('open');
          document.body.style.overflow = '';
        }
      }
    }

    // Expose explicitly to global window object
    window.setCinemaLang = setCinemaLang;
    window.toggleModal = toggleModal;

    // Attach event listeners to ensure functionality regardless of inline evaluation
    function setupInteractions() {
      // Language switcher buttons
      document.querySelectorAll('.lang-btn-cinema').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetLang = (btn.getAttribute('data-cinema-lang') || btn.textContent).trim().toLowerCase();
          setCinemaLang(targetLang);
        });
      });

      // Modal open buttons
      document.querySelectorAll('[data-cinema-modal]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const modalId = btn.getAttribute('data-cinema-modal');
          toggleModal(modalId, true);
        });
      });

      // Modal close buttons
      document.querySelectorAll('[data-cinema-close]').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const modalId = btn.getAttribute('data-cinema-close');
          toggleModal(modalId, false);
        });
      });

      // Close on backdrop click
      document.querySelectorAll('.cinema-modal').forEach(modal => {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.remove('open');
            document.body.style.overflow = '';
          }
        });
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.cinema-modal.open').forEach(m => {
            m.classList.remove('open');
          });
          document.body.style.overflow = '';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupInteractions);
    } else {
      setupInteractions();
    }

    // Initialize requested language
    setCinemaLang(initialLang || 'es');
  </script>
