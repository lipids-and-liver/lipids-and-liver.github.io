---
import type { Locale } from '../../utils/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lipids &amp; Liver | Portal Oficial en Construcción (UPV/EHU &amp; IIS Biocruces Bizkaia)</title>
  <!-- Anti-Indexing during Development: Block all search engine bots -->
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />

  <!-- Google Fonts: Space Grotesk & Plus Jakarta Sans (Prototipo 5) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Umami Analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="3b088faa-e063-478c-8b7e-d4aaec85a1dd"></script>

  <style>
    :root {
      --cinema-font-display: 'Space Grotesk', system-ui, -apple-system, sans-serif;
      --cinema-font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;

      --cinema-bg: #07090e;
      --cinema-bg-glow: rgba(0, 245, 155, 0.06);
      --cinema-surface: rgba(18, 23, 34, 0.72);
      --cinema-border: rgba(255, 255, 255, 0.1);

      --cinema-text-primary: #ffffff;
      --cinema-text-secondary: #a0aec0;
      --cinema-text-muted: #64748b;

      --cinema-mint: #00f59b;
      --cinema-mint-glow: rgba(0, 245, 155, 0.35);
      --cinema-cyan: #00d2ff;
      --cinema-cyan-glow: rgba(0, 210, 255, 0.3);

      --ease-cinematic: cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      min-height: 100vh;
      background-color: var(--cinema-bg);
      color: var(--cinema-text-primary);
      font-family: var(--cinema-font-sans);
      overflow-x: hidden;
      position: relative;
      -webkit-font-smoothing: antialiased;
    }

    /* Background Canvas Particles */
    #particles-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
      opacity: 0.65;
    }

    /* Ambient Glow Orbs */
    .cinema-ambient-glow {
      position: fixed;
      border-radius: 50%;
      filter: blur(130px);
      pointer-events: none;
      z-index: 1;
    }

    .glow-1 {
      width: 55vw;
      height: 55vh;
      top: -10%;
      right: -10%;
      background: radial-gradient(circle, rgba(0, 210, 255, 0.13) 0%, transparent 70%);
    }

    .glow-2 {
      width: 50vw;
      height: 50vh;
      bottom: -10%;
      left: -10%;
      background: radial-gradient(circle, rgba(0, 245, 155, 0.1) 0%, transparent 70%);
    }

    /* Top Floating Header */
    .cinema-top-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 0.75rem clamp(1.25rem, 3vw, 2.5rem);
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 50;
      background: linear-gradient(to bottom, rgba(7, 9, 14, 0.9) 0%, rgba(7, 9, 14, 0) 100%);
      backdrop-filter: blur(10px);
    }

    .cinema-brand {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: #ffffff;
    }

    .cinema-logo {
      height: 32px;
      object-fit: contain;
    }

    .cinema-brand-title {
      display: flex;
      flex-direction: column;
    }

    .cinema-brand-name {
      font-family: var(--cinema-font-display);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.01em;
      background: linear-gradient(135deg, #ffffff 0%, var(--cinema-mint) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .cinema-brand-tag {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--cinema-text-muted);
    }

    .cinema-top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cinema-accred-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--cinema-border);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.72rem;
      color: var(--cinema-text-secondary);
      font-family: var(--cinema-font-display);
      letter-spacing: 0.5px;
    }

    .cinema-accred-badge span {
      color: var(--cinema-mint);
      font-weight: 700;
    }

    .lang-switcher-cinema {
      display: flex;
      align-items: center;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--cinema-border);
      border-radius: 20px;
      padding: 2px;
      backdrop-filter: blur(8px);
    }

    .lang-btn-cinema {
      border: none;
      background: transparent;
      color: var(--cinema-text-secondary);
      font-family: var(--cinema-font-sans);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .lang-btn-cinema.active {
      background: var(--cinema-mint);
      color: #07090e;
      font-weight: 800;
    }

    .btn-drawer-trigger {
      background: transparent;
      border: 1px solid var(--cinema-mint);
      color: var(--cinema-mint);
      padding: 5px 14px;
      border-radius: 20px;
      font-family: var(--cinema-font-sans);
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.25s;
    }

    .btn-drawer-trigger:hover {
      background: var(--cinema-mint);
      color: #07090e;
      box-shadow: 0 0 16px var(--cinema-mint-glow);
    }

    /* Main Showcase Content */
    .cinema-main-container {
      position: relative;
      z-index: 10;
      max-width: 1240px;
      margin: 0 auto;
      padding: clamp(3.8rem, 6vh, 4.8rem) clamp(1rem, 2vw, 2rem) clamp(0.5rem, 1.2vh, 1rem);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .cinema-hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(1.75rem, 3vw, 2.75rem);
      align-items: center;
      margin-bottom: clamp(1rem, 2vh, 1.6rem);
    }

    .chapter-number-pill {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: rgba(0, 245, 155, 0.08);
      border: 1px solid rgba(0, 245, 155, 0.3);
      color: var(--cinema-mint);
      padding: 5px 14px;
      border-radius: 30px;
      font-family: var(--cinema-font-display);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: clamp(0.6rem, 1.2vh, 0.95rem);
      box-shadow: 0 0 20px rgba(0, 245, 155, 0.15);
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cinema-mint);
      box-shadow: 0 0 8px var(--cinema-mint);
      animation: pulse-dot-glow 2s infinite ease-in-out;
      display: inline-block;
    }

    @keyframes pulse-dot-glow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .pill-sep {
      width: 1px;
      height: 12px;
      background: rgba(0, 245, 155, 0.3);
      display: inline-block;
    }

    .pill-stat {
      color: #ffffff;
      font-weight: 700;
    }

    .chapter-headline {
      font-family: var(--cinema-font-display);
      font-size: clamp(1.75rem, 2.5vw, 2.5rem);
      font-weight: 800;
      line-height: 1.18;
      letter-spacing: -0.02em;
      margin-bottom: clamp(0.6rem, 1.2vh, 0.95rem);
      color: #ffffff;
    }

    .highlight-mint {
      background: linear-gradient(135deg, var(--cinema-mint) 0%, var(--cinema-cyan) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .chapter-lead-text {
      font-size: clamp(0.92rem, 1.05vw, 1.02rem);
      color: var(--cinema-text-secondary);
      line-height: 1.6;
      font-weight: 300;
      margin-bottom: clamp(0.9rem, 1.6vh, 1.35rem);
      max-width: 620px;
    }

    /* Actions */
    .cinema-action-row {
      display: flex;
      gap: 0.85rem;
      flex-wrap: wrap;
      margin-bottom: clamp(1rem, 1.8vh, 1.4rem);
    }

    .btn-cinema-glow {
      background: var(--cinema-mint);
      color: #07090e;
      border: none;
      font-family: var(--cinema-font-sans);
      font-size: 0.88rem;
      font-weight: 700;
      padding: 10px 22px;
      border-radius: 30px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s;
      box-shadow: 0 0 20px var(--cinema-mint-glow);
    }

    .btn-cinema-glow:hover {
      background: #26f8a8;
      box-shadow: 0 0 30px rgba(0, 245, 155, 0.6);
      transform: translateY(-2px);
    }

    .btn-cinema-glass {
      background: rgba(255, 255, 255, 0.05);
      color: #ffffff;
      border: 1px solid var(--cinema-border);
      font-family: var(--cinema-font-sans);
      font-size: 0.88rem;
      font-weight: 600;
      padding: 10px 20px;
      border-radius: 30px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      backdrop-filter: blur(10px);
      transition: all 0.25s;
    }

    .btn-cinema-glass:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateY(-2px);
    }

    /* Progress Box */
    .cinema-progress-card {
      background: var(--cinema-surface);
      border: 1px solid var(--cinema-border);
      border-radius: 14px;
      padding: clamp(1rem, 1.6vh, 1.25rem) clamp(1.2rem, 1.6vw, 1.5rem);
      backdrop-filter: blur(16px);
      max-width: 620px;
    }

    .cinema-prog-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.7rem;
    }

    .cinema-prog-title {
      font-family: var(--cinema-font-display);
      font-size: 0.82rem;
      font-weight: 700;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 8px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .cinema-prog-pct {
      font-family: var(--cinema-font-display);
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--cinema-mint);
    }

    .cinema-prog-bar-bg {
      width: 100%;
      height: 7px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 1rem;
    }

    .cinema-prog-bar-fill {
      height: 100%;
      width: 90%;
      background: linear-gradient(90deg, var(--cinema-cyan) 0%, var(--cinema-mint) 100%);
      box-shadow: 0 0 12px var(--cinema-mint-glow);
    }

    .cinema-steps-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .cinema-step-item {
      font-size: 0.75rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .cinema-step-item.done { color: var(--cinema-mint); }
    .cinema-step-item.active { color: #fbbf24; }

    /* Right Column Figure Card (Prototipo 5) */
    .cinema-figure-card {
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--cinema-border);
      background: var(--cinema-surface);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(16px);
      transition: all 0.5s var(--ease-cinematic);
    }

    .cinema-figure-card:hover {
      transform: translateY(-4px) scale(1.008);
      border-color: rgba(0, 245, 155, 0.35);
      box-shadow: 0 25px 50px -12px rgba(0, 245, 155, 0.15);
    }

    .cinema-figure-img {
      width: 100%;
      height: clamp(200px, 24vh, 250px);
      object-fit: cover;
      object-position: center 30%;
      display: block;
      filter: saturate(1.08) brightness(0.9);
      transition: transform 1.2s var(--ease-cinematic);
    }

    .cinema-figure-card:hover .cinema-figure-img {
      transform: scale(1.04);
    }

    .cinema-figure-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1.25rem 1.4rem 1rem;
      background: linear-gradient(to top, rgba(7, 9, 14, 0.95) 0%, rgba(7, 9, 14, 0.6) 60%, transparent 100%);
    }

    .fig-overlay-content {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
    }

    .fig-title {
      font-family: var(--cinema-font-display);
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 2px;
    }

    .fig-sub {
      font-size: 0.78rem;
      color: var(--cinema-text-secondary);
    }

    .fig-prog-pill {
      position: relative;
      background: rgba(0, 0, 0, 0.55);
      border: 1px solid rgba(0, 245, 155, 0.3);
      border-radius: 20px;
      padding: 4px 12px;
      overflow: hidden;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .fig-prog-bar {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      background: linear-gradient(90deg, rgba(0, 210, 255, 0.25), rgba(0, 245, 155, 0.35));
      border-radius: 20px;
      z-index: 1;
    }

    .fig-prog-text {
      position: relative;
      z-index: 2;
      font-family: var(--cinema-font-display);
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--cinema-mint);
      letter-spacing: 0.05em;
    }

    /* Bento Grid (4 Cards - Enhanced Modern Layout) */
    .cinema-bento-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: clamp(0.75rem, 1.2vh, 1.15rem);
      margin-bottom: clamp(0.6rem, 1.2vh, 1.15rem);
    }

    .cinema-bento-card {
      background: var(--cinema-surface);
      border: 1px solid var(--cinema-border);
      border-radius: 14px;
      padding: clamp(0.95rem, 1.5vh, 1.25rem) clamp(1.1rem, 1.5vw, 1.45rem);
      backdrop-filter: blur(16px);
      transition: all 0.35s var(--ease-cinematic);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .cinema-bento-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: transparent;
      transition: background 0.3s;
    }

    .cinema-bento-card:hover {
      transform: translateY(-3px);
      border-color: rgba(0, 245, 155, 0.35);
      box-shadow: 0 14px 28px rgba(0, 0, 0, 0.5), 0 0 16px rgba(0, 245, 155, 0.1);
    }

    .cinema-bento-card:hover::before {
      background: linear-gradient(90deg, var(--cinema-cyan), var(--cinema-mint));
    }

    .cinema-bento-card.bento-wide-1 {
      grid-column: span 7;
    }

    .cinema-bento-card.bento-compact-1 {
      grid-column: span 5;
    }

    .cinema-bento-card.bento-compact-2 {
      grid-column: span 5;
    }

    .cinema-bento-card.bento-wide-2 {
      grid-column: span 7;
    }

    .bento-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 4px;
    }

    .bento-top-icon {
      color: rgba(255, 255, 255, 0.25);
      font-size: 0.85rem;
      transition: color 0.3s;
    }

    .cinema-bento-card:hover .bento-top-icon {
      color: var(--cinema-mint);
    }

    .cinema-pi-badge {
      font-family: var(--cinema-font-display);
      font-size: 0.68rem;
      font-weight: 800;
      color: var(--cinema-mint);
      letter-spacing: 0.1em;
    }

    .cinema-pi-title {
      font-size: clamp(0.98rem, 1.15vw, 1.12rem);
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .cinema-pi-desc {
      font-size: clamp(0.8rem, 0.88vw, 0.86rem);
      color: var(--cinema-text-secondary);
      line-height: 1.5;
      margin-bottom: 6px;
    }

    .bento-tags-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 4px;
    }

    .bento-tag {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--cinema-cyan);
      background: rgba(0, 210, 255, 0.08);
      border: 1px solid rgba(0, 210, 255, 0.18);
      border-radius: 6px;
      padding: 2px 8px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .bento-stat-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 4px;
    }

    .bento-stat-badge {
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
    }

    .bento-stat-num {
      font-family: var(--cinema-font-display);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--cinema-mint);
      line-height: 1;
    }

    .bento-stat-lbl {
      font-size: 0.72rem;
      font-weight: 700;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .bento-stat-extra {
      font-size: 0.72rem;
      color: var(--cinema-text-muted);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    /* Footer */
    .cinema-footer {
      border-top: 1px solid var(--cinema-border);
      padding: clamp(0.35rem, 0.7vh, 0.6rem) 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.6rem;
      font-size: 0.74rem;
      color: var(--cinema-text-muted);
    }

    .cinema-footer a {
      color: var(--cinema-mint);
      text-decoration: none;
    }

    /* Modal / Drawer */
    .cinema-modal {
      position: fixed;
      inset: 0;
      background: rgba(7, 9, 14, 0.85);
      backdrop-filter: blur(14px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .cinema-modal.open {
      display: flex;
    }

    .cinema-modal-card {
      background: #0f1420;
      border: 1px solid var(--cinema-border);
      border-top: 4px solid var(--cinema-mint);
      border-radius: 16px;
      padding: 2.5rem;
      max-width: 580px;
      width: 100%;
      position: relative;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
    }

    .cinema-modal-close {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      background: transparent;
      border: none;
      color: var(--cinema-text-secondary);
      font-size: 1.25rem;
      cursor: pointer;
    }

    .cinema-modal-close:hover {
      color: #ffffff;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .cinema-hero-grid {
        grid-template-columns: 1fr;
        gap: 1.75rem;
      }
      .cinema-figure-img {
        height: 260px;
      }
      .cinema-bento-grid {
        grid-template-columns: 1fr;
        gap: 0.75rem;
      }
      .cinema-bento-card.bento-wide-1,
      .cinema-bento-card.bento-compact-1,
      .cinema-bento-card.bento-compact-2,
      .cinema-bento-card.bento-wide-2 {
        grid-column: span 1;
      }
      .cinema-top-header {
        padding: 0.75rem 1.25rem;
      }
      .cinema-accred-badge {
        display: none;
      }
    }

    @media (max-width: 640px) {
      .cinema-steps-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Interactive Canvas Particle Simulation (Lipid Vesicles - Prototipo 5) -->
  <canvas id="particles-canvas"></canvas>

  <!-- Ambient Light Orbs -->
  <div class="cinema-ambient-glow glow-1"></div>
  <div class="cinema-ambient-glow glow-2"></div>

  <!-- Minimalist Floating Header -->
  <header class="cinema-top-header">
    <div class="cinema-brand">
