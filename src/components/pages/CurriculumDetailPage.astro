---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedEntry, getLocalizedCollection, getTranslations, getLocalizedPath, getTeamCategoryInfo, localizeTeamRole, localizeTeamDepartment, localizeTeamOffice, type Locale } from '../../utils/i18n';
import { render } from 'astro:content';

interface Props {
  id: string;
  lang: Locale;
}

const { id, lang } = Astro.props;
const t = getTranslations(lang);

const member = await getLocalizedEntry('team', id, lang);
if (!member) {
  throw new Error(`Team member with id "${id}" not found.`);
}

const allTeam = await getLocalizedCollection('team', lang);
allTeam.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const currentSlug = member.slug;
const cv = member.data.cv || {};
const { Content } = await render(member);

const catInfo = getTeamCategoryInfo(member.data.category, lang);
const catKey = catInfo.key;
const catBadge = catInfo.label;

const localizedRole = member.locale === lang ? member.data.role : localizeTeamRole(member.data.role, lang);
const localizedCvTitle = member.locale === lang ? (cv.title || member.data.role) : localizeTeamRole(cv.title || member.data.role, lang);
const localizedDept = member.locale === lang ? member.data.department : localizeTeamDepartment(member.data.department || '', lang);
const localizedOffice = member.locale === lang ? member.data.office : localizeTeamOffice(member.data.office || '', lang);

const imageSrc = member.data.image ? (member.data.image.startsWith('/') ? member.data.image : `/${member.data.image}`) : '/assets/images/team/placeholder.jpg';
---

<Layout title={`${member.data.name} - ${localizedCvTitle} | Lipids & Liver`} currentPage="curriculum" lang={lang}>
  <!-- Nav Extra: Member Dropdown Selector -->
  <div slot="nav-extra" class="nav-quick-select-group">
    <label for="member-select"><i class="fas fa-user-circle"></i> {t.team_select_label}</label>
    <select id="member-select" data-lang={lang} class="nav-quick-select">
      {allTeam.map(m => (
        <option value={m.slug} selected={m.slug === currentSlug}>
          {m.data.name}
        </option>
      ))}
    </select>
  </div>

  <div class="container cv-container">
    <div class="cv-top-bar">
      <a href={getLocalizedPath('/curriculum', lang)} class="btn-inst-secondary" style="padding:6px 14px; font-size:0.85rem; display:inline-flex; align-items:center; gap:8px;">
        <i class="fas fa-arrow-left"></i> {t.team_back_dir}
      </a>
    </div>

    <!-- Main Profile Card (Mismo estilo que la carta de presentación: Foto, email, orcid a la izquierda y el resto del contenido a la derecha) -->
    <div class="cv-card">
      <!-- Columna Izquierda: Foto, Categoría, Email, ORCID, Despacho, Departamento -->
      <aside class="cv-aside">
        <div class="cv-portrait">
          <img src={imageSrc} alt={member.data.name} class="cv-photo" loading="lazy" />
        </div>

        <div class="cv-aside-badge">
          <span class={`team-category-badge badge-${catKey}`}>{catBadge}</span>
        </div>

        <div class="cv-contacts-box">
          {member.data.email && (
            <a href={`mailto:${member.data.email}`} class="cv-contact-item" title={member.data.email}>
              <i class="fas fa-envelope"></i>
              <span>{member.data.email}</span>
            </a>
          )}
          {member.data.orcid && (
            <a href={`https://orcid.org/${member.data.orcid}`} target="_blank" rel="noopener noreferrer" class="cv-contact-item" title={`ORCID: ${member.data.orcid}`}>
              <i class="fab fa-orcid" style="color:#a6ce39;"></i>
              <span>{member.data.orcid}</span>
            </a>
          )}
          {localizedOffice && (
            <div class="cv-contact-item">
              <i class="fas fa-door-open"></i>
              <span>{localizedOffice}</span>
            </div>
          )}
          {localizedDept && (
            <div class="cv-contact-item">
              <i class="fas fa-building"></i>
              <span>{localizedDept}</span>
            </div>
          )}
        </div>
      </aside>

      <!-- Columna Derecha: Resto del contenido -->
      <article class="cv-main">
        <div class="cv-kicker">
          <span class="cv-dot"></span>
          {catBadge} • {t.header_sub || 'Grupo Consolidado Lipids & Liver'}
        </div>

        <h1 class="cv-main-name">{member.data.name}</h1>
        <div class="cv-main-title">{localizedCvTitle}</div>

        <!-- Bio / Semblanza -->
        <div class="cv-bio">
          <Content />
        </div>

        <!-- Resumen de Investigación -->
        {cv.researchSummary && (
          <div class="cv-block">
            <h3 class="cv-block-title"><i class="fas fa-microscope"></i> {t.cv_research}</h3>
            <p class="cv-block-text">{cv.researchSummary}</p>
          </div>
        )}

        <!-- Titulaciones Académicas -->
        {cv.degrees && cv.degrees.length > 0 && (
          <div class="cv-block">
            <h3 class="cv-block-title"><i class="fas fa-graduation-cap"></i> {t.cv_degrees}</h3>
            <ul class="cv-clean-list">
              {cv.degrees.map((d: string) => <li>{d}</li>)}
            </ul>
          </div>
        )}

        <!-- Puestos y Trayectoria -->
        {cv.positions && cv.positions.length > 0 && (
          <div class="cv-block">
            <h3 class="cv-block-title"><i class="fas fa-briefcase"></i> {t.cv_positions}</h3>
            <ul class="cv-clean-list">
              {cv.positions.map((p: string) => <li>{p}</li>)}
            </ul>
          </div>
        )}

        <!-- Proyectos y Financiación -->
        {cv.grants && cv.grants.length > 0 && (
          <div class="cv-block">
            <h3 class="cv-block-title"><i class="fas fa-file-contract"></i> {t.cv_grants}</h3>
            <ul class="cv-clean-list">
              {cv.grants.map((g: string) => <li>{g}</li>)}
            </ul>
          </div>
        )}

        <!-- Publicaciones Seleccionadas -->
        {cv.publications && cv.publications.length > 0 && (
          <div class="cv-block">
            <h3 class="cv-block-title"><i class="fas fa-book-open"></i> {t.cv_pubs}</h3>
            <ul class="cv-clean-list">
              {cv.publications.map((pub: string) => <li>{pub}</li>)}
            </ul>
          </div>
        )}

        <!-- Docencia Universitaria -->
        {cv.teaching && cv.teaching.length > 0 && (
          <div class="cv-block">
            <h3 class="cv-block-title"><i class="fas fa-chalkboard-teacher"></i> {t.cv_teaching}</h3>
            <ul class="cv-clean-list">
              {cv.teaching.map((tc: string) => <li>{tc}</li>)}
            </ul>
          </div>
        )}
      </article>
    </div>
  </div>

  <script is:inline>
    const select = document.getElementById('member-select');
    if (select) {
      const lang = select.dataset.lang || 'es';
      const prefix = lang === 'es' ? '/portal' : '/portal/' + lang;
      select.addEventListener('change', (e) => {
        if (e.target.value) {
          window.location.href = prefix + '/curriculum/' + e.target.value;
        }
      });
    }
  </script>
</Layout>
