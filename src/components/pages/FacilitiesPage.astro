---
import Layout from '../../layouts/Layout.astro';
import ContentLangNotice from '../ContentLangNotice.astro';
import { getLocalizedEntry, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import { render } from 'astro:content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// El contenido se edita en el CMS como la entrada "Instalaciones" de la presentación institucional
const entry = await getLocalizedEntry('presentation', 'instalaciones', lang);
const Content = entry ? (await render(entry)).Content : null;
---

<Layout currentPage="facilities" lang={lang} title={`${t.facilities_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-building"></i> {t.facilities_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Header Section -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-flask"></i> {t.nav_group_research}
        </span>
        <h1 class="catalog-title">{t.facilities_title}</h1>
        <p class="catalog-subtitle">{t.facilities_page_sub}</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      {entry && <ContentLangNotice contentLang={entry.locale} lang={lang} variant="banner" />}
      <div class="about-text" lang={entry && entry.locale !== lang ? entry.locale : undefined}>
        {Content && <Content />}
      </div>
    </div>
  </section>
</Layout>
