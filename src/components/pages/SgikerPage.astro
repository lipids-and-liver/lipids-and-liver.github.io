---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Layout currentPage="sgiker" lang={lang} title={`${t.sgiker_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-flask"></i> {t.sgiker_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Hero Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-microscope"></i> SGIker • Servicios Generales de Investigación (UPV/EHU)
        </span>
        <h1 class="catalog-title">{t.sgiker_page_title}</h1>
        <p class="catalog-subtitle">{t.sgiker_page_sub}</p>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="page-section">
    <div class="container">
      <div class="about-grid" style="margin-bottom: 3.5rem;">
        <div class="about-text">
          <h2 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.6rem;">
            Plataforma Tecnológica de Excelencia en Lipidómica
          </h2>
          <p style="font-size:1.05rem; line-height:1.75; color:var(--text-secondary); margin-bottom:1.25rem;">
            La <strong>Unidad Central de Lipidómica</strong> de los Servicios Generales de Investigación (SGIker) de la UPV/EHU, estrechamente vinculada al Grupo Lipids & Liver y al Departamento de Fisiología, ofrece soporte analítico avanzado en identificación, cuantificación y caracterización estructural de especies lipídicas en matrices biológicas complejas.
          </p>
          <p style="font-size:1rem; line-height:1.7; color:var(--text-secondary);">
            Nuestra misión es poner a disposición de la comunidad investigadora académica (UPV/EHU, CIBER, CSIC, universidades), centros hospitalarios y empresas del sector biotecnológico y farmacéutico instrumentación puntera de espectrometría de masas y metodologías analíticas validadas.
          </p>

          <div class="specialty-list" style="margin-top:1.5rem;">
            <span class="specialty-chip"><i class="fas fa-check-circle"></i> Certificación de Calidad UPV/EHU</span>
            <span class="specialty-chip"><i class="fas fa-check-circle"></i> Perfilado Untargeted & Targeted</span>
            <span class="specialty-chip"><i class="fas fa-check-circle"></i> Asesoramiento Metodológico Integral</span>
          </div>
        </div>

        <div style="background:var(--bg-surface-alt); padding:2rem; border-radius:var(--radius-md); border:1px solid var(--border-color); display:flex; flex-direction:column; justify-content:center;">
          <h3 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.2rem;">
            <i class="fas fa-info-circle" style="color:var(--logo-green);"></i> Solicitud de Servicios
          </h3>
          <p style="font-size:0.95rem; line-height:1.6; color:var(--text-secondary); margin-bottom:1.5rem;">
            El acceso a la unidad se gestiona a través del portal oficial de los SGIker. Se aplican tarifas diferenciadas para grupos de la UPV/EHU, organismos públicos de investigación (OPIs) y entidades privadas.
          </p>
          <a href="https://www.ehu.eus/es/web/sgiker" target="_blank" rel="noopener noreferrer" class="btn-inst-primary" style="text-align:center; justify-content:center;">
            Portal Oficial SGIker <i class="fas fa-external-link-alt" style="margin-left:6px;"></i>
          </a>
        </div>
      </div>

      <!-- Services Grid -->
      <div class="section-header-inst" style="margin-top:2rem;">
        <div>
          <h2 class="section-title-inst">Cartera de Servicios Analíticos</h2>
          <span class="section-subtitle-inst">Ensayos analíticos y metodologías disponibles para proyectos biomédicos</span>
        </div>
      </div>

      <div class="research-grid-inst">
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#e0f2fe; color:#0369a1;"><i class="fas fa-search"></i> Untargeted</span>
              <h3 class="research-card-title">Lipidómica Global No Dirigida</h3>
            </div>
            <p class="research-card-desc">
              Screening no sesgado de cientos de especies lipídicas moleculares (fosfatidilcolinas, fosfatidiletanolaminas, esfingomielinas, ceramidas, triglicéridos, ésteres de colesterol) en plasma, suero y extractos de tejidos por UHPLC-QTOF.
            </p>
          </div>
        </div>

        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#fef3c7; color:#92400e;"><i class="fas fa-bullseye"></i> Targeted MRM</span>
              <h3 class="research-card-title">Lipidómica Dirigida Cuantitativa</h3>
            </div>
            <p class="research-card-desc">
              Cuantificación absoluta de especies diana mediante dilución isotópica con patrones internos deuterados empleando espectrometría de masas Triple Cuadrupolo en modo Multiple Reaction Monitoring (MRM).
            </p>
          </div>
        </div>

        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#dcfce7; color:#166534;"><i class="fas fa-vial"></i> Mediadores Lipídicos</span>
              <h3 class="research-card-title">Ácidos Biliares y Oxilipinas</h3>
            </div>
            <p class="research-card-desc">
              Panel cuantitativo especializado para el perfilado de ácidos biliares primarios y secundarios (libres y conjugados) y mediadores inflamatorios derivados del ácido araquidónico (eicosanoides, prostaglandinas).
            </p>
          </div>
        </div>

        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#f3e8ff; color:#6b21a8;"><i class="fas fa-chart-pie"></i> Bioinformática</span>
              <h3 class="research-card-title">Análisis Bioinformático & Quimiometría</h3>
            </div>
            <p class="research-card-desc">
              Procesamiento de datos brutos, alineamiento cromatográfico, normalización por masa/volumen, análisis estadístico multivariante (PCA, OPLS-DA) y mapeo de rutas metabólicas alteradas.
            </p>
          </div>
        </div>
      </div>

      <!-- Equipment Details -->
      <div class="section-header-inst" style="margin-top:4rem;">
        <div>
          <h2 class="section-title-inst">Equipamiento e Infraestructura Instrumental</h2>
          <span class="section-subtitle-inst">Instrumentación analítica instalada en la Facultad de Medicina y Enfermería</span>
        </div>
      </div>

      <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-bottom:3rem;">
        <div class="stat-box" style="text-align:left; padding:2rem;">
          <div style="font-size:2rem; color:var(--logo-green); margin-bottom:0.75rem;"><i class="fas fa-cogs"></i></div>
          <h4 style="font-size:1.15rem; color:var(--ehu-navy); margin-bottom:0.5rem;">UHPLC-QTOF Alta Resolución</h4>
          <p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.6;">
            Sistema de ultra-alta resolución con fuente de ionización electrospray dual (ESI), analizador Quadrupole-Time of Flight para masa exacta y fragmentación MS/MS.
          </p>
        </div>

        <div class="stat-box" style="text-align:left; padding:2rem;">
          <div style="font-size:2rem; color:var(--logo-green); margin-bottom:0.75rem;"><i class="fas fa-wave-square"></i></div>
          <h4 style="font-size:1.15rem; color:var(--ehu-navy); margin-bottom:0.5rem;">LC-MS/MS Triple Cuadrupolo</h4>
          <p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.6;">
            Espectrómetro tándem optimizado para cuantificación ultrasensible y reproducibilidad en matrices complejas mediante monitorización de transiciones MRM.
          </p>
        </div>

        <div class="stat-box" style="text-align:left; padding:2rem;">
          <div style="font-size:2rem; color:var(--logo-green); margin-bottom:0.75rem;"><i class="fas fa-boxes"></i></div>
          <h4 style="font-size:1.15rem; color:var(--ehu-navy); margin-bottom:0.5rem;">Laboratorio de Preparación</h4>
          <p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.6;">
            Campanas de extracción de disolventes orgánicos, homogenizadores mecánicos por bolas de alta velocidad (TissueLyser), evaporadores de nitrógeno y ultracongeladores a -80°C.
          </p>
        </div>
      </div>

      <!-- Contact Banner -->
      <div style="background:linear-gradient(135deg, var(--ehu-navy) 0%, #001a2e 100%); color:#ffffff; padding:2.5rem; border-radius:var(--radius-lg); text-align:center;">
        <h3 style="color:#ffffff; font-size:1.5rem; margin-bottom:0.75rem;">¿Deseas solicitar un análisis o colaborar en un proyecto?</h3>
        <p style="color:#cbd5e1; max-width:650px; margin:0 auto 1.5rem; line-height:1.6;">
          Contacta con el equipo de la Unidad de Lipidómica SGIker para evaluar los requerimientos técnicos y diseño experimental de tu estudio.
        </p>
        <a href={getLocalizedPath('/#contact', lang)} class="btn-inst-primary" style="display:inline-flex;">
          <i class="fas fa-envelope"></i> Contactar con la Unidad SGIker
        </a>
      </div>
    </div>
  </section>
</Layout>
