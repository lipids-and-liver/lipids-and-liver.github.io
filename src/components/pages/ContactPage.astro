---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import leadership from '../../data/leadership.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const coordinator = leadership.coordinator;
---

<Layout currentPage="contact" lang={lang} title={`${t.contact_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-envelope"></i> {t.nav_contact}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Header Section -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-map-marker-alt"></i> {t.contact_hq}
        </span>
        <h1 class="catalog-title">{t.contact_title}</h1>
        <p class="catalog-subtitle">{t.contact_subtitle}</p>
      </div>
    </div>
  </section>

  <section class="page-section" id="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info-card">
          <h2 style="margin-bottom:1.5rem; font-size:1.3rem; color:var(--ehu-navy)">{t.contact_hq}</h2>

          <div class="info-item">
            <div class="info-icon"><i class="fas fa-university"></i></div>
            <div class="info-text">
              <h3>{t.contact_postal}</h3>
              <p style="white-space:pre-line">{t.contact_postal_val}</p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fas fa-user-check"></i></div>
            <div class="info-text">
              <h3>{t.contact_coord}</h3>
              <p>{coordinator.name}<br />{coordinator.affiliation}</p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fas fa-envelope"></i></div>
            <div class="info-text">
              <h3>{t.contact_email_title}</h3>
              <p><a href={`mailto:${coordinator.email}`}>{coordinator.email}</a></p>
            </div>
          </div>
        </div>

        <div class="contact-info-card contact-write-card">
          <h2 style="margin-bottom:1rem; font-size:1.3rem; color:var(--ehu-navy)">{t.contact_write_title}</h2>
          <p style="font-size:1rem; line-height:1.7; color:var(--text-secondary); margin-bottom:1.75rem;">
            {t.contact_write_text}
          </p>
          <a href={`mailto:${coordinator.email}`} class="btn-inst-primary" style="align-self:flex-start;">
            <i class="fas fa-paper-plane"></i> {t.contact_write_btn}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
