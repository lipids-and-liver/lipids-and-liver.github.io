---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, getLocalizedCollection, formatNewsDate, type Locale } from '../../utils/i18n';
import ContentLangNotice from '../ContentLangNotice.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Registro de actividades (src/content/outreach), de la más reciente a la más antigua
const activities = await getLocalizedCollection('outreach', lang);
activities.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Noticias existentes, para enlazar solo las que existen
const newsSlugs = new Set((await getLocalizedCollection('news', lang)).map(n => n.slug));

// Textos de la página traducidos; las actividades se muestran en su idioma original (campo lang)
const TYPES: Record<string, { label: string; icon: string }> = {
  'radio-tv': { label: t.outreach_type_radio_tv, icon: 'fas fa-microphone' },
  prensa: { label: t.outreach_type_prensa, icon: 'fas fa-newspaper' },
  charla: { label: t.outreach_type_charla, icon: 'fas fa-comments' },
  jornada: { label: t.outreach_type_jornada, icon: 'fas fa-landmark' },
  educacion: { label: t.outreach_type_educacion, icon: 'fas fa-school' },
  pacientes: { label: t.outreach_type_pacientes, icon: 'fas fa-hand-holding-heart' },
};
const typeFilters = Object.entries(TYPES)
  .map(([key, v]) => ({ key, ...v, count: activities.filter(a => a.data.type === key).length }))
  .filter(f => f.count > 0);

const RESOURCE_KINDS = {
  video: { label: t.outreach_kind_video, verb: t.outreach_verb_video, icon: 'fas fa-play-circle' },
  audio: { label: t.outreach_kind_audio, verb: t.outreach_verb_audio, icon: 'fas fa-headphones' },
  texto: { label: t.outreach_kind_texto, verb: t.outreach_verb_texto, icon: 'fas fa-book-open' },
};
const resources = activities.filter(a => a.data.resource && !a.data.draft);

const years = activities.map(a => new Date(a.data.date).getUTCFullYear()).filter(y => !isNaN(y));
const stats = [
  { value: activities.length, label: t.outreach_stat_total },
  { value: activities.filter(a => a.data.type === 'radio-tv' || a.data.type === 'prensa').length, label: t.outreach_stat_media },
  { value: activities.filter(a => ['charla', 'jornada', 'educacion', 'pacientes'].includes(a.data.type)).length, label: t.outreach_stat_events },
  { value: years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '—', label: t.outreach_stat_period },
];

// Agrupado por año para la línea de tiempo
const byYear = new Map<number, typeof activities>();
for (const a of activities) {
  const y = new Date(a.data.date).getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(a);
}
---

<Layout currentPage="outreach" lang={lang} title={`${t.outreach_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-heartbeat"></i> {t.outreach_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Hero Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-users"></i> {t.outreach_badge}
        </span>
        <h1 class="catalog-title">{t.outreach_page_title}</h1>
        <p class="catalog-subtitle">{t.outreach_page_sub}</p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="page-section">
    <div class="container">
      <!-- Intro + cifras (calculadas a partir del registro) -->
      <div class="outreach-intro">
        <h2 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.6rem;">
          {t.outreach_intro_title}
        </h2>
        <p style="font-size:1.05rem; line-height:1.75; color:var(--text-secondary);" set:html={t.outreach_intro_text} />
      </div>

      <div class="outreach-stats">
        {stats.map(s => (
          <div class="outreach-stat">
            <span class="outreach-stat-value">{s.value}</span>
            <span class="outreach-stat-label">{s.label}</span>
          </div>
        ))}
      </div>

      <!-- Escucha, mira, lee: actividades con grabación o texto consultable -->
      {resources.length > 0 && (
        <>
          <div class="section-header-inst">
            <div>
              <h2 class="section-title-inst">{t.outreach_resources_title}</h2>
              <span class="section-subtitle-inst">{t.outreach_resources_sub}</span>
            </div>
          </div>

          <div class="outreach-resources">
            {resources.map(a => {
              const kind = RESOURCE_KINDS[a.data.resource!.kind];
              return (
                <a class="outreach-resource" href={a.data.resource!.url} target="_blank" rel="noopener noreferrer">
                  <span class={`outreach-resource-kind kind-${a.data.resource!.kind}`}>
                    <i class={kind.icon} aria-hidden="true"></i> {kind.label}
                  </span>
                  <span class="outreach-resource-title" lang={a.data.lang}>{a.data.title} <ContentLangNotice contentLang={a.data.lang} lang={lang} /></span>
                  <span class="outreach-resource-meta"><span lang={a.data.lang}>{a.data.venue}</span> · {formatNewsDate(a.data.date, a.data.datePrecision, lang)}</span>
                  <span class="outreach-resource-cta">{kind.verb} <i class="fas fa-external-link-alt" aria-hidden="true"></i></span>
                </a>
              );
            })}
          </div>
        </>
      )}

      <!-- Registro de actividades -->
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.outreach_registry_title}</h2>
          <span class="section-subtitle-inst">{t.outreach_registry_sub}</span>
        </div>
      </div>

      <p class="outreach-lang-note"><i class="fas fa-language" aria-hidden="true"></i> {t.outreach_registry_lang_note}</p>

      <div class="filter-controls-wrap" style="margin-bottom:1.5rem;">
        <div class="segmented-control-bar" id="outreach-filters">
          <button class="segmented-btn active" data-type="ALL">
            <i class="fas fa-layer-group"></i> {t.team_all || 'Todas'} <span class="segmented-count">{activities.length}</span>
          </button>
          {typeFilters.map(f => (
            <button class="segmented-btn" data-type={f.key}>
              <i class={f.icon}></i> {f.label} <span class="segmented-count">{f.count}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="outreach-timeline" id="outreach-timeline">
        {[...byYear.entries()].map(([year, items]) => (
          <div class="outreach-year" data-year={year}>
            <h3 class="outreach-year-label">{year}</h3>
            <ul class="outreach-list">
              {items.map(a => {
                const type = TYPES[a.data.type];
                const newsUrl = a.data.news && newsSlugs.has(a.data.news) ? getLocalizedPath(`/noticias/${a.data.news}`, lang) : null;
                return (
                  <li class="outreach-item" data-type={a.data.type}>
                    <div class="outreach-item-head">
                      <span class="outreach-type"><i class={type.icon} aria-hidden="true"></i> {type.label}</span>
                      <span class="outreach-date">{formatNewsDate(a.data.date, a.data.datePrecision, lang)}</span>
                      {a.data.draft && <span class="outreach-draft" title={t.outreach_draft_title}>{t.outreach_draft}</span>}
                      <ContentLangNotice contentLang={a.data.lang} lang={lang} />
                    </div>
                    <h4 class="outreach-title" lang={a.data.lang}>{a.data.title}</h4>
                    <p class="outreach-meta">
                      <i class="fas fa-map-marker-alt" aria-hidden="true"></i> <span lang={a.data.lang}>{a.data.venue}</span>{a.data.location && ` · ${a.data.location}`}
                      {a.data.people.length > 0 && <> · <i class="fas fa-user" aria-hidden="true"></i> {a.data.people.join(', ')}</>}
                    </p>
                    {a.data.summary && <p class="outreach-summary" lang={a.data.lang}>{a.data.summary}</p>}
                    {(a.data.url || newsUrl) && (
                      <div class="outreach-links">
                        {newsUrl && <a href={newsUrl}><i class="fas fa-newspaper" aria-hidden="true"></i> {t.outreach_read_news}</a>}
                        {a.data.url && <a href={a.data.url} target="_blank" rel="noopener noreferrer"><i class="fas fa-external-link-alt" aria-hidden="true"></i> {t.outreach_source}</a>}
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  .outreach-intro { max-width: 820px; margin-bottom: 1.75rem; }
  .outreach-lang-note { font-size: 0.85rem; color: var(--text-muted); margin: -0.5rem 0 1rem; }
  .outreach-lang-note i { margin-right: 4px; }

  .outreach-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .outreach-stat {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-top: 3px solid var(--logo-green);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .outreach-stat-value { font-size: 1.75rem; font-weight: 800; color: var(--ehu-navy); line-height: 1.1; }
  .outreach-stat-label { font-size: 0.85rem; color: var(--text-muted); }

  .outreach-resources {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .outreach-resource {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--transition-smooth), transform var(--transition-smooth);
  }
  .outreach-resource:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .outreach-resource-kind {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--bg-surface-alt);
    color: var(--ehu-navy);
  }
  .outreach-resource-kind.kind-video { background: #fee2e2; color: #991b1b; }
  .outreach-resource-kind.kind-audio { background: #ede9fe; color: #5b21b6; }
  .outreach-resource-kind.kind-texto { background: #e0f2fe; color: #075985; }
  .outreach-resource-title { font-weight: 700; color: var(--ehu-navy); line-height: 1.35; }
  .outreach-resource-meta { font-size: 0.85rem; color: var(--text-muted); }
  .outreach-resource-cta { margin-top: auto; font-size: 0.9rem; font-weight: 600; color: var(--logo-green); }

  .outreach-timeline { margin-bottom: 3.5rem; }
  .outreach-year { display: grid; grid-template-columns: 80px 1fr; gap: 1.5rem; }
  .outreach-year[hidden] { display: none; }
  .outreach-year-label {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--ehu-navy);
    margin: 0;
    padding-top: 1rem;
  }
  .outreach-list {
    list-style: none;
    margin: 0;
    padding: 0 0 1.5rem 1.5rem;
    border-left: 2px solid var(--border-light);
  }
  .outreach-item { position: relative; padding: 1rem 0; border-bottom: 1px dashed var(--border-light); }
  .outreach-item:last-child { border-bottom: none; }
  .outreach-item[hidden] { display: none; }
  .outreach-item::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 6px);
    top: 1.35rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--logo-green);
    border: 2px solid var(--bg-primary);
  }
  .outreach-item-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-bottom: 0.35rem; }
  .outreach-type { font-size: 0.78rem; font-weight: 700; color: var(--logo-green); text-transform: uppercase; letter-spacing: 0.03em; }
  .outreach-date { font-size: 0.85rem; color: var(--text-muted); }
  .outreach-draft {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    background: #fff7ed;
    color: #9a3412;
    border: 1px solid #fed7aa;
  }
  .outreach-title { font-size: 1.05rem; color: var(--ehu-navy); margin: 0 0 0.3rem; line-height: 1.4; }
  .outreach-meta { font-size: 0.88rem; color: var(--text-secondary); margin: 0; }
  .outreach-meta i { color: var(--text-muted); margin-right: 2px; }
  .outreach-summary { font-size: 0.9rem; color: var(--text-secondary); margin: 0.4rem 0 0; line-height: 1.6; }
  .outreach-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem; font-size: 0.88rem; font-weight: 600; }
  .outreach-links a { color: var(--ehu-blue-slate); text-decoration: none; }
  .outreach-links a:hover { color: var(--logo-green); text-decoration: underline; }


  @media (max-width: 640px) {
    .outreach-year { grid-template-columns: 1fr; gap: 0; }
    .outreach-year-label { padding-top: 0.5rem; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('#outreach-filters .segmented-btn');
    const years = document.querySelectorAll('#outreach-timeline .outreach-year');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const type = btn.getAttribute('data-type');
        years.forEach(year => {
          let visible = 0;
          year.querySelectorAll('.outreach-item').forEach(item => {
            const show = type === 'ALL' || item.dataset.type === type;
            item.hidden = !show;
            if (show) visible++;
          });
          year.hidden = visible === 0;
        });
      });
    });
  });
</script>
