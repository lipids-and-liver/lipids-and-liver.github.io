---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import ThesisCard from '../cards/ThesisCard.astro';

import { sortTheses } from '../../utils/theses';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const allTheses = await getLocalizedCollection('theses', lang);
sortTheses(allTheses);

const ongoingTheses = allTheses.filter(t => t.data.status === 'ongoing');
const completedTheses = allTheses.filter(t => t.data.status === 'completed');
---

<Layout title={`${t.theses_page_title} | Lipids & Liver (UPV/EHU)`} currentPage="theses" lang={lang}>
  <!-- Nav Extra: Thesis Dropdown Selector -->
  <div slot="nav-extra" class="nav-quick-select-group">
    <label for="thesis-select"><i class="fas fa-graduation-cap"></i> {t.theses_select_label}</label>
    <select id="thesis-select" data-lang={lang} class="nav-quick-select">
      <option value="">{t.theses_select_placeholder}</option>
      <optgroup label={t.theses_ongoing}>
        {ongoingTheses.map(tItem => (
          <option value={tItem.slug}>
            {tItem.data.author} - {tItem.data.title.substring(0, 45)}...
          </option>
        ))}
      </optgroup>
      <optgroup label={t.theses_completed}>
        {completedTheses.map(tItem => (
          <option value={tItem.slug}>
            {tItem.data.author} ({tItem.data.year}) - {tItem.data.title.substring(0, 45)}...
          </option>
        ))}
      </optgroup>
    </select>
  </div>

  <section class="page-section">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h1 class="section-title-inst">{t.theses_page_title}</h1>
          <span class="section-subtitle-inst">{t.theses_page_sub} &bull; {ongoingTheses.length} {t.theses_ongoing} &bull; {completedTheses.length} {t.theses_completed}</span>
        </div>
      </div>

      <!-- Segmented Control Bar -->
      <div style="display:flex; justify-content:center;">
        <div class="segmented-control-bar" id="theses-filter-bar">
          <button class="segmented-btn active" data-type="ALL">
            <i class="fas fa-layer-group"></i> {t.theses_all} <span class="segmented-count">{allTheses.length}</span>
          </button>
          <button class="segmented-btn" data-type="ONGOING">
            <i class="fas fa-spinner fa-spin"></i> {t.theses_ongoing} <span class="segmented-count">{ongoingTheses.length}</span>
          </button>
          <button class="segmented-btn" data-type="COMPLETED">
            <i class="fas fa-check-circle"></i> {t.theses_completed} <span class="segmented-count">{completedTheses.length}</span>
          </button>
        </div>
      </div>

      <!-- Theses Cards Grid -->
      <div class="theses-grid-inst" id="theses-grid" style="margin-top:2.5rem;">
        {allTheses.map(thesis => (
          <ThesisCard thesis={thesis} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const select = document.getElementById('thesis-select');
      if (select) {
        const lang = select.dataset.lang || 'es';
        const prefix = lang === 'es' ? '' : '/' + lang;
        select.addEventListener('change', (e) => {
          if (e.target.value) {
            window.location.href = prefix + '/tesis/' + e.target.value;
          }
        });
      }

      const segBtns = document.querySelectorAll('.segmented-btn');
      const cards = document.querySelectorAll('.theses-grid-inst .thesis-card-inst');
      segBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          segBtns.forEach(b => b.classList.remove('active'));
          const target = e.target.closest('.segmented-btn');
          if (target) {
            target.classList.add('active');
            const type = target.dataset.type;
            cards.forEach(card => {
              if (type === 'ALL' || card.dataset.type === type) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          }
        });
      });
    });
  </script>
</Layout>
