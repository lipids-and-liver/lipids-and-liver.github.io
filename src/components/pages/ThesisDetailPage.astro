---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedEntry, getLocalizedCollection, getTranslations, getLocalizedPath, getThesisBadgeText, localizeThesisProgram, type Locale } from '../../utils/i18n';
import { render } from 'astro:content';

interface Props {
  id: string;
  lang: Locale;
}

const { id, lang } = Astro.props;
const t = getTranslations(lang);

const thesis = await getLocalizedEntry('theses', id, lang);
if (!thesis) {
  throw new Error(`Thesis with id "${id}" not found.`);
}

import { sortTheses } from '../../utils/theses';

const allTheses = await getLocalizedCollection('theses', lang);
sortTheses(allTheses);

const ongoingTheses = allTheses.filter(tItem => tItem.data.status === 'ongoing');
const completedTheses = allTheses.filter(tItem => tItem.data.status === 'completed');

const isOngoing = thesis.data.status === 'ongoing';
const badgeText = getThesisBadgeText(thesis, lang);
const localizedProgram = localizeThesisProgram(thesis.data.program, lang);
const directors = Array.isArray(thesis.data.directors) ? thesis.data.directors.join(', ') : thesis.data.directors;
const currentSlug = thesis.slug;
const { Content } = await render(thesis);
---

<Layout title={`${thesis.data.author} - ${t.theses_title} | Lipids & Liver`} currentPage="theses" lang={lang}>
  <!-- Nav Extra: Thesis Dropdown Selector -->
  <div slot="nav-extra" class="nav-quick-select-group">
    <label for="thesis-select"><i class="fas fa-graduation-cap"></i> {t.theses_select_label}</label>
    <select id="thesis-select" data-lang={lang} class="nav-quick-select">
      <optgroup label={t.theses_ongoing}>
        {ongoingTheses.map(tItem => (
          <option value={tItem.slug} selected={tItem.slug === currentSlug}>
            {tItem.data.author} - {tItem.data.title.substring(0, 45)}...
          </option>
        ))}
      </optgroup>
      <optgroup label={t.theses_completed}>
        {completedTheses.map(tItem => (
          <option value={tItem.slug} selected={tItem.slug === currentSlug}>
            {tItem.data.author} ({tItem.data.year}) - {tItem.data.title.substring(0, 45)}...
          </option>
        ))}
      </optgroup>
    </select>
  </div>

  <div class="container cv-container">
    <div class="cv-top-bar">
      <a href={getLocalizedPath('/tesis', lang)} class="btn-inst-secondary" style="padding:6px 14px; font-size:0.85rem; display:inline-flex; align-items:center; gap:8px;">
        <i class="fas fa-arrow-left"></i> {t.theses_back_catalog}
      </a>
    </div>

    <!-- Main Thesis Card: Mismo estilo limpio editorial que la carta de presentación -->
    <div class="cv-card">
      <!-- Columna Izquierda: Emblema académico, Estado, Metadatos de la Tesis -->
      <aside class="cv-aside">
        <div class="cv-aside-sticky">
          <div class="thesis-portrait">
          <div class="thesis-portrait-icon">
            <i class="fas fa-graduation-cap"></i>
          </div>
          <span class="thesis-year-tag">{thesis.data.year}</span>
        </div>

        <div class="cv-aside-badge">
          <span class={isOngoing ? 'thesis-badge-ongoing' : 'thesis-badge-completed'}>
            <i class={isOngoing ? 'fas fa-spinner fa-spin' : 'fas fa-check-circle'}></i> {badgeText}
          </span>
        </div>

        <div class="cv-contacts-box">
          <div class="cv-contact-item">
            <i class="fas fa-user-graduate"></i>
            <div>
              <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.theses_phd_candidate}</div>
              <strong style="color:var(--ehu-navy);">{thesis.data.author}</strong>
            </div>
          </div>

          <div class="cv-contact-item">
            <i class="fas fa-calendar-alt"></i>
            <div>
              <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.theses_status_year}</div>
              <span>{thesis.data.year}</span>
            </div>
          </div>

          <div class="cv-contact-item">
            <i class="fas fa-user-tie"></i>
            <div>
              <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.theses_directors}</div>
              <span>{directors}</span>
            </div>
          </div>

          <div class="cv-contact-item">
            <i class="fas fa-university"></i>
            <div>
              <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.theses_institution}</div>
              <span>{thesis.data.institution}</span>
            </div>
          </div>

          <div class="cv-contact-item">
            <i class="fas fa-certificate"></i>
            <div>
              <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.theses_program}</div>
              <span>{localizedProgram}</span>
            </div>
          </div>

          {thesis.data.defenseDate && (
            <div class="cv-contact-item">
              <i class="fas fa-clock"></i>
              <div>
                <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{lang === 'eu' ? 'Defentsa data:' : lang === 'en' ? 'Defense date:' : 'Fecha de defensa:'}</div>
                <span>{thesis.data.defenseDate}</span>
              </div>
            </div>
          )}

          {thesis.data.handleUrl && (
            <div class="cv-contact-item">
              <i class="fas fa-lock-open" style="color:var(--logo-green);"></i>
              <div>
                <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">Repositorio ADDI</div>
                <a href={thesis.data.handleUrl} target="_blank" rel="noopener noreferrer" style="color:var(--ehu-navy); font-weight:600; text-decoration:underline;">
                  Texto Completo (PDF) <i class="fas fa-external-link-alt" style="font-size:0.7rem;"></i>
                </a>
              </div>
            </div>
          )}

          {thesis.data.officialUrl && (
            <div class="cv-contact-item">
              <i class="fas fa-university"></i>
              <div>
                <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">UPV/EHU</div>
                <a href={thesis.data.officialUrl} target="_blank" rel="noopener noreferrer" style="color:var(--ehu-navy); font-weight:600; text-decoration:underline;">
                  Ficha Oficial del Portal <i class="fas fa-external-link-alt" style="font-size:0.7rem;"></i>
                </a>
              </div>
            </div>
          )}

          {thesis.data.dialnetUrl && (
            <div class="cv-contact-item">
              <i class="fas fa-book-reader"></i>
              <div>
                <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">Dialnet</div>
                <a href={thesis.data.dialnetUrl} target="_blank" rel="noopener noreferrer" style="color:var(--ehu-navy); font-weight:600; text-decoration:underline;">
                  Registro Dialnet <i class="fas fa-external-link-alt" style="font-size:0.7rem;"></i>
                </a>
              </div>
            </div>
          )}
        </div>

        <!-- Palabras Clave / Keywords -->
        {thesis.data.keywords && thesis.data.keywords.length > 0 && (
          <div style="width:100%; margin-top:1.25rem; text-align:left;">
            <div style="font-size:0.75rem; text-transform:uppercase; font-weight:700; color:var(--text-muted); margin-bottom:0.5rem; display:flex; align-items:center; gap:6px;">
              <i class="fas fa-tags" style="color:var(--logo-green);"></i> {t.theses_keywords_title}
            </div>
            <div style="display:flex; flex-wrap:wrap; gap:6px;">
              {thesis.data.keywords.map(k => (
                <span class="specialty-chip" style="font-size:0.75rem; padding:3px 8px;"><i class="fas fa-hashtag"></i> {k}</span>
              ))}
            </div>
          </div>
        )}
        </div>
      </aside>

      <!-- Columna Derecha: Contenido completo de la Tesis -->
      <article class="cv-main">
        <div class="cv-kicker">
          <span class="cv-dot"></span>
          {badgeText} • {thesis.data.year}
        </div>

        <h1 class="cv-main-name" style="font-size:1.6rem; line-height:1.35; margin-bottom:0.6rem;">
          "{thesis.data.title}"
        </h1>

        <div class="cv-main-title">
          {t.theses_phd_candidate}: <strong>{thesis.data.author}</strong>
        </div>

        <!-- Resumen / Abstract -->
        <div class="cv-bio">
          <h3 class="cv-block-title" style="margin-bottom:0.85rem;"><i class="fas fa-file-alt"></i> {t.theses_abstract_title}</h3>
          <Content />
        </div>

        <!-- Filiación Institucional -->
        <div class="cv-block">
          <h3 class="cv-block-title"><i class="fas fa-university"></i> {t.theses_affiliation_title}</h3>
          <ul class="cv-clean-list">
            <li><strong>{t.theses_dept}:</strong> {t.theses_dept_val}</li>
            <li><strong>{t.theses_inst}:</strong> {t.theses_inst_val}</li>
            <li><strong>{t.theses_group}:</strong> {t.theses_group_val}</li>
          </ul>
        </div>
      </article>
    </div>
  </div>

  <script is:inline>
    const select = document.getElementById('thesis-select');
    if (select) {
      const lang = select.dataset.lang || 'es';
      const prefix = lang === 'es' ? '/portal' : '/portal/' + lang;
      select.addEventListener('change', (e) => {
        if (e.target.value) {
          window.location.href = prefix + '/tesis/' + e.target.value;
        }
      });
    }
  </script>
</Layout>
