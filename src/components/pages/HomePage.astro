---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getLocalizedEntry, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import { render } from 'astro:content';
import stats from '../../data/stats.json';
import ResearchCard from '../cards/ResearchCard.astro';
import TeamCard from '../cards/TeamCard.astro';
import ThesisCard from '../cards/ThesisCard.astro';
import PublicationCard from '../cards/PublicationCard.astro';
import TrainingCard from '../cards/TrainingCard.astro';
import ProjectCard from '../cards/ProjectCard.astro';
import NewsCard from '../cards/NewsCard.astro';
import PartnerCard from '../cards/PartnerCard.astro';
import AlumniCard from '../cards/AlumniCard.astro';
import collaborationsData from '../../data/collaborations.json';
import alumniData from '../../data/alumni.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const presentationEntries = await getLocalizedCollection('presentation', lang);
presentationEntries.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const presentationTabs = await Promise.all(
  presentationEntries.map(async (entry, index) => {
    const { Content } = await render(entry);
    return {
      entry,
      Content,
      isActive: index === 0
    };
  })
);

const letterEntry = await getLocalizedEntry('letter', 'carta', lang);
const letterRender = letterEntry ? await render(letterEntry) : null;
const LetterContent = letterRender ? letterRender.Content : null;

const researchLines = await getLocalizedCollection('research', lang);
researchLines.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

import { sortTheses } from '../../utils/theses';

const teamMembers = await getLocalizedCollection('team', lang);
teamMembers.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const allTheses = await getLocalizedCollection('theses', lang);
sortTheses(allTheses);
const ongoingCount = allTheses.filter(t => t.data.status === 'ongoing').length;
const completedCount = allTheses.filter(t => t.data.status === 'completed').length;

const allPubs = await getLocalizedCollection('publications', lang);
allPubs.sort((a, b) => Number(b.data.year) - Number(a.data.year));
const latestPublications = allPubs.slice(0, 6);

const trainings = await getLocalizedCollection('training', lang);
trainings.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allProjects = await getLocalizedCollection('projects', lang);
allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const featuredProjects = allProjects.slice(0, 4);

const allNews = await getLocalizedCollection('news', lang);
allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestNews = allNews.slice(0, 3);

const featuredAlumni = alumniData.slice(0, 4);
---

<Layout currentPage="home" lang={lang}>
  <!-- Institutional Hero Banner with Dynamic Interactive Network -->
  <section class="institutional-hero" id="hero">
    <!-- Interactive Background Canvas & Ambient Glowing Orbs -->
    <div class="hero-canvas-wrap">
      <canvas id="hero-particles-canvas"></canvas>
    </div>
    <div class="hero-ambient-orb hero-orb-1"></div>
    <div class="hero-ambient-orb hero-orb-2"></div>

    <div class="container hero-grid">
      <div class="hero-content">
        <span class="hero-tag">
          <span class="hero-pulse-badge">
            <span class="hero-pulse-ring"></span>
            <span class="hero-pulse-dot"></span>
          </span>
          <i class="fas fa-award"></i> {t.hero_tag || 'Grupo Consolidado del Gobierno Vasco (IT1560-22)'}
        </span>
        
        <h1 class="hero-headline">
          {t.hero_title}
        </h1>

        <p class="hero-lead">
          {t.hero_subtitle}
        </p>

        <div class="hero-btn-group">
          <a href={getLocalizedPath('/#lines', lang)} class="btn-inst-primary">
            {t.cta_lines} <i class="fas fa-microscope"></i>
          </a>
          <a href={getLocalizedPath('/#team', lang)} class="btn-inst-secondary">
            {t.cta_team} <i class="fas fa-user-friends"></i>
          </a>
        </div>
      </div>

      <div class="hero-banner-img-box">
        <img src="/assets/images/hero_outdoor_group.jpg" alt="Grupo de Investigación Lipids & Liver en Exteriores" />
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid" id="stats-grid">
        {stats.map(stat => (
          <div class="stat-box">
            <div class="stat-val">{stat.number}</div>
            <div class="stat-tit">{stat.label}</div>
            <div class="stat-desc">{stat.subtext}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About / Presentación Section -->
  <section class="page-section" id="about">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.about_title}</h2>
          <span class="section-subtitle-inst">{t.about_subtitle}</span>
        </div>
      </div>

      <!-- Apartado 1: Carta de Presentación de la Investigadora Principal (IP) -->
      <div class="about-pi-card">
        <aside class="about-pi-aside">
          <div class="about-pi-portrait">
            <img
              src={letterEntry?.data.piImage || "/assets/images/team/patricia-aspichueta/image.jpg"}
              alt={letterEntry?.data.piName || t.about_letter_sign_name}
              class="about-pi-photo"
              loading="lazy"
            />
          </div>
          <div class="about-pi-info">
            <h3 class="about-pi-name">{letterEntry?.data.piName || t.about_letter_sign_name}</h3>
            <span class="about-pi-role">{letterEntry?.data.piRole || t.about_letter_pi_role}</span>

            <div class="about-pi-actions">
              <a
                href={getLocalizedPath(letterEntry?.data.cvLink || '/curriculum/patricia-aspichueta', lang)}
                class="about-pi-cv-btn"
              >
                <span>{letterEntry?.data.viewCvText || t.about_letter_view_cv}</span>
                <i class="fas fa-arrow-right"></i>
              </a>

              <div class="about-pi-contacts">
                <a
                  href={`mailto:${letterEntry?.data.email || 'patricia.aspichueta@ehu.eus'}`}
                  class="about-pi-contact-badge"
                  title={letterEntry?.data.email || 'patricia.aspichueta@ehu.eus'}
                  aria-label="Email"
                >
                  <i class="fas fa-envelope"></i>
                </a>
                <a
                  href={`https://orcid.org/${letterEntry?.data.orcid || '0000-0002-8921-9421'}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="about-pi-contact-badge"
                  title={`ORCID: ${letterEntry?.data.orcid || '0000-0002-8921-9421'}`}
                  aria-label="ORCID"
                >
                  <i class="fab fa-orcid" style="color:#a6ce39;"></i>
                </a>
              </div>
            </div>
          </div>
        </aside>

        <article class="about-pi-letter">
          <div class="about-letter-header">
            <div class="about-letter-kicker">
              <span class="about-letter-dot"></span>
              {letterEntry?.data.badge || t.about_letter_badge}
            </div>
            <h3 class="about-letter-heading">{letterEntry?.data.title || t.about_letter_title}</h3>
          </div>

          <div class="about-letter-body">
            <p class="about-letter-salutation">
              <strong>{letterEntry?.data.salutation || t.about_letter_greeting}</strong>
            </p>
            {LetterContent ? (
              <LetterContent />
            ) : (
              <>
                <p>{t.about_letter_p1}</p>
                <p>{t.about_letter_p2}</p>
                <p>{t.about_letter_p3}</p>
              </>
            )}
          </div>

          <div class="about-letter-signature-block">
            <div class="about-letter-signature-mark"></div>
            <div class="about-letter-sign-name">{letterEntry?.data.piName || t.about_letter_sign_name}</div>
            <div class="about-letter-sign-meta">
              <span>{letterEntry?.data.signRole || t.about_letter_sign_role}</span>
              <span class="about-letter-sign-separator">•</span>
              <span>{letterEntry?.data.signDept || t.about_letter_sign_dept}</span>
            </div>
          </div>
        </article>
      </div>

      <!-- Apartado 2: A continuación, las pestañas siguientes -->
      <div class="about-tabs-block">
        <div class="about-tabs-header-bar">
          <h3 class="about-tabs-block-title">
            <i class="fas fa-layer-group"></i> {t.about_tabs_heading}
          </h3>
          <span class="about-tabs-block-subtitle">
            {t.about_tabs_subheading}
          </span>
        </div>

        <div class="about-card">
          <div class="about-tabs" id="about-tabs-group">
            {presentationTabs.map((tab) => (
              <button
                class={`tab-btn ${tab.isActive ? 'active' : ''}`}
                data-tab={tab.entry.data.tabId}
              >
                {tab.entry.data.tabTitle}
              </button>
            ))}
          </div>

          {presentationTabs.map((tab) => {
            const { entry, Content, isActive } = tab;
            const { tabId, specialties, staffCompositionTitle, staffComposition } = entry.data;
            const hasSidebar = (specialties && specialties.length > 0) || (staffComposition && staffComposition.length > 0);

            return (
              <div class={`tab-content ${isActive ? 'active' : ''}`} id={tabId}>
                {hasSidebar ? (
                  <div class="about-grid">
                    <div class="about-text">
                      <Content />
                      {specialties && specialties.length > 0 && (
                        <div class="specialty-list">
                          {specialties.map((spec: string) => (
                            <span class="specialty-chip"><i class="fas fa-check-circle"></i> {spec}</span>
                          ))}
                        </div>
                      )}
                    </div>

                    {staffComposition && staffComposition.length > 0 && (
                      <div style="background:var(--bg-surface-alt); padding:1.5rem; border-radius:var(--radius-md); border:1px solid var(--border-color)">
                        <h4 style="margin-bottom:1rem; color:var(--ehu-navy)">
                          <i class="fas fa-users"></i> {staffCompositionTitle || 'Composición del Personal'}
                        </h4>
                        <ul style="list-style:none; line-height:2">
                          {staffComposition.map((member: { count: string; role: string }) => (
                            <li>
                              <strong style="color:var(--ehu-navy)">{member.count}</strong> {member.role}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                ) : (
                  <div class="about-text">
                    <Content />
                    {entry.data.tabId === 'tab-infraestructura' && (
                      <div style="margin-top: 1.5rem;">
                        <a href={getLocalizedPath('/sgiker', lang)} class="btn-inst-primary" style="display:inline-flex; align-items:center; gap:8px;">
                          <i class="fas fa-flask"></i> {t.sgiker_btn || 'Ver Servicios y Protocolos'} <i class="fas fa-arrow-right"></i>
                        </a>
                      </div>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Lines Section -->
  <section class="page-section page-section-alt" id="lines">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.lines_title}</h2>
          <span class="section-subtitle-inst">{t.lines_subtitle}</span>
        </div>
      </div>

      <div class="research-grid-inst" id="lines-grid">
        {researchLines.map(line => (
          <ResearchCard line={line} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section: Producción Científica & Hitos (Publicaciones, Proyectos y Tesis Unificados) -->
  <section class="page-section" id="outputs">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.outputs_section_title || 'Producción Científica & Hitos'}</h2>
          <span class="section-subtitle-inst">{t.outputs_section_subtitle || 'Artículos de impacto internacional, proyectos públicos competitivos y tesis doctorales'}</span>
        </div>
      </div>

      <!-- Segmented Switcher for Scientific Outputs -->
      <div style="display:flex; justify-content:center; margin-bottom:2rem;">
        <div class="segmented-control-bar" id="outputs-switcher">
          <button class="segmented-btn outputs-tab-btn active" data-target="output-pubs">
            <i class="fas fa-book-open"></i> {t.outputs_tab_pubs || 'Publicaciones JCR'} <span class="segmented-count">{allPubs.length}</span>
          </button>
          <button class="segmented-btn outputs-tab-btn" data-target="output-projects">
            <i class="fas fa-hand-holding-usd"></i> {t.outputs_tab_projects || 'Proyectos Financiados'} <span class="segmented-count">{allProjects.length}</span>
          </button>
          <button class="segmented-btn outputs-tab-btn" data-target="output-theses">
            <i class="fas fa-graduation-cap"></i> {t.outputs_tab_theses || 'Tesis Doctorales'} <span class="segmented-count">{allTheses.length}</span>
          </button>
        </div>
      </div>

      <!-- Tab Panel 1: Publicaciones -->
      <div class="output-panel active" id="output-pubs">
        <div class="pubs-list" id="pubs-list">
          {latestPublications.map(pub => (
            <PublicationCard pub={pub} />
          ))}
        </div>
        <div style="text-align:center; margin-top:2.5rem; background:var(--bg-surface-alt); padding:2rem; border-radius:var(--radius-md); border:1px dashed var(--border-color);">
          <p style="font-size:1rem; color:var(--text-secondary); margin-bottom:1.25rem;">
            <i class="fas fa-book-reader" style="color:var(--logo-green); margin-right:8px;"></i>
            {t.pubs_archive_note}
          </p>
          <a href={getLocalizedPath('/publicaciones', lang)} class="btn-inst-primary" style="padding:12px 28px; font-size:0.95rem; border-radius:30px; display:inline-flex; align-items:center; gap:10px;">
            <i class="fas fa-book-open"></i> {t.pubs_view_all_btn} ({allPubs.length}) <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <!-- Tab Panel 2: Proyectos Financiados -->
      <div class="output-panel" id="output-projects" style="display:none;">
        <div class="projects-grid-inst" id="featured-projects-grid">
          {featuredProjects.map(project => (
            <ProjectCard project={project} lang={lang} />
          ))}
        </div>
        <div style="text-align:center; margin-top:2.5rem;">
          <a href={getLocalizedPath('/proyectos', lang)} class="btn-inst-primary" style="padding:12px 28px; font-size:0.95rem; border-radius:30px; display:inline-flex; align-items:center; gap:10px;">
            <i class="fas fa-hand-holding-usd"></i> {t.projects_view_catalog || 'Ver Todos los Proyectos'} ({allProjects.length}) <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <!-- Tab Panel 3: Tesis Doctorales -->
      <div class="output-panel" id="output-theses" style="display:none;">
        <div style="display:flex; justify-content:center; margin-bottom: 2rem;">
          <div class="segmented-control-bar" id="theses-filter-bar">
            <button class="segmented-btn theses-filter-btn active" data-type="ALL">
              <i class="fas fa-layer-group"></i> {t.theses_all} <span class="segmented-count">{allTheses.length}</span>
            </button>
            <button class="segmented-btn theses-filter-btn" data-type="ONGOING">
              <i class="fas fa-spinner fa-spin"></i> {t.theses_ongoing} <span class="segmented-count">{ongoingCount}</span>
            </button>
            <button class="segmented-btn theses-filter-btn" data-type="COMPLETED">
              <i class="fas fa-check-circle"></i> {t.theses_completed} <span class="segmented-count">{completedCount}</span>
            </button>
          </div>
        </div>
        <div class="theses-grid-inst" id="theses-grid">
          {allTheses.map(thesis => (
            <ThesisCard thesis={thesis} lang={lang} />
          ))}
        </div>
        <div style="text-align:center; margin-top:2.5rem;">
          <a href={getLocalizedPath('/tesis', lang)} class="btn-inst-primary" style="padding:12px 28px; font-size:0.95rem; border-radius:30px; display:inline-flex; align-items:center; gap:10px;">
            <i class="fas fa-graduation-cap"></i> {t.theses_page_title} ({allTheses.length}) <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Equipo & Trayectoria (Equipo Actual + Alumni Unificados) -->
  <section class="page-section page-section-alt" id="team">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.team_title}</h2>
          <span class="section-subtitle-inst">{t.team_subtitle}</span>
        </div>
        <a href={getLocalizedPath('/curriculum', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
          <i class="fas fa-id-card"></i> {t.nav_cv_portal} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
        </a>
      </div>

      <!-- Segmented Switcher for Team Views: Current Team vs Alumni -->
      <div style="display:flex; justify-content:center; margin-bottom:2rem;">
        <div class="segmented-control-bar" id="team-view-switcher">
          <button class="segmented-btn team-view-btn active" data-target="team-active-panel">
            <i class="fas fa-users"></i> {t.team_tab_active || 'Equipo Actual'} <span class="segmented-count">{teamMembers.length}</span>
          </button>
          <button class="segmented-btn team-view-btn" data-target="team-alumni-panel">
            <i class="fas fa-user-graduate"></i> {t.team_tab_alumni || 'Antiguos Miembros (Alumni)'} <span class="segmented-count">{featuredAlumni.length}</span>
          </button>
        </div>
      </div>

      <!-- Panel: Active Team -->
      <div class="team-panel active" id="team-active-panel">
        <div class="team-filter-bar" id="team-category-filters">
          <button class="team-filter-btn active" data-category="ALL"><i class="fas fa-users"></i> {t.team_all}</button>
          <button class="team-filter-btn" data-category="PDI"><i class="fas fa-user-tie"></i> {t.team_pdi}</button>
          <button class="team-filter-btn" data-category="Posdoctoral"><i class="fas fa-user-graduate"></i> {t.team_postdoc}</button>
          <button class="team-filter-btn" data-category="Predoctoral"><i class="fas fa-book-reader"></i> {t.team_predoc}</button>
          <button class="team-filter-btn" data-category="Técnico"><i class="fas fa-tools"></i> {t.team_tech}</button>
        </div>

        <div class="team-grid-inst" id="team-grid">
          {teamMembers.map(member => (
            <TeamCard member={member} lang={lang} />
          ))}
        </div>
      </div>

      <!-- Panel: Alumni -->
      <div class="team-panel" id="team-alumni-panel" style="display:none;">
        <div class="alumni-grid-inst">
          {featuredAlumni.map(alumni => (
            <AlumniCard alumni={alumni} lang={lang} />
          ))}
        </div>
        <div style="text-align:center; margin-top:2.5rem; background:var(--bg-surface-alt); padding:2rem; border-radius:var(--radius-md); border:1px dashed var(--border-color);">
          <p style="font-size:1rem; color:var(--text-secondary); margin-bottom:1.25rem;">
            <i class="fas fa-university" style="color:var(--logo-green); margin-right:8px;"></i>
            {t.alumni_stat_desc}
          </p>
          <a href={getLocalizedPath('/alumni', lang)} class="btn-inst-primary" style="padding:12px 28px; font-size:0.95rem; border-radius:30px; display:inline-flex; align-items:center; gap:10px;">
            <i class="fas fa-user-graduate"></i> {t.alumni_view_all || 'Ver Red de Antiguos Miembros'} <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Formación Académica & Talento (Docencia + Únete Unificados) -->
  <section class="page-section" id="training">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.training_talent_title || 'Formación Académica & Talento'}</h2>
          <span class="section-subtitle-inst">{t.training_talent_subtitle || 'Docencia oficial en la UPV/EHU y oportunidades de incorporación para estudiantes e investigadores'}</span>
        </div>
        <a href={getLocalizedPath('/unete', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
          <i class="fas fa-user-plus"></i> {t.join_btn || 'Ver Oportunidades y Convocatorias'} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
        </a>
      </div>

      <!-- Segmented Switcher for Training vs Opportunities -->
      <div style="display:flex; justify-content:center; margin-bottom:2rem;">
        <div class="segmented-control-bar" id="training-view-switcher">
          <button class="segmented-btn training-tab-btn active" data-target="training-courses-panel">
            <i class="fas fa-chalkboard-teacher"></i> {t.training_tab_academic || 'Docencia (Grados y Másteres)'}
          </button>
          <button class="segmented-btn training-tab-btn" data-target="training-join-panel">
            <i class="fas fa-user-plus"></i> {t.training_tab_opportunities || 'Únete al Laboratorio (TFG, TFM, Tesis)'}
          </button>
        </div>
      </div>

      <!-- Panel: Courses / Docencia -->
      <div class="training-panel active" id="training-courses-panel">
        <div class="training-bento-grid" id="training-bento-grid">
          {trainings.map((tr, idx) => (
            <TrainingCard training={tr} lang={lang} index={idx} />
          ))}
        </div>
      </div>

      <!-- Panel: Opportunities / Únete -->
      <div class="training-panel" id="training-join-panel" style="display:none;">
        <div class="research-grid-inst">
          <div class="research-card-inst">
            <div class="research-card-content">
              <div class="research-card-header">
                <span class="research-badge" style="background:#e0f2fe; color:#0369a1;"><i class="fas fa-book-reader"></i> TFG / TFM</span>
                <h3 class="research-card-title">Estudiantes de Grado y Máster</h3>
              </div>
              <p class="research-card-desc">
                Prácticas de laboratorio y trabajos fin de titulación en Medicina, Bioquímica, Biología, Biotecnología y Farmacia (UPV/EHU).
              </p>
            </div>
          </div>

          <div class="research-card-inst">
            <div class="research-card-content">
              <div class="research-card-header">
                <span class="research-badge" style="background:#fef3c7; color:#92400e;"><i class="fas fa-graduation-cap"></i> Doctorado</span>
                <h3 class="research-card-title">Tesis Doctorales (FPU / FPI)</h3>
              </div>
              <p class="research-card-desc">
                Apoyo en solicitudes de contratos predoctorales del Gobierno Vasco y Plan Estatal para integrarse en proyectos financiados de vanguardia.
              </p>
            </div>
          </div>

          <div class="research-card-inst">
            <div class="research-card-content">
              <div class="research-card-header">
                <span class="research-badge" style="background:#f3e8ff; color:#6b21a8;"><i class="fas fa-microscope"></i> Posdoctoral</span>
                <h3 class="research-card-title">Investigadores/as Posdoctorales</h3>
              </div>
              <p class="research-card-desc">
                Recepción de candidaturas para programas Juan de la Cierva, Marie Skłodowska-Curie Actions (MSCA) y perfeccionamiento posdoctoral UPV/EHU.
              </p>
            </div>
          </div>
        </div>

