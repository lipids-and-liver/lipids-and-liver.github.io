  <!-- Interactive Client-side Logic for Index Page (Tabs, Segmented Theses, Team Search) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. About Tabs
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => b.classList.remove('active'));
          tabContents.forEach(c => c.classList.remove('active'));
          btn.classList.add('active');
          const target = document.getElementById(btn.dataset.tab);
          if (target) target.classList.add('active');
        });
      });

      // 2. Scientific Outputs Segmented Switcher (Pubs, Projects, Theses)
      const outputBtns = document.querySelectorAll('.outputs-tab-btn');
      const outputPanels = document.querySelectorAll('.output-panel');
      outputBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          outputBtns.forEach(b => b.classList.remove('active'));
          const targetBtn = e.target.closest('.outputs-tab-btn');
          if (targetBtn) {
            targetBtn.classList.add('active');
            const targetId = targetBtn.dataset.target;
            outputPanels.forEach(panel => {
              if (panel.id === targetId) {
                panel.style.display = 'block';
                panel.classList.add('active');
              } else {
                panel.style.display = 'none';
                panel.classList.remove('active');
              }
            });
          }
        });
      });

      // 3. Theses Sub-filter inside Outputs Panel
      const thesisFilterBtns = document.querySelectorAll('.theses-filter-btn');
      const thesisCards = document.querySelectorAll('.theses-grid-inst .thesis-card-inst');
      thesisFilterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          thesisFilterBtns.forEach(b => b.classList.remove('active'));
          const targetBtn = e.target.closest('.theses-filter-btn');
          if (targetBtn) {
            targetBtn.classList.add('active');
            const type = targetBtn.dataset.type;
            thesisCards.forEach(card => {
              if (type === 'ALL' || card.dataset.type === type) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          }
        });
      });

      // 4. Team View Switcher (Active Team vs Alumni)
      const teamViewBtns = document.querySelectorAll('.team-view-btn');
      const teamPanels = document.querySelectorAll('.team-panel');
      teamViewBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          teamViewBtns.forEach(b => b.classList.remove('active'));
          const targetBtn = e.target.closest('.team-view-btn');
          if (targetBtn) {
            targetBtn.classList.add('active');
            const targetId = targetBtn.dataset.target;
            teamPanels.forEach(panel => {
              if (panel.id === targetId) {
                panel.style.display = 'block';
                panel.classList.add('active');
              } else {
                panel.style.display = 'none';
                panel.classList.remove('active');
              }
            });
          }
        });
      });

      // 5. Team Filter Buttons (Active Team)
      const teamFilterBtns = document.querySelectorAll('.team-filter-btn');
      const teamCards = document.querySelectorAll('.team-grid-inst .team-card-inst');

      let currentCategory = 'ALL';

      function filterTeam() {
        teamCards.forEach(card => {
          const category = card.dataset.category || '';
          const catKey = card.dataset.catkey || '';

          let matchesCategory = false;
          if (currentCategory === 'ALL') {
            matchesCategory = true;
          } else if (currentCategory === 'PDI') {
            matchesCategory = catKey === 'pdi' || catKey === 'leadership' || catKey === 'ryc' || category === 'Coordinadora' || category === 'Directora de Línea' || category === 'Investigador Senior' || category === 'PDI' || category.includes('Ramón y Cajal');
          } else if (currentCategory === 'Posdoctoral') {
            matchesCategory = catKey === 'postdoc' || category.toLowerCase().includes('posdoctoral');
          } else if (currentCategory === 'Predoctoral') {
            matchesCategory = catKey === 'predoc' || category.toLowerCase().includes('predoctoral');
          } else if (currentCategory === 'Técnico') {
            matchesCategory = catKey === 'tech' || category.toLowerCase().includes('técnico') || category.toLowerCase().includes('tecnico');
          } else {
            matchesCategory = category.toLowerCase().includes(currentCategory.toLowerCase()) || catKey === currentCategory.toLowerCase();
          }

          card.style.display = matchesCategory ? 'flex' : 'none';
        });
      }

      teamFilterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          teamFilterBtns.forEach(b => b.classList.remove('active'));
          const target = e.target.closest('.team-filter-btn');
          if (target) {
            target.classList.add('active');
            currentCategory = target.dataset.category;
            filterTeam();
          }
        });
      });

      // 6. Training View Switcher (Courses vs Opportunities)
      const trainingTabBtns = document.querySelectorAll('.training-tab-btn');
      const trainingPanels = document.querySelectorAll('.training-panel');
      trainingTabBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          trainingTabBtns.forEach(b => b.classList.remove('active'));
          const targetBtn = e.target.closest('.training-tab-btn');
          if (targetBtn) {
            targetBtn.classList.add('active');
            const targetId = targetBtn.dataset.target;
            trainingPanels.forEach(panel => {
              if (panel.id === targetId) {
                panel.style.display = 'block';
                panel.classList.add('active');
              } else {
                panel.style.display = 'none';
                panel.classList.remove('active');
              }
            });
          }
        });
      });



      // 0. Hero Interactive Dynamic Effects
      // A. Dynamic Molecular/Lipid Particle Network Simulation
      const heroSection = document.getElementById('hero');
      const heroCanvas = document.getElementById('hero-particles-canvas');

      if (heroCanvas && heroSection) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        if (!prefersReducedMotion) {
          const ctx = heroCanvas.getContext('2d');
          let width = (heroCanvas.width = heroSection.offsetWidth);
          let height = (heroCanvas.height = heroSection.offsetHeight);

          let particles = [];
          const particleCount = Math.min(Math.floor((width * height) / 18000), 55);
          const mouse = { x: -1000, y: -1000, active: false };

          class Particle {
            constructor() {
              this.reset(true);
            }
            reset(initial = false) {
              this.x = initial ? Math.random() * width : (Math.random() > 0.5 ? 0 : width);
              this.y = initial ? Math.random() * height : Math.random() * height;
              this.vx = (Math.random() - 0.5) * 0.55;
              this.vy = (Math.random() - 0.5) * 0.55;
              this.radius = Math.random() * 2.8 + 1.2;
              this.baseRadius = this.radius;
              this.alpha = Math.random() * 0.45 + 0.2;
              const isCyan = Math.random() > 0.55;
              this.color = isCyan ? '56, 189, 248' : '138, 198, 63';
              this.pulseAngle = Math.random() * Math.PI * 2;
              this.pulseSpeed = 0.02 + Math.random() * 0.02;
            }
            update() {
              this.pulseAngle += this.pulseSpeed;
              this.radius = this.baseRadius + Math.sin(this.pulseAngle) * 0.6;

              this.x += this.vx;
              this.y += this.vy;

              if (mouse.active) {
                const dx = mouse.x - this.x;
                const dy = mouse.y - this.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < 130) {
                  const force = (130 - dist) / 130;
                  this.x -= (dx / dist) * force * 1.5;
                  this.y -= (dy / dist) * force * 1.5;
                }
              }

              if (this.x < -20) this.x = width + 20;
              if (this.x > width + 20) this.x = -20;
              if (this.y < -20) this.y = height + 20;
              if (this.y > height + 20) this.y = -20;
            }
            draw() {
              ctx.beginPath();
              ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(${this.color}, ${this.alpha})`;
              ctx.shadowColor = `rgba(${this.color}, 0.5)`;
              ctx.shadowBlur = 6;
              ctx.fill();
              ctx.shadowBlur = 0;
            }
          }

          for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
          }

          let isHeroVisible = true;
          let animId = null;

          function animate() {
            if (!isHeroVisible) return;
            ctx.clearRect(0, 0, width, height);

            for (let i = 0; i < particles.length; i++) {
              const p1 = particles[i];
              p1.update();
              p1.draw();

              for (let j = i + 1; j < particles.length; j++) {
                const p2 = particles[j];
                const dx = p1.x - p2.x;
                const dy = p1.y - p2.y;
                const dist = Math.sqrt(dx * dx + dy * dy);

                if (dist < 110) {
                  const connAlpha = (1 - dist / 110) * 0.18;
                  ctx.beginPath();
                  ctx.moveTo(p1.x, p1.y);
                  ctx.lineTo(p2.x, p2.y);
                  ctx.strokeStyle = `rgba(138, 198, 63, ${connAlpha})`;
                  ctx.lineWidth = 1;
                  ctx.stroke();
                }
              }

              if (mouse.active) {
                const mdx = p1.x - mouse.x;
                const mdy = p1.y - mouse.y;
                const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
                if (mdist < 140) {
                  const mAlpha = (1 - mdist / 140) * 0.35;
                  ctx.beginPath();
                  ctx.moveTo(p1.x, p1.y);
                  ctx.lineTo(mouse.x, mouse.y);
                  ctx.strokeStyle = `rgba(56, 189, 248, ${mAlpha})`;
                  ctx.lineWidth = 1.2;
                  ctx.stroke();
                }
              }
            }

            animId = requestAnimationFrame(animate);
          }

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              isHeroVisible = entry.isIntersecting;
              if (isHeroVisible && !animId) {
                animate();
              } else if (!isHeroVisible && animId) {
                cancelAnimationFrame(animId);
                animId = null;
              }
            });
          }, { threshold: 0.1 });
          observer.observe(heroSection);

          window.addEventListener('resize', () => {
            width = heroCanvas.width = heroSection.offsetWidth;
            height = heroCanvas.height = heroSection.offsetHeight;
          }, { passive: true });

          heroSection.addEventListener('mousemove', (e) => {
            const rect = heroSection.getBoundingClientRect();
            mouse.x = e.clientX - rect.left;
            mouse.y = e.clientY - rect.top;
            mouse.active = true;
          });

          heroSection.addEventListener('mouseleave', () => {
            mouse.active = false;
            mouse.x = -1000;
            mouse.y = -1000;
          });

          animate();
        }
      }

      // 6. Contact Form
      const form = document.getElementById('contact-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          alert("¡Muchas gracias! Su mensaje ha sido enviado correctamente al Grupo de Investigación Lipids & Liver.");
          form.reset();
        });
      }
    });
  </script>
</Layout>
