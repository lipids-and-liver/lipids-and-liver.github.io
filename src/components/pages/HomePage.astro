---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import { render } from 'astro:content';
import stats from '../../data/stats.json';
import ResearchCard from '../cards/ResearchCard.astro';
import TeamCard from '../cards/TeamCard.astro';
import ThesisCard from '../cards/ThesisCard.astro';
import PublicationCard from '../cards/PublicationCard.astro';
import TrainingCard from '../cards/TrainingCard.astro';
import ProjectCard from '../cards/ProjectCard.astro';
import PatentCard from '../cards/PatentCard.astro';
import AlumniCard from '../cards/AlumniCard.astro';
import OpportunityCard from '../cards/OpportunityCard.astro';
import ResourceCard from '../cards/ResourceCard.astro';
import NewsCard from '../cards/NewsCard.astro';
import OutreachCard from '../cards/OutreachCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const presentationEntries = await getLocalizedCollection('presentation', lang);
presentationEntries.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const presentationTabs = await Promise.all(
  presentationEntries.map(async (entry, index) => {
    const { Content } = await render(entry);
    return {
      entry,
      Content,
      isActive: index === 0
    };
  })
);

const researchLines = await getLocalizedCollection('research', lang);
researchLines.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

import { sortTheses } from '../../utils/theses';

const teamMembers = await getLocalizedCollection('team', lang);
teamMembers.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const allTheses = await getLocalizedCollection('theses', lang);
sortTheses(allTheses);
const ongoingCount = allTheses.filter(t => t.data.status === 'ongoing').length;
const completedCount = allTheses.filter(t => t.data.status === 'completed').length;

const allPubs = await getLocalizedCollection('publications', lang);
allPubs.sort((a, b) => Number(b.data.year) - Number(a.data.year));
const latestPublications = allPubs.slice(0, 6);

const trainings = await getLocalizedCollection('training', lang);
trainings.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allProjects = await getLocalizedCollection('projects', lang);
allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allTransfer = await getLocalizedCollection('transfer', lang);
allTransfer.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const patents = allTransfer.filter(item => item.data.type === 'patent');
const services = allTransfer.filter(item => item.data.type === 'service');

const allAlumni = await getLocalizedCollection('alumni', lang);
allAlumni.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allOpportunities = await getLocalizedCollection('opportunities', lang);
allOpportunities.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allResources = await getLocalizedCollection('resources', lang);
allResources.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allNews = await getLocalizedCollection('news', lang);
allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allOutreach = await getLocalizedCollection('outreach', lang);
allOutreach.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const collaborations = [
  {
    badge: lang === 'eu' ? 'Bikaintasun Sarea' : lang === 'en' ? 'Network of Excellence' : 'Red de Excelencia',
    name: 'CIBERehd',
    desc: lang === 'eu' 
      ? 'Gibeleko eta Digestio Gaixotasunen Ikerketa Biomedikoko Sareko Zentroa (Instituto de Salud Carlos III).'
      : lang === 'en'
      ? 'Biomedical Research Networking Center in Hepatic and Digestive Diseases (Carlos III Health Institute).'
      : 'Centro de Investigación Biomédica en Red de Enfermedades Hepáticas y Digestivas (Instituto de Salud Carlos III).',
    field: lang === 'eu' ? 'MASLD eta zirrosi kohorteetan elkarlana' : lang === 'en' ? 'Collaboration in MASLD and cirrhosis cohorts' : 'Colaboración en cohortes de MASLD y cirrosis'
  },
  {
    badge: lang === 'eu' ? 'Aliantza Klinikoa' : lang === 'en' ? 'Clinical Alliance' : 'Alianza Clínica',
    name: 'Hospital Universitario de Cruces',
    desc: lang === 'eu'
      ? 'Digestio Aparatuko eta Kirurgia Orokorreko / Gibel Transplante Zerbitzuak. Balioztatze klinikoa biopsia edo erauzketak dituzten pazienteetan.'
      : lang === 'en'
      ? 'Digestive System and General Surgery / Liver Transplantation Services. Clinical validation in biopsied or resected patients.'
      : 'Servicios de Aparato Digestivo y Cirugía General / Trasplante Hepático. Validación clínica en pacientes sometidos a biopsia o resección.',
    field: lang === 'eu' ? 'Ex-vivo ikerketa traslazionalak' : lang === 'en' ? 'Ex-vivo translational studies' : 'Estudios traslacionales ex-vivo'
  },
  {
    badge: lang === 'eu' ? 'Oinarrizko Ikerketa' : lang === 'en' ? 'Basic Research' : 'Investigación Básica',
    name: 'CIC bioGUNE',
    desc: lang === 'eu'
      ? 'Elkarlan jarraitua Gibel Metabolismo eta Erresonantzia Magnetiko Nuklearreko laborategiekin Bizkaiko Parke Teknologikoan.'
      : lang === 'en'
      ? 'Continuous partnership with Hepatic Metabolism and Nuclear Magnetic Resonance labs at Bizkaia Technology Park.'
      : 'Colaboración continuada con los laboratorios de Metabolismo Hepático y Resonancia Magnética Nuclear en el Parque Tecnológico de Bizkaia.',
    field: lang === 'eu' ? 'Metabolomika eta Egiturazko Biologia' : lang === 'en' ? 'Metabolomics & Structural Biology' : 'Metabolómica y Biología Estructural'
  },
  {
    badge: lang === 'eu' ? 'Nazioartekoa (Suedia)' : lang === 'en' ? 'International (Sweden)' : 'Internacional (Suecia)',
    name: 'Karolinska Institutet',
    desc: lang === 'eu'
      ? 'Department of Laboratory Medicine (Stockholm). Doktoretza-aurreko ikertzaileen trukea eta esteatohepatitis ereduetako analisi lipidomikoa.'
      : lang === 'en'
      ? 'Department of Laboratory Medicine (Stockholm). Predoctoral researcher exchange and lipidomic analysis of steatohepatitis models.'
      : 'Department of Laboratory Medicine (Estocolmo). Intercambio de investigadores predoctorales y análisis lipidómico de modelos de esteatohepatitis.',
    field: lang === 'eu' ? 'JCR argitalpen bateratuak' : lang === 'en' ? 'Joint JCR publications' : 'Publicaciones conjuntas JCR'
  },
  {
    badge: lang === 'eu' ? 'Nazioartekoa (Frantzia)' : lang === 'en' ? 'International (France)' : 'Internacional (Francia)',
    name: 'INSERM U1016 (Institut Cochin)',
    desc: lang === 'eu'
      ? 'Paris. Europako partzuergoa seinaleztapen lipidikoan eta E2F transkripzio-faktoreetan hepatokartzinogenesian.'
      : lang === 'en'
      ? 'Paris. European consortium in lipid signaling and E2F transcription factors in hepatocarcinogenesis.'
      : 'París. Consorcio europeo en señalización lipídica y factores de transcripción E2F en hepatocarcinogénesis.',
    field: lang === 'eu' ? 'Horizon Europe proiektuak' : lang === 'en' ? 'Horizon Europe projects' : 'Proyectos Horizon Europe'
  },
  {
    badge: lang === 'eu' ? 'Elkarte Zientifikoa' : lang === 'en' ? 'Scientific Society' : 'Sociedad Científica',
    name: 'EASL & AEEH',
    desc: lang === 'eu'
      ? 'European Association for the Study of the Liver eta Asociación Española para el Estudio del Hígado.'
      : lang === 'en'
      ? 'European Association for the Study of the Liver and Spanish Association for the Study of the Liver.'
      : 'European Association for the Study of the Liver y Asociación Española para el Estudio del Hígado.',
    field: lang === 'eu' ? 'Batzorde eta gidetan parte-hartzea' : lang === 'en' ? 'Participation in committees and guidelines' : 'Participación en comités y guías'
  }
];
---

<Layout currentPage="home" lang={lang}>
  <!-- Institutional Hero Banner with Dynamic Interactive Network -->
  <section class="institutional-hero" id="hero">
    <!-- Interactive Background Canvas & Ambient Glowing Orbs -->
    <div class="hero-canvas-wrap">
      <canvas id="hero-particles-canvas"></canvas>
    </div>
    <div class="hero-ambient-orb hero-orb-1"></div>
    <div class="hero-ambient-orb hero-orb-2"></div>

    <div class="container hero-grid">
      <div class="hero-content">
        <span class="hero-tag">
          <span class="hero-pulse-badge">
            <span class="hero-pulse-ring"></span>
            <span class="hero-pulse-dot"></span>
          </span>
          <i class="fas fa-award"></i> {t.hero_tag || 'Grupo Consolidado del Gobierno Vasco (IT1560-22)'}
        </span>
        
        <h1 class="hero-headline">
          {t.hero_title}
        </h1>

        <p class="hero-lead">
          {t.hero_subtitle}
        </p>

        <div class="hero-btn-group">
          <a href={getLocalizedPath('/#lines', lang)} class="btn-inst-primary">
            {t.cta_lines} <i class="fas fa-microscope"></i>
          </a>
          <a href={getLocalizedPath('/#team', lang)} class="btn-inst-secondary">
            {t.cta_team} <i class="fas fa-user-friends"></i>
          </a>
        </div>
      </div>

      <div class="hero-banner-img-box">
        <img src="/assets/images/hero_outdoor_group.jpg" alt="Grupo de Investigación Lipids & Liver en Exteriores" />
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid" id="stats-grid">
        {stats.map(stat => (
          <div class="stat-box">
            <div class="stat-val">{stat.number}</div>
            <div class="stat-tit">{stat.label}</div>
            <div class="stat-desc">{stat.subtext}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About / Presentación Section -->
  <section class="page-section" id="about">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.about_title}</h2>
          <span class="section-subtitle-inst">{t.about_subtitle}</span>
        </div>
      </div>

      <div class="about-card">
        <div class="about-tabs" id="about-tabs-group">
          {presentationTabs.map((tab) => (
            <button
              class={`tab-btn ${tab.isActive ? 'active' : ''}`}
              data-tab={tab.entry.data.tabId}
            >
              {tab.entry.data.tabTitle}
            </button>
          ))}
        </div>

        {presentationTabs.map((tab) => {
          const { entry, Content, isActive } = tab;
          const { tabId, specialties, staffCompositionTitle, staffComposition } = entry.data;
          const hasSidebar = (specialties && specialties.length > 0) || (staffComposition && staffComposition.length > 0);

          return (
            <div class={`tab-content ${isActive ? 'active' : ''}`} id={tabId}>
              {tabId === 'tab-colaboraciones' ? (
                <div>
                  <p style="font-size:0.95rem; color:var(--text-secondary); margin-bottom:1.5rem; line-height:1.6;">
                    <span class="badge-new">{t.badge_new}</span> {t.collab_intro}
                  </p>
                  <div class="grid-3">
                    {collaborations.map(collab => (
                      <div class="card" style="display:flex; flex-direction:column;">
                        <span class="badge-tag" style="align-self:flex-start; margin-bottom:0.75rem;">{collab.badge}</span>
                        <h4 style="color:var(--ehu-navy); margin-bottom:0.4rem; font-size:1.05rem;">{collab.name}</h4>
                        <p style="font-size:0.84rem; color:var(--text-muted); margin-bottom:0.75rem; flex-grow:1; line-height:1.5;">
                          {collab.desc}
                        </p>
                        <div style="font-size:0.78rem; font-weight:700; color:var(--logo-green); padding-top:0.5rem; border-top:1px dashed var(--border-light);">
                          {collab.field}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ) : hasSidebar ? (
                <div class="about-grid">
                  <div class="about-text">
                    <Content />
                    {specialties && specialties.length > 0 && (
                      <div class="specialty-list">
                        {specialties.map((spec: string) => (
                          <span class="specialty-chip"><i class="fas fa-check-circle"></i> {spec}</span>
                        ))}
                      </div>
                    )}
                  </div>

                  {staffComposition && staffComposition.length > 0 && (
                    <div style="background:var(--bg-surface-alt); padding:1.5rem; border-radius:var(--radius-md); border:1px solid var(--border-color)">
                      <h4 style="margin-bottom:1rem; color:var(--ehu-navy)">
                        <i class="fas fa-users"></i> {staffCompositionTitle || 'Composición del Personal'}
                      </h4>
                      <ul style="list-style:none; line-height:2">
                        {staffComposition.map((member: { count: string; role: string }) => (
                          <li>
                            <strong style="color:var(--ehu-navy)">{member.count}</strong> {member.role}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              ) : (
                <div class="about-text">
                  <Content />
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Research Lines Section -->
  <section class="page-section page-section-alt" id="lines">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.lines_title}</h2>
          <span class="section-subtitle-inst">{t.lines_subtitle}</span>
        </div>
      </div>

      <div class="research-grid-inst" id="lines-grid">
        {researchLines.map(line => (
          <ResearchCard line={line} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <!-- Funded Research Projects Section (NUEVO) -->
  <section class="page-section" id="projects">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.projects_title} <span class="badge-new">{t.badge_new}</span></h2>
          <span class="section-subtitle-inst">{t.projects_subtitle} &bull; {allProjects.length} {t.projects_filter_all}</span>
        </div>
        <a href={getLocalizedPath('/proyectos', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
          <i class="fas fa-file-invoice-dollar"></i> {t.projects_page_title} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
        </a>
      </div>

      <p style="font-size:1rem; color:var(--text-secondary); max-width:840px; margin-bottom:1.75rem; line-height:1.6;">
        {t.projects_desc}
      </p>

      <div class="filter-bar" id="home-project-filters">
        <button class="filter-btn active" data-filter="all"><i class="fas fa-layer-group"></i> {t.projects_filter_all} ({allProjects.length})</button>
        <button class="filter-btn" data-filter="ue"><i class="fas fa-globe-europe"></i> {t.projects_filter_ue}</button>
        <button class="filter-btn" data-filter="nacional"><i class="fas fa-landmark"></i> {t.projects_filter_nacional}</button>
        <button class="filter-btn" data-filter="gobvasco"><i class="fas fa-flag"></i> {t.projects_filter_gobvasco}</button>
        <button class="filter-btn" data-filter="fundaciones"><i class="fas fa-heart"></i> {t.projects_filter_fundaciones}</button>
      </div>

      <div class="grid-2" id="home-projects-grid">
        {allProjects.map(project => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <!-- Knowledge Transfer & Innovation Section (NUEVO) -->
  <section class="page-section page-section-alt" id="transfer">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.transfer_title} <span class="badge-new">{t.badge_new}</span></h2>
          <span class="section-subtitle-inst">{t.transfer_subtitle}</span>
        </div>
        <a href={getLocalizedPath('/transferencia', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
          <i class="fas fa-lightbulb"></i> {t.transfer_page_title} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
        </a>
      </div>

      <p style="font-size:1rem; color:var(--text-secondary); max-width:840px; margin-bottom:2rem; line-height:1.6;">
        {t.transfer_desc}
      </p>

      <!-- Patentes -->
      <div style="margin-bottom:2.5rem;">
        <h3 style="font-size:1.3rem; color:var(--ehu-navy); margin-bottom:1rem; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-certificate" style="color:var(--logo-green);"></i> {t.transfer_patents_title}
        </h3>
        <div class="grid-2">
          {patents.map(item => (
            <PatentCard item={item} lang={lang} />
          ))}
        </div>
      </div>

      <!-- Servicios a Empresa / OTRI -->
      <div class="card card-highlight" style="margin-top:2rem;">
        <h3 style="color:var(--ehu-navy); font-size:1.15rem; margin-bottom:0.5rem;"><i class="fas fa-handshake"></i> {t.transfer_services_title}</h3>
        <p style="font-size:0.9rem; color:var(--text-secondary); margin-bottom:1rem; line-height:1.5;">
          {t.transfer_services_desc}
        </p>
        <div class="grid-3" style="margin-top:1rem;">
          <div style="background:var(--bg-surface-alt); padding:1rem; border-radius:var(--radius-md); border:1px solid var(--border-light);">
            <div style="font-weight:700; color:var(--ehu-navy); font-size:0.88rem; margin-bottom:0.3rem;"><i class="fas fa-vial" style="color:var(--logo-green); margin-right:4px;"></i> {t.transfer_service1_title}</div>
            <div style="font-size:0.8rem; color:var(--text-muted); line-height:1.5;">{t.transfer_service1_desc}</div>
          </div>
          <div style="background:var(--bg-surface-alt); padding:1rem; border-radius:var(--radius-md); border:1px solid var(--border-light);">
            <div style="font-weight:700; color:var(--ehu-navy); font-size:0.88rem; margin-bottom:0.3rem;"><i class="fas fa-chart-line" style="color:var(--logo-green); margin-right:4px;"></i> {t.transfer_service2_title}</div>
            <div style="font-size:0.8rem; color:var(--text-muted); line-height:1.5;">{t.transfer_service2_desc}</div>
          </div>
          <div style="background:var(--bg-surface-alt); padding:1rem; border-radius:var(--radius-md); border:1px solid var(--border-light);">
            <div style="font-weight:700; color:var(--ehu-navy); font-size:0.88rem; margin-bottom:0.3rem;"><i class="fas fa-stethoscope" style="color:var(--logo-green); margin-right:4px;"></i> {t.transfer_service3_title}</div>
            <div style="font-size:0.8rem; color:var(--text-muted); line-height:1.5;">{t.transfer_service3_desc}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Personnel Section with Images & CV links -->
  <section class="page-section" id="team">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.team_title}</h2>
          <span class="section-subtitle-inst">{t.team_subtitle}</span>
        </div>
        <a href={getLocalizedPath('/curriculum', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
          <i class="fas fa-id-card"></i> {t.nav_cv_portal} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
        </a>
      </div>

      <div class="team-filter-bar" id="team-category-filters">
        <button class="team-filter-btn active" data-category="ALL"><i class="fas fa-users"></i> {t.team_all}</button>
        <button class="team-filter-btn" data-category="PDI"><i class="fas fa-user-tie"></i> {t.team_pdi}</button>
        <button class="team-filter-btn" data-category="Posdoctoral"><i class="fas fa-user-graduate"></i> {t.team_postdoc}</button>
        <button class="team-filter-btn" data-category="Predoctoral"><i class="fas fa-book-reader"></i> {t.team_predoc}</button>
        <button class="team-filter-btn" data-category="Técnico"><i class="fas fa-tools"></i> {t.team_tech}</button>
      </div>


      <div class="team-grid-inst" id="team-grid">
        {teamMembers.map(member => (
          <TeamCard member={member} lang={lang} />
        ))}
      </div>

      <!-- Subsección Alumni (NUEVO) -->
      <div id="alumni" style="margin-top:3.5rem; padding-top:2.5rem; border-top:1px solid var(--border-color);">
        <div class="section-header-inst" style="margin-bottom:1.5rem;">
          <div>
            <h3 style="font-size:1.5rem; color:var(--ehu-navy); margin-bottom:0.3rem;">
              <i class="fas fa-user-graduate" style="color:var(--logo-green); margin-right:6px;"></i> {t.alumni_title} <span class="badge-new">{t.badge_new}</span>
            </h3>
            <span class="section-subtitle-inst">{t.alumni_subtitle}</span>
          </div>
        </div>
        <p style="font-size:0.95rem; color:var(--text-secondary); max-width:800px; margin-bottom:1.5rem;">
          {t.alumni_desc}
        </p>
        <div class="grid-4">
          {allAlumni.map(alumniItem => (
            <AlumniCard alumni={alumniItem} lang={lang} />
          ))}
        </div>
      </div>

      <!-- Subsección Oportunidades / Trabaja con Nosotros (NUEVO) -->
      <div id="opportunities" style="margin-top:3.5rem; padding-top:2.5rem; border-top:1px solid var(--border-color);">
        <div class="section-header-inst" style="margin-bottom:1.5rem;">
          <div>
            <h3 style="font-size:1.5rem; color:var(--ehu-navy); margin-bottom:0.3rem;">
              <i class="fas fa-briefcase" style="color:var(--logo-green); margin-right:6px;"></i> {t.opportunities_title} <span class="badge-new">{t.badge_new}</span>
            </h3>
            <span class="section-subtitle-inst">{t.opportunities_subtitle}</span>
          </div>
          <a href={getLocalizedPath('/oportunidades', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
            <i class="fas fa-paper-plane"></i> {t.opportunities_page_title} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
          </a>
        </div>
        <p style="font-size:0.95rem; color:var(--text-secondary); max-width:800px; margin-bottom:1.5rem;">
          {t.opportunities_desc}
        </p>
        <div class="grid-3" style="margin-bottom:2rem;">
          {allOpportunities.map(opp => (
            <OpportunityCard opp={opp} lang={lang} />
          ))}
        </div>

        <div style="background:var(--bg-surface-alt); border:1px solid var(--border-color); border-radius:var(--radius-md); padding:1.25rem 1.75rem; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
          <div>
            <div style="font-weight:700; color:var(--ehu-navy); font-size:0.95rem; margin-bottom:0.25rem;">
              <i class="fas fa-info-circle" style="color:var(--logo-green);"></i> {t.opportunities_spontaneous_title}
            </div>
            <div style="font-size:0.85rem; color:var(--text-secondary);">
              {t.opportunities_spontaneous_desc}
            </div>
          </div>
