---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getLocalizedEntry, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import stats from '../../data/stats.json';
import leadership from '../../data/leadership.json';
import heroGallery from '../../data/hero_gallery.json';
import ResearchCard from '../cards/ResearchCard.astro';
import NewsCard from '../cards/NewsCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Home Resumen: Hero + métricas, extracto de la carta de la IP, líneas, actualidad y franja de contacto.
// El contenido completo de cada bloque vive en su propia página (/grupo, /lineas, /noticias, /contacto).

const letterEntry = await getLocalizedEntry('letter', 'carta', lang);
// Extracto: primer párrafo del cuerpo de la carta, sin marcas de Markdown
const letterExcerpt = (letterEntry?.body || '')
  .trim()
  .split(/\n\s*\n/)[0]
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/[*_`]/g, '')
  .trim();

const researchLines = await getLocalizedCollection('research', lang);
researchLines.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allNews = await getLocalizedCollection('news', lang);
allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestNews = allNews.slice(0, 3);

const rawStats = (stats as any).stats || stats;
const statsList: any[] = Array.isArray(rawStats) ? rawStats : [];
const contactEmail = leadership.coordinator.email;
const rawSlides = (heroGallery as any).slides || heroGallery;
const heroSlides: any[] = (Array.isArray(rawSlides) ? rawSlides : []).filter((s: any) => s && s.image);
---

<Layout currentPage="home" lang={lang}>
  <!-- 1. Institutional Hero Banner with Dynamic Interactive Network -->
  <section class="institutional-hero" id="hero">
    <!-- Interactive Background Canvas & Ambient Glowing Orbs -->
    <div class="hero-canvas-wrap">
      <canvas id="hero-particles-canvas"></canvas>
    </div>
    <div class="hero-ambient-orb hero-orb-1"></div>
    <div class="hero-ambient-orb hero-orb-2"></div>

    <div class="container hero-grid">
      <div class="hero-content">
        <span class="hero-tag">
          <span class="hero-pulse-badge">
            <span class="hero-pulse-ring"></span>
            <span class="hero-pulse-dot"></span>
          </span>
          <i class="fas fa-award"></i> {t.hero_tag || 'Grupo Consolidado del Gobierno Vasco (IT1560-22)'}
        </span>

        <h1 class="hero-headline">
          {t.hero_title}
        </h1>

        <p class="hero-lead">
          {t.hero_subtitle}
        </p>

        <div class="hero-btn-group">
          <a href={getLocalizedPath('/lineas', lang)} class="btn-inst-primary">
            {t.cta_lines} <i class="fas fa-microscope"></i>
          </a>
          <a href={getLocalizedPath('/curriculum', lang)} class="btn-inst-secondary">
            {t.cta_team} <i class="fas fa-user-friends"></i>
          </a>
        </div>
      </div>

      <!-- Galería de fotos del grupo (datos en src/data/hero_gallery.json, editable desde el CMS) -->
      <div
        class="hero-banner-img-box hero-gallery"
        id="hero-gallery"
        role="region"
        aria-roledescription="carousel"
        aria-label={t.hero_gallery_label}
      >
        <div class="hero-gallery-track" aria-live="off">
          {heroSlides.map((slide: any, i: number) => (
            <figure
              class={`hero-gallery-slide ${i === 0 ? 'is-active' : ''}`}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} ${t.hero_gallery_of} ${heroSlides.length}`}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <!-- Solo la primera se descarga al cargar; el resto bajo demanda (data-src) -->
              <img
                src={i === 0 ? slide.image : undefined}
                data-src={i === 0 ? undefined : slide.image}
                alt={slide[`alt_${lang}`] || slide.alt_es}
                decoding="async"
              />
            </figure>
          ))}
        </div>

        {heroSlides.length > 1 && (
          <>
            <button type="button" class="hero-gallery-btn hero-gallery-prev" aria-label={t.hero_gallery_prev}>
              <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </button>
            <button type="button" class="hero-gallery-btn hero-gallery-next" aria-label={t.hero_gallery_next}>
              <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </button>
            <div class="hero-gallery-dots">
              {heroSlides.map((_: any, i: number) => (
                <button
                  type="button"
                  class={`hero-gallery-dot ${i === 0 ? 'is-active' : ''}`}
                  aria-label={`${t.hero_gallery_goto} ${i + 1}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                  data-index={i}
                ></button>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-grid" id="stats-grid" style={`--stats-cols: ${statsList.length || 3};`}>
        {statsList.map((stat: any) => {
          const label = stat[`label_${lang}`] || stat.label_es || stat.label;
          const subtext = stat[`subtext_${lang}`] || stat.subtext_es || stat.subtext;
          return (
            <div class="stat-box">
              <div class="stat-val">{stat.number}</div>
              <div class="stat-tit">{label}</div>
              <div class="stat-desc">{subtext}</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 2. Extracto de la Carta de la Investigadora Principal -->
  <section class="page-section" id="about">
    <div class="container">
      <article class="about-pi-card home-letter-teaser">
        <img
          src={letterEntry?.data.piImage || "/assets/images/team/patricia-aspichueta/image.jpg"}
          alt={letterEntry?.data.piName || t.about_letter_sign_name}
          class="home-letter-photo"
          loading="lazy"
        />
        <div class="home-letter-text">
          <div class="about-letter-kicker">
            <span class="about-letter-dot"></span>
            {letterEntry?.data.badge || t.about_letter_badge}
          </div>
          <h2 class="about-letter-heading">{letterEntry?.data.title || t.about_letter_title}</h2>
          <p class="home-letter-excerpt">{letterExcerpt || t.about_letter_p1}</p>
          <div class="home-letter-footer">
            <div>
              <div class="about-letter-sign-name">{letterEntry?.data.piName || t.about_letter_sign_name}</div>
              <div class="about-letter-sign-meta">{letterEntry?.data.piRole || t.about_letter_sign_role}</div>
            </div>
            <a href={getLocalizedPath('/grupo#carta', lang)} class="home-letter-link">
              {t.home_letter_more} <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- 3. Líneas de Investigación -->
  <section class="page-section page-section-alt" id="lines">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.lines_title}</h2>
          <span class="section-subtitle-inst">{t.lines_subtitle}</span>
        </div>
        <a href={getLocalizedPath('/lineas', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
          <i class="fas fa-microscope"></i> {t.home_lines_more} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
        </a>
      </div>

      <div class="research-grid-inst" id="lines-grid">
        {researchLines.map(line => (
          <ResearchCard line={line} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Actualidad: últimas noticias -->
  <section class="page-section" id="news">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.home_news_title}</h2>
          <span class="section-subtitle-inst">{t.home_news_subtitle}</span>
        </div>
        <a href={getLocalizedPath('/noticias', lang)} class="btn-inst-primary" style="font-size:0.85rem; padding:8px 18px; border-radius:30px;">
          <i class="fas fa-newspaper"></i> {t.news_view_all} <i class="fas fa-arrow-right" style="margin-left:4px;"></i>
        </a>
      </div>

      {latestNews.length > 0 && (
        <div class="news-bento-bottom" id="featured-news-grid">
          {latestNews.map(article => (
            <NewsCard article={article} lang={lang} variant="standard" />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Franja final: Contacto y Únete -->
  <section class="home-cta-band" id="contact">
    <div class="container home-cta-inner">
      <div>
        <h2 class="home-cta-title">{t.home_cta_title}</h2>
        <p class="home-cta-text">{t.home_cta_text}</p>
      </div>
      <div class="home-cta-actions">
        <a href={`mailto:${contactEmail}`} class="btn-inst-primary">
          <i class="fas fa-paper-plane"></i> {t.contact_write_btn}
        </a>
        <a href={getLocalizedPath('/unete', lang)} class="btn-inst-secondary">
          <i class="fas fa-user-plus"></i> {t.nav_join}
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Client-side Logic: Hero particle network -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Hero Photo Gallery: fade carousel with arrows, dots, keyboard, swipe and autoplay
      const gallery = document.getElementById('hero-gallery');
      const slides = gallery ? Array.from(gallery.querySelectorAll('.hero-gallery-slide')) : [];

      if (gallery && slides.length > 1) {
        const dots = Array.from(gallery.querySelectorAll('.hero-gallery-dot'));
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const AUTOPLAY_MS = 6000;
        let current = 0;
        let timer = null;
        let paused = false;

        const loadSlide = (index) => {
          const img = slides[index % slides.length].querySelector('img');
          if (img && img.dataset.src) {
            img.src = img.dataset.src;
            delete img.dataset.src;
          }
        };

        const goTo = (index) => {
          current = (index + slides.length) % slides.length;
          slides.forEach((slide, i) => {
            const active = i === current;
            slide.classList.toggle('is-active', active);
            slide.setAttribute('aria-hidden', active ? 'false' : 'true');
          });
          dots.forEach((dot, i) => {
            dot.classList.toggle('is-active', i === current);
            dot.setAttribute('aria-current', i === current ? 'true' : 'false');
          });
          // Carga la imagen actual y precarga la siguiente para que el fundido no muestre un hueco
          loadSlide(current);
          loadSlide(current + 1);
        };

        const stop = () => { clearInterval(timer); timer = null; };
        const start = () => {
          stop();
          if (!reduceMotion && !paused && !document.hidden) {
            timer = setInterval(() => goTo(current + 1), AUTOPLAY_MS);
          }
        };
        // Navegación manual: reinicia el temporizador
        const navigate = (index) => { goTo(index); start(); };

        gallery.querySelector('.hero-gallery-prev').addEventListener('click', () => navigate(current - 1));
        gallery.querySelector('.hero-gallery-next').addEventListener('click', () => navigate(current + 1));
        dots.forEach((dot) => dot.addEventListener('click', () => navigate(Number(dot.dataset.index))));

        gallery.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') { e.preventDefault(); navigate(current - 1); }
          if (e.key === 'ArrowRight') { e.preventDefault(); navigate(current + 1); }
        });

        // Pausa mientras el usuario interactúa con la galería
        const pause = () => { paused = true; stop(); };
        const resume = () => { paused = false; start(); };
        gallery.addEventListener('mouseenter', pause);
        gallery.addEventListener('mouseleave', resume);
        gallery.addEventListener('focusin', pause);
        gallery.addEventListener('focusout', (e) => { if (!gallery.contains(e.relatedTarget)) resume(); });
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

        // Deslizar con el dedo en móvil
        let touchX = null;
        gallery.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
        gallery.addEventListener('touchend', (e) => {
          if (touchX === null) return;
          const dx = e.changedTouches[0].clientX - touchX;
          if (Math.abs(dx) > 40) navigate(dx < 0 ? current + 1 : current - 1);
          touchX = null;
        }, { passive: true });

        goTo(0);
        start();
      }

      // Hero Interactive Dynamic Effects
      // A. Dynamic Molecular/Lipid Particle Network Simulation
      const heroSection = document.getElementById('hero');
      const heroCanvas = document.getElementById('hero-particles-canvas');

      if (heroCanvas && heroSection) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        if (!prefersReducedMotion) {
          const ctx = heroCanvas.getContext('2d');
          let width = (heroCanvas.width = heroSection.offsetWidth);
          let height = (heroCanvas.height = heroSection.offsetHeight);

          let particles = [];
          const particleCount = Math.min(Math.floor((width * height) / 18000), 55);
          const mouse = { x: -1000, y: -1000, active: false };

          class Particle {
            constructor() {
              this.reset(true);
            }
            reset(initial = false) {
              this.x = initial ? Math.random() * width : (Math.random() > 0.5 ? 0 : width);
              this.y = initial ? Math.random() * height : Math.random() * height;
              this.vx = (Math.random() - 0.5) * 0.55;
              this.vy = (Math.random() - 0.5) * 0.55;
              this.radius = Math.random() * 2.8 + 1.2;
              this.baseRadius = this.radius;
              this.alpha = Math.random() * 0.45 + 0.2;
              const isCyan = Math.random() > 0.55;
              this.color = isCyan ? '56, 189, 248' : '138, 198, 63';
              this.pulseAngle = Math.random() * Math.PI * 2;
              this.pulseSpeed = 0.02 + Math.random() * 0.02;
            }
            update() {
              this.pulseAngle += this.pulseSpeed;
              this.radius = this.baseRadius + Math.sin(this.pulseAngle) * 0.6;

              this.x += this.vx;
              this.y += this.vy;

              if (mouse.active) {
                const dx = mouse.x - this.x;
                const dy = mouse.y - this.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < 130) {
                  const force = (130 - dist) / 130;
                  this.x -= (dx / dist) * force * 1.5;
                  this.y -= (dy / dist) * force * 1.5;
                }
              }

              if (this.x < -20) this.x = width + 20;
              if (this.x > width + 20) this.x = -20;
              if (this.y < -20) this.y = height + 20;
              if (this.y > height + 20) this.y = -20;
            }
            draw() {
              ctx.beginPath();
              ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(${this.color}, ${this.alpha})`;
              ctx.shadowColor = `rgba(${this.color}, 0.5)`;
              ctx.shadowBlur = 6;
              ctx.fill();
              ctx.shadowBlur = 0;
            }
          }

          for (let i = 0; i < particleCount; i++) {
            particles.push(new Particle());
          }

          let isHeroVisible = true;
          let animId = null;

          function animate() {
            if (!isHeroVisible) return;
            ctx.clearRect(0, 0, width, height);

            for (let i = 0; i < particles.length; i++) {
              const p1 = particles[i];
              p1.update();
              p1.draw();

              for (let j = i + 1; j < particles.length; j++) {
                const p2 = particles[j];
                const dx = p1.x - p2.x;
                const dy = p1.y - p2.y;
                const dist = Math.sqrt(dx * dx + dy * dy);

                if (dist < 110) {
                  const connAlpha = (1 - dist / 110) * 0.18;
                  ctx.beginPath();
                  ctx.moveTo(p1.x, p1.y);
                  ctx.lineTo(p2.x, p2.y);
                  ctx.strokeStyle = `rgba(138, 198, 63, ${connAlpha})`;
                  ctx.lineWidth = 1;
                  ctx.stroke();
                }
              }

              if (mouse.active) {
                const mdx = p1.x - mouse.x;
                const mdy = p1.y - mouse.y;
                const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
                if (mdist < 140) {
                  const mAlpha = (1 - mdist / 140) * 0.35;
                  ctx.beginPath();
                  ctx.moveTo(p1.x, p1.y);
                  ctx.lineTo(mouse.x, mouse.y);
                  ctx.strokeStyle = `rgba(56, 189, 248, ${mAlpha})`;
                  ctx.lineWidth = 1.2;
                  ctx.stroke();
                }
              }
            }

            animId = requestAnimationFrame(animate);
          }

          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              isHeroVisible = entry.isIntersecting;
              if (isHeroVisible && !animId) {
                animate();
              } else if (!isHeroVisible && animId) {
                cancelAnimationFrame(animId);
                animId = null;
              }
            });
          }, { threshold: 0.1 });
          observer.observe(heroSection);

          window.addEventListener('resize', () => {
            width = heroCanvas.width = heroSection.offsetWidth;
            height = heroCanvas.height = heroSection.offsetHeight;
          }, { passive: true });

          heroSection.addEventListener('mousemove', (e) => {
            const rect = heroSection.getBoundingClientRect();
            mouse.x = e.clientX - rect.left;
            mouse.y = e.clientY - rect.top;
            mouse.active = true;
          });

          heroSection.addEventListener('mouseleave', () => {
            mouse.active = false;
            mouse.x = -1000;
            mouse.y = -1000;
          });

          animate();
        }
      }
    });
  </script>
</Layout>
