          <div class="info-item">
            <div class="info-icon"><i class="fas fa-user-check"></i></div>
            <div class="info-text">
              <h4>{t.contact_coord}</h4>
              <p>Dra. Patricia Aspichueta Celaá<br />Catedrática de Fisiología (UPV/EHU)</p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fas fa-envelope"></i></div>
            <div class="info-text">
              <h4>{t.contact_email_title}</h4>
              <p>patricia.aspichueta@ehu.eus</p>
            </div>
          </div>
        </div>

        <div class="contact-info-card">
          <h3 style="margin-bottom:1.5rem; font-size:1.3rem; color:var(--ehu-navy)">{t.contact_form_title}</h3>
          
          <form class="contact-form" id="contact-form">
