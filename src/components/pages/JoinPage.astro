---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Layout currentPage="join" lang={lang} title={`${t.join_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-user-plus"></i> {t.join_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Hero Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-graduation-cap"></i> Captación de Talento Investigador
        </span>
        <h1 class="catalog-title">{t.join_page_title}</h1>
        <p class="catalog-subtitle">{t.join_page_sub}</p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="page-section">
    <div class="container">
      <!-- Intro Cards -->
      <div class="about-grid" style="margin-bottom: 3.5rem;">
        <div class="about-text">
          <h2 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.6rem;">
            Desarrolla tu Pasión por la Biomedicina y el Metabolismo
          </h2>
          <p style="font-size:1.05rem; line-height:1.75; color:var(--text-secondary); margin-bottom:1.25rem;">
            En el Grupo <strong>Lipids & Liver</strong> buscamos continuamente estudiantes e investigadoras/es motivados y con vocación científica para incorporarse a nuestros proyectos pioneros en <strong>esteatohepatitis metabólica (MASH)</strong>, <strong>cáncer de hígado</strong> y <strong>lipidómica traslacional</strong>.
          </p>
          <p style="font-size:1rem; line-height:1.7; color:var(--text-secondary);">
            Ofrecemos un entorno formativo de máxima exigencia científica pero sumamente colaborativo y humano, con instalaciones ubicadas en la <strong>Facultad de Medicina y Enfermería de la UPV/EHU</strong> (Campus de Leioa) y en el <strong>IIS Biocruces Bizkaia</strong>.
          </p>
        </div>

        <div style="background:var(--bg-surface-alt); padding:2rem; border-radius:var(--radius-md); border:1px solid var(--border-color);">
          <h4 style="color:var(--ehu-navy); margin-bottom:1.25rem; font-size:1.15rem;">
            <i class="fas fa-star" style="color:var(--logo-green);"></i> Lo que te ofrecemos:
          </h4>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:12px; font-size:0.95rem; color:var(--text-secondary);">
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> Dirección y tutorización científica personalizada y continua.</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> Aprendizaje práctico de técnicas de vanguardia (lipidómica, transcriptómica espacial, modelos preclínicos).</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> Publicaciones en revistas internacionales de alto factor de impacto (Q1/D1).</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> Apoyo integral en la preparación de solicitudes para becas oficiales (FPU, FPI, Gobierno Vasco, MSCA).</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> Posibilidad de estancias formativas en centros punteros internacionales.</li>
          </ul>
        </div>
      </div>

      <!-- Opportunities Tracks Grid -->
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">Vías de Incorporación al Laboratorio</h2>
          <span class="section-subtitle-inst">Selecciona la modalidad acorde a tu etapa académica</span>
        </div>
      </div>

      <div class="research-grid-inst" style="margin-bottom:3.5rem;">
        <!-- TFG -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#e0f2fe; color:#0369a1;"><i class="fas fa-book-reader"></i> Grado</span>
              <h3 class="research-card-title">Trabajos de Fin de Grado (TFG)</h3>
            </div>
            <p class="research-card-desc">
              Dirigido a alumnado de los Grados en Medicina, Bioquímica y Biología Molecular, Biología, Biotecnología y Farmacia (UPV/EHU). Proyectos experimentales en cultivos primarios y técnicas de biología molecular.
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">Perfil:</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> Alto interés en la investigación biomédica y buen expediente académico.</span>
            </div>
          </div>
        </div>

        <!-- TFM -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#fef3c7; color:#92400e;"><i class="fas fa-user-graduate"></i> Máster</span>
              <h3 class="research-card-title">Trabajos de Fin de Máster (TFM)</h3>
            </div>
            <p class="research-card-desc">
              Proyectos de investigación avanzada en el Máster Universitario en Biomedicina, Biología Molecular o afines. Trabajo experimental tutelado con vistas a enlazar con una futura tesis doctoral.
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">Perfil:</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> Experiencia previa de laboratorio y motivación para cursar el doctorado.</span>
            </div>
          </div>
        </div>

        <!-- PhD -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#dcfce7; color:#166534;"><i class="fas fa-graduation-cap"></i> Doctorado</span>
              <h3 class="research-card-title">Tesis Doctoral (Predoctoral)</h3>
            </div>
            <p class="research-card-desc">
              Contratos predoctorales competitivos asociados a proyectos activos (FPU, FPI, Convocatoria Predoctoral del Gobierno Vasco). Formación integral hacia el título de Doctor con Mención Internacional.
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">Convocatorias:</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> Gobierno Vasco (mayo/junio) • FPU/FPI (noviembre/diciembre).</span>
            </div>
          </div>
        </div>

        <!-- Postdoc -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#f3e8ff; color:#6b21a8;"><i class="fas fa-microscope"></i> Posdoctoral</span>
              <h3 class="research-card-title">Investigación Posdoctoral</h3>
            </div>
            <p class="research-card-desc">
              Acogemos candidaturas excelentes para convocatorias competitivas: Juan de la Cierva, Margarita Salas, Marie Skłodowska-Curie Actions (MSCA Postdoctoral Fellowships) o contratos con cargo a proyectos.
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">Perfil:</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> Tesis leída, publicaciones de primer nivel en metabolismo/oncología y autonomía analítica.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Application Steps -->
      <div style="background:var(--bg-surface-alt); padding:2.5rem; border-radius:var(--radius-lg); border:1px solid var(--border-color); margin-bottom:3rem;">
        <h3 style="color:var(--ehu-navy); font-size:1.35rem; margin-bottom:1.5rem;">
          <i class="fas fa-paper-plane" style="color:var(--logo-green);"></i> ¿Cómo postular al grupo?
        </h3>
        <p style="color:var(--text-secondary); line-height:1.7; margin-bottom:1.5rem;">
          Si estás interesada/o en realizar tu TFG, TFM, tesis doctoral o estancia posdoctoral con nosotros, envíanos la siguiente documentación a la dirección de la coordinadora del grupo:
        </p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem; margin-bottom:2rem;">
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--ehu-navy);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">1. Currículum Vitae</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">Detallando formación, notas medias y experiencia de laboratorio previa.</span>
          </div>
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--logo-green);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">2. Carta de Motivación</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">Explicando por qué te atraen nuestras líneas y qué objetivos tienes (máx. 1 página).</span>
          </div>
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--ehu-navy-light);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">3. Expediente Académico</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">Copia del expediente con notas oficiales del Grado y Máster (si aplica).</span>
          </div>
        </div>

        <div style="text-align:center;">
          <a href="mailto:patricia.aspichueta@ehu.eus?subject=Candidatura%20Lipids%20%26%20Liver" class="btn-inst-primary" style="display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-envelope"></i> Enviar Candidatura a Dra. Patricia Aspichueta
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
