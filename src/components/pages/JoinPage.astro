---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Layout currentPage="join" lang={lang} title={`${t.join_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-user-plus"></i> {t.join_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Hero Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-graduation-cap"></i> {t.join_badge}
        </span>
        <h1 class="catalog-title">{t.join_page_title}</h1>
        <p class="catalog-subtitle">{t.join_page_sub}</p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="page-section">
    <div class="container">
      <!-- Intro Cards -->
      <div class="about-grid" style="margin-bottom: 3.5rem;">
        <div class="about-text">
          <h2 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.6rem;">
            {t.join_intro_title}
          </h2>
          <p style="font-size:1.05rem; line-height:1.75; color:var(--text-secondary); margin-bottom:1.25rem;">
            <Fragment set:html={t.join_intro_p1} />
          </p>
          <p style="font-size:1rem; line-height:1.7; color:var(--text-secondary);">
            <Fragment set:html={t.join_intro_p2} />
          </p>
        </div>

        <div style="background:var(--bg-surface-alt); padding:2rem; border-radius:var(--radius-md); border:1px solid var(--border-color);">
          <h4 style="color:var(--ehu-navy); margin-bottom:1.25rem; font-size:1.15rem;">
            <i class="fas fa-star" style="color:var(--logo-green);"></i> {t.join_offer_title}
          </h4>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:12px; font-size:0.95rem; color:var(--text-secondary);">
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_1}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_2}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_3}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_4}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_5}</li>
          </ul>
        </div>
      </div>

      <!-- Opportunities Tracks Grid -->
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.join_tracks_title}</h2>
          <span class="section-subtitle-inst">{t.join_tracks_sub}</span>
        </div>
      </div>

      <div class="research-grid-inst" style="margin-bottom:3.5rem;">
        <!-- TFG -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#e0f2fe; color:#0369a1;"><i class="fas fa-book-reader"></i> {t.join_tfg_badge}</span>
              <h3 class="research-card-title">{t.join_tfg_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_tfg_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_profile_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_tfg_profile}</span>
            </div>
          </div>
        </div>

        <!-- TFM -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#fef3c7; color:#92400e;"><i class="fas fa-user-graduate"></i> {t.join_tfm_badge}</span>
              <h3 class="research-card-title">{t.join_tfm_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_tfm_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_profile_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_tfm_profile}</span>
            </div>
          </div>
        </div>

        <!-- PhD -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#dcfce7; color:#166534;"><i class="fas fa-graduation-cap"></i> {t.join_phd_badge}</span>
              <h3 class="research-card-title">{t.join_phd_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_phd_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_calls_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_phd_calls}</span>
            </div>
          </div>
        </div>

        <!-- Postdoc -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#f3e8ff; color:#6b21a8;"><i class="fas fa-microscope"></i> {t.join_postdoc_badge}</span>
              <h3 class="research-card-title">{t.join_postdoc_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_postdoc_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_profile_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_postdoc_profile}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Application Steps -->
      <div style="background:var(--bg-surface-alt); padding:2.5rem; border-radius:var(--radius-lg); border:1px solid var(--border-color); margin-bottom:3rem;">
        <h3 style="color:var(--ehu-navy); font-size:1.35rem; margin-bottom:1.5rem;">
          <i class="fas fa-paper-plane" style="color:var(--logo-green);"></i> {t.join_apply_title}
        </h3>
        <p style="color:var(--text-secondary); line-height:1.7; margin-bottom:1.5rem;">
          {t.join_apply_intro}
        </p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.5rem; margin-bottom:2rem;">
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--ehu-navy);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">{t.join_doc1_title}</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">{t.join_doc1_desc}</span>
          </div>
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--logo-green);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">{t.join_doc2_title}</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">{t.join_doc2_desc}</span>
          </div>
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--ehu-navy-light);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">{t.join_doc3_title}</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">{t.join_doc3_desc}</span>
          </div>
        </div>

        <div style="text-align:center;">
          <a href="mailto:patricia.aspichueta@ehu.eus?subject=Candidatura%20Lipids%20%26%20Liver" class="btn-inst-primary" style="display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-envelope"></i> {t.join_apply_btn}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
