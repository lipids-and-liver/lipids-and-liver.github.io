---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import joinGallery from '../../data/join_gallery.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Fotos del día a día (src/data/join_gallery.json, editable desde el CMS)
type Credit = { author: string; license: string; licenseUrl?: string; source?: string };
const photos = joinGallery.photos.map(p => ({ ...p, credit: (p as { credit?: Credit }).credit, caption: (p as Record<string, any>)[`caption_${lang}`] || p.caption_es }));
---

<Layout currentPage="join" lang={lang} title={`${t.join_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-user-plus"></i> {t.join_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Hero Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-graduation-cap"></i> {t.join_badge}
        </span>
        <h1 class="catalog-title">{t.join_page_title}</h1>
        <p class="catalog-subtitle">{t.join_page_sub}</p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="page-section">
    <div class="container">
      <!-- Intro Cards -->
      <div class="about-grid" style="margin-bottom: 3.5rem;">
        <div class="about-text">
          <h2 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.6rem;">
            {t.join_intro_title}
          </h2>
          <p style="font-size:1.05rem; line-height:1.75; color:var(--text-secondary); margin-bottom:1.25rem;">
            <Fragment set:html={t.join_intro_p1} />
          </p>
          <p style="font-size:1rem; line-height:1.7; color:var(--text-secondary);">
            <Fragment set:html={t.join_intro_p2} />
          </p>
        </div>

        <div class="join-intro-side">
        <img src="/assets/images/join/grupo-exterior.jpg" alt={t.join_photo_alt} class="join-intro-photo" width="1600" height="1200" loading="lazy" decoding="async" />
        <div style="background:var(--bg-surface-alt); padding:2rem; border-radius:var(--radius-md); border:1px solid var(--border-color);">
          <h4 style="color:var(--ehu-navy); margin-bottom:1.25rem; font-size:1.15rem;">
            <i class="fas fa-star" style="color:var(--logo-green);"></i> {t.join_offer_title}
          </h4>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:12px; font-size:0.95rem; color:var(--text-secondary);">
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_1}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_2}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_3}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_4}</li>
            <li><i class="fas fa-check-circle" style="color:var(--logo-green); margin-right:8px;"></i> {t.join_offer_5}</li>
          </ul>
        </div>
        </div>
      </div>

      <!-- El día a día en el laboratorio -->
      {photos.length > 0 && (
        <>
          <div class="section-header-inst">
            <div>
              <h2 class="section-title-inst">{t.join_life_title}</h2>
              <span class="section-subtitle-inst">{t.join_life_sub}</span>
            </div>
          </div>
          <div class="join-life-wrap">
            <div class="join-life-grid">
              {photos.map(p => (
                <figure class="join-life-item">
                  <img src={p.image} alt="" width="1320" height="600" loading="lazy" decoding="async" />
                  <figcaption>{p.caption}</figcaption>
                  {p.credit?.author && (
                    <small class="join-life-credit">
                      <i class="fas fa-camera" aria-hidden="true"></i> {t.hero_photo_credit}:{' '}
                      {p.credit.source
                        ? <a href={p.credit.source} target="_blank" rel="noopener noreferrer">{p.credit.author}</a>
                        : p.credit.author}
                    </small>
                  )}
                </figure>
              ))}
            </div>
          </div>
        </>
      )}

      <!-- Opportunities Tracks Grid -->
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">{t.join_tracks_title}</h2>
          <span class="section-subtitle-inst">{t.join_tracks_sub}</span>
        </div>
      </div>

      <div class="research-grid-inst" style="margin-bottom:3.5rem;">
        <!-- Postdoc -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#f3e8ff; color:#6b21a8;"><i class="fas fa-microscope"></i> {t.join_postdoc_badge}</span>
              <h3 class="research-card-title">{t.join_postdoc_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_postdoc_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_profile_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_postdoc_profile}</span>
            </div>
          </div>
        </div>

        <!-- PhD -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#dcfce7; color:#166534;"><i class="fas fa-graduation-cap"></i> {t.join_phd_badge}</span>
              <h3 class="research-card-title">{t.join_phd_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_phd_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_calls_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_phd_calls}</span>
            </div>
          </div>
        </div>

        <!-- TFM -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#fef3c7; color:#92400e;"><i class="fas fa-user-graduate"></i> {t.join_tfm_badge}</span>
              <h3 class="research-card-title">{t.join_tfm_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_tfm_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_profile_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_tfm_profile}</span>
            </div>
          </div>
        </div>

        <!-- TFG -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#e0f2fe; color:#0369a1;"><i class="fas fa-book-reader"></i> {t.join_tfg_badge}</span>
              <h3 class="research-card-title">{t.join_tfg_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_tfg_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_profile_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_tfg_profile}</span>
            </div>
          </div>
        </div>

        <!-- Alumnado interno -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#ccfbf1; color:#115e59;"><i class="fas fa-user-plus"></i> {t.join_tfg_badge}</span>
              <h3 class="research-card-title">{t.join_intern_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_intern_desc}
            </p>
            <div style="margin-top:1.25rem; font-size:0.85rem; line-height:1.55;">
              <span style="font-weight:700; color:var(--ehu-navy);">{t.join_intern_credits_label}</span>
              <span style="color:var(--text-secondary);"> {t.join_intern_credits}</span>
            </div>
            <div style="margin-top:0.85rem; font-size:0.85rem; line-height:1.55;">
              <span style="font-weight:700; color:var(--ehu-navy);">{t.join_intern_funding_label}</span>
              <ul style="margin:0.4rem 0 0; padding-left:1.1rem; color:var(--text-secondary);">
                <li style="margin-bottom:0.35rem;"><Fragment set:html={t.join_intern_ikasiker} /></li>
                <li><Fragment set:html={t.join_intern_aecc} /></li>
              </ul>
              <p style="margin:0.6rem 0 0; font-size:0.8rem; color:var(--text-muted); font-style:italic;">{t.join_intern_calls_note}</p>
            </div>
          </div>
        </div>

        <!-- Prácticas de FP (FCT) -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#e0e7ff; color:#3730a3;"><i class="fas fa-tools"></i> {t.join_fp_badge}</span>
              <h3 class="research-card-title">{t.join_fp_title}</h3>
            </div>
            <p class="research-card-desc">
              {t.join_fp_desc}
            </p>
            <div style="margin-top:1.25rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_fp_cycles_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_fp_cycles}</span>
            </div>
            <div style="margin-top:0.85rem;">
              <span style="font-size:0.85rem; font-weight:700; color:var(--ehu-navy);">{t.join_fp_how_label}</span>
              <span style="font-size:0.85rem; color:var(--text-secondary);"> {t.join_fp_how}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Application Steps -->
      <div style="background:var(--bg-surface-alt); padding:2.5rem; border-radius:var(--radius-lg); border:1px solid var(--border-color); margin-bottom:3rem;">
        <h3 style="color:var(--ehu-navy); font-size:1.35rem; margin-bottom:1.5rem;">
          <i class="fas fa-paper-plane" style="color:var(--logo-green);"></i> {t.join_apply_title}
        </h3>
        <p style="color:var(--text-secondary); line-height:1.7; margin-bottom:1.5rem;">
          {t.join_apply_intro}
        </p>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap:1.5rem; margin-bottom:2rem;">
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--ehu-navy);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">{t.join_doc1_title}</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">{t.join_doc1_desc}</span>
          </div>
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--logo-green);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">{t.join_doc2_title}</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">{t.join_doc2_desc}</span>
          </div>
          <div style="background:var(--bg-surface); padding:1.25rem; border-radius:var(--radius-md); border-left:4px solid var(--ehu-navy-light);">
            <strong style="color:var(--ehu-navy); display:block; margin-bottom:0.5rem;">{t.join_doc3_title}</strong>
            <span style="font-size:0.9rem; color:var(--text-secondary);">{t.join_doc3_desc}</span>
          </div>
        </div>

        <div style="text-align:center;">
          <a href="mailto:patricia.aspichueta@ehu.eus?subject=Candidatura%20Lipids%20%26%20Liver" class="btn-inst-primary" style="display:inline-flex; align-items:center; gap:8px;">
            <i class="fas fa-envelope"></i> {t.join_apply_btn}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .join-intro-side { display: flex; flex-direction: column; gap: 1.25rem; }
  .join-intro-photo {
    display: block;
    width: 100%;
    height: auto; /* proporción original (4:3), sin recortar a nadie */
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  /* Mosaico: fotos 1 y 2 altas (1 columna × 2 filas), fotos 3 y 4 anchas
     (2 columnas × 1 fila), apiladas a la derecha. Las filas miden lo mismo
     que una columna, así que las altas y las anchas son el mismo rectángulo
     girado (aprox. 1:2 y 2:1). */
  .join-life-wrap { container-type: inline-size; margin-bottom: 3.5rem; }
  .join-life-grid {
    --col: calc((100cqw - 3rem) / 4);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, var(--col));
    gap: 1rem;
  }
  .join-life-item {
    position: relative;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-surface-alt);
  }
  .join-life-item:nth-child(1) { grid-column: 1; grid-row: 1 / span 2; }
  .join-life-item:nth-child(2) { grid-column: 2; grid-row: 1 / span 2; }
  .join-life-item:nth-child(3) { grid-column: 3 / span 2; grid-row: 1; }
  .join-life-item:nth-child(4) { grid-column: 3 / span 2; grid-row: 2; }
  .join-life-item img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .join-life-item figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.75rem 0.9rem 0.7rem;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.35;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 20, 40, 0.75), rgba(0, 20, 40, 0));
  }
  /* Crédito sobre la propia foto, como en la galería del hero */
  .join-life-credit {
    position: absolute;
    top: 10px;
    right: 10px;
    max-width: calc(100% - 20px);
    padding: 2px 7px;
    border-radius: 30px;
    background: rgba(0, 30, 54, 0.55);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.56rem;
    line-height: 1.4;
  }
  .join-life-credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

  /* En móvil: las dos altas juntas arriba y las dos anchas debajo,
     manteniendo los mismos rectángulos (1:2 y 2:1) */
  @media (max-width: 640px) {
    .join-life-grid {
      --col: calc((100cqw - 1rem) / 2);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: calc(2 * var(--col) + 1rem) var(--col) var(--col);
    }
    .join-life-item:nth-child(1) { grid-column: 1; grid-row: 1; }
    .join-life-item:nth-child(2) { grid-column: 2; grid-row: 1; }
    .join-life-item:nth-child(3) { grid-column: 1 / span 2; grid-row: 2; }
    .join-life-item:nth-child(4) { grid-column: 1 / span 2; grid-row: 3; }
  }
</style>
