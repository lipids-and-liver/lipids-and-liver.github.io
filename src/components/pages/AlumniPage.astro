---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, getLocalizedCollection, localizeTeamRole, localizeTeamDepartment, CONTENT_SOURCE_LOCALE, type Locale } from '../../utils/i18n';
import ContentLangNotice from '../ContentLangNotice.astro';
import AlumniCard from '../cards/AlumniCard.astro';
import alumniData from '../../data/alumni.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const rawAlumni = (alumniData as any).alumni || alumniData;
const alumniList: any[] = Array.isArray(rawAlumni) ? rawAlumni : [];

// Egresados (formados en el grupo) y personal jubilado se muestran por separado
const RETIRED_CATEGORIES = ['emerita'];
const retiredList = alumniList.filter((a: any) => RETIRED_CATEGORIES.includes(a.category));
const graduatesList = alumniList.filter((a: any) => !RETIRED_CATEGORIES.includes(a.category));
// Personal del equipo marcado como jubilado (status: retired): conserva su ficha de CV
const retiredTeam = (await getLocalizedCollection('team', lang)).filter(m => m.data.status === 'retired');
// Se muestran con el mismo formato que el resto de antiguos miembros (AlumniCard)
const retiredTeamCards = retiredTeam.map(m => ({
  id: m.slug,
  name: m.data.name,
  labRole: m.locale === lang ? m.data.role : localizeTeamRole(m.data.role, lang),
  currentRole: t.team_retired_badge,
  currentAffiliation: m.locale === lang ? m.data.department : localizeTeamDepartment(m.data.department || '', lang),
  category: 'emerita',
  badgeLabel: t.team_retired_badge,
  icon: 'fas fa-university',
  orcid: m.data.orcid ? (m.data.orcid.startsWith('http') ? m.data.orcid : `https://orcid.org/${m.data.orcid}`) : undefined,
  linkedin: m.data.linkedin || undefined,
  cvUrl: getLocalizedPath(`/curriculum/${m.slug}`, lang),
  sourceLang: lang, // cargo y departamento ya salen traducidos
}));

// Filtros de egresados: solo las categorías que tienen alguien
const graduateFilters = [
  { key: 'academia', icon: 'fas fa-university', label: t.alumni_cat_academia },
  { key: 'industry', icon: 'fas fa-industry', label: t.alumni_cat_industry },
  { key: 'clinical', icon: 'fas fa-hospital', label: t.alumni_cat_clinical },
]
  .map(f => ({ ...f, count: graduatesList.filter((a: any) => a.category === f.key).length }))
  .filter(f => f.count > 0);
---

<Layout currentPage="alumni" lang={lang} title={`${t.alumni_page_title || 'Antiguos Miembros'} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-users-cog"></i> {t.alumni_title || 'Antiguos Miembros y Trayectoria'}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Header Section -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-award"></i> {t.alumni_badge}
        </span>
        <h1 class="catalog-title">{t.alumni_page_title || 'Antiguos Miembros'}</h1>
        <p class="catalog-subtitle">{t.alumni_page_sub || 'Investigadores y doctores del Grupo Consolidado Lipids & Liver registrados oficialmente en la Universidad del País Vasco'}</p>
      </div>
    </div>
  </section>

  <!-- Alumni Grid Section -->
  <section class="page-section">
    <div class="container">
      <!-- Institutional Registry Badge Banner -->
      <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 5px solid var(--logo-green); border-radius: 8px; padding: 1.25rem 1.6rem; margin-bottom: 2.5rem; display: flex; align-items: flex-start; gap: 1.2rem; box-shadow: 0 2px 4px rgba(104,159,56,0.08);">
        <i class="fas fa-university" style="color: var(--logo-green); font-size: 1.6rem; margin-top: 2px; flex-shrink:0;"></i>
        <div>
          <div style="color: #14532d; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.25rem;">
            {t.alumni_registry_title}
          </div>
          <p style="color: #166534; margin: 0; font-size: 0.92rem; line-height: 1.55;">
            <Fragment set:html={t.alumni_registry_desc} />
          </p>
        </div>
      </div>

      <!-- Los perfiles (alumni.json) solo existen en español -->
      <ContentLangNotice contentLang={CONTENT_SOURCE_LOCALE} lang={lang} variant="banner" />
    </div>
  </section>

  <!-- Alumni: egresados formados en el grupo -->
  <section class="page-section" id="alumni-graduados">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst"><i class="fas fa-user-graduate"></i> {t.alumni_graduates_title}</h2>
          <span class="section-subtitle-inst">{t.alumni_graduates_sub}</span>
        </div>
      </div>

      <!-- Career Impact Highlight -->
      <div class="about-card" style="padding:2rem; margin-bottom:3rem; background:linear-gradient(135deg, rgba(0, 43, 73, 0.04) 0%, rgba(104, 159, 56, 0.08) 100%); border-left: 4px solid var(--logo-green);">
        <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
          <div style="font-size:2.8rem; color:var(--logo-green); line-height:1;">
            <i class="fas fa-chart-line"></i>
          </div>
          <div style="flex:1; min-width:260px;">
            <h3 style="font-size:1.25rem; color:var(--ehu-navy); margin-bottom:0.4rem;">
              {t.alumni_impact_title}
            </h3>
            <p style="font-size:0.95rem; color:var(--text-secondary); line-height:1.6; margin:0;">
              <Fragment set:html={t.alumni_impact_desc} />
            </p>
          </div>
        </div>
      </div>

      {graduateFilters.length > 1 && (
        <div class="filter-controls-wrap" style="margin-bottom:2rem;">
          <div class="segmented-control-bar" id="alumni-category-filters">
            <button class="segmented-btn active" data-filter="ALL">
              <i class="fas fa-layer-group"></i> {t.team_all} <span class="segmented-count">{graduatesList.length}</span>
            </button>
            {graduateFilters.map(f => (
              <button class="segmented-btn" data-filter={f.key}>
                <i class={f.icon}></i> {f.label} <span class="segmented-count">{f.count}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <div class="alumni-grid-inst" id="alumni-grid">
        {graduatesList.map((alumni: any) => (
          <div class="alumni-item" data-category={alumni.category}>
            <AlumniCard alumni={alumni} lang={lang} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Personal jubilado -->
  {(retiredList.length > 0 || retiredTeam.length > 0) && (
    <section class="page-section page-section-alt" id="alumni-jubilados">
      <div class="container">
        <div class="section-header-inst">
          <div>
            <h2 class="section-title-inst"><i class="fas fa-award"></i> {t.alumni_retired_title}</h2>
            <span class="section-subtitle-inst">{t.alumni_retired_sub}</span>
          </div>
        </div>
        <div class="alumni-grid-inst">
          {[...retiredTeamCards, ...retiredList].map((alumni: any) => (
            <div class="alumni-item" data-category={alumni.category}>
              <AlumniCard alumni={alumni} lang={lang} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#alumni-category-filters .segmented-btn');
    const alumniItems = document.querySelectorAll('#alumni-grid .alumni-item');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        alumniItems.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'ALL' || category === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
