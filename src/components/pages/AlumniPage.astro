---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, CONTENT_SOURCE_LOCALE, type Locale } from '../../utils/i18n';
import ContentLangNotice from '../ContentLangNotice.astro';
import AlumniCard from '../cards/AlumniCard.astro';
import AlumniMap from '../AlumniMap.astro';
import placesData from '../../data/alumni_places.json';
import alumniData from '../../data/alumni.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const rawAlumni = (alumniData as any).alumni || alumniData;
const alumniList: any[] = Array.isArray(rawAlumni) ? rawAlumni : [];

const graduatesList = alumniList;

// Campos traducibles de cada perfil (base en español + <campo>_eu / <campo>_en)
const ALUMNI_I18N_FIELDS = ['labRole', 'currentRole', 'currentAffiliation', 'location'];
const missingTranslation = lang !== CONTENT_SOURCE_LOCALE && graduatesList.some((a: any) =>
  ALUMNI_I18N_FIELDS.some(f => a[f] && !a[`${f}_${lang}`]?.toString().trim())
);

// Filtros de egresados: solo las categorías que tienen alguien
const graduateFilters = [
  { key: 'academia', icon: 'fas fa-university', label: t.alumni_cat_academia },
  { key: 'industry', icon: 'fas fa-industry', label: t.alumni_cat_industry },
  { key: 'clinical', icon: 'fas fa-hospital', label: t.alumni_cat_clinical },
]
  .map(f => ({ ...f, count: graduatesList.filter((a: any) => a.category === f.key).length }))
  .filter(f => f.count > 0);
---

<Layout currentPage="alumni" lang={lang} title={`${t.alumni_page_title || 'Alumni'} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-users-cog"></i> {t.alumni_title || 'Alumni'}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Header Section -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-award"></i> {t.alumni_badge}
        </span>
        <h1 class="catalog-title">{t.alumni_page_title || 'Alumni'}</h1>
        <p class="catalog-subtitle">{t.alumni_page_sub || 'Investigadores y doctores del Grupo Consolidado Lipids & Liver registrados oficialmente en la Universidad del País Vasco'}</p>
      </div>
    </div>
  </section>

  <!-- Alumni Grid Section -->
  <section class="page-section">
    <div class="container">
      <!-- Institutional Registry Badge Banner -->
      <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 5px solid var(--logo-green); border-radius: 8px; padding: 1.25rem 1.6rem; margin-bottom: 2.5rem; display: flex; align-items: flex-start; gap: 1.2rem; box-shadow: 0 2px 4px rgba(104,159,56,0.08);">
        <i class="fas fa-university" style="color: var(--logo-green); font-size: 1.6rem; margin-top: 2px; flex-shrink:0;"></i>
        <div>
          <div style="color: #14532d; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.25rem;">
            {t.alumni_registry_title}
          </div>
          <p style="color: #166534; margin: 0; font-size: 0.92rem; line-height: 1.55;">
            <Fragment set:html={t.alumni_registry_desc} />
          </p>
        </div>
      </div>

      <!-- Aviso solo si algún perfil sigue sin traducir a este idioma -->
      {missingTranslation && <ContentLangNotice contentLang={CONTENT_SOURCE_LOCALE} lang={lang} variant="banner" />}
    </div>
  </section>

  <!-- Alumni: egresados formados en el grupo -->
  <section class="page-section" id="alumni-graduados">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst"><i class="fas fa-user-graduate"></i> {t.alumni_graduates_title}</h2>
          <span class="section-subtitle-inst">{t.alumni_graduates_sub}</span>
        </div>
      </div>

      <!-- Career Impact Highlight -->
      <div class="about-card" style="padding:2rem; margin-bottom:3rem; background:linear-gradient(135deg, rgba(0, 43, 73, 0.04) 0%, rgba(104, 159, 56, 0.08) 100%); border-left: 4px solid var(--logo-green);">
        <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
          <div style="font-size:2.8rem; color:var(--logo-green); line-height:1;">
            <i class="fas fa-chart-line"></i>
          </div>
          <div style="flex:1; min-width:260px;">
            <h3 style="font-size:1.25rem; color:var(--ehu-navy); margin-bottom:0.4rem;">
              {t.alumni_impact_title}
            </h3>
            <p style="font-size:0.95rem; color:var(--text-secondary); line-height:1.6; margin:0;">
              <Fragment set:html={t.alumni_impact_desc} />
            </p>
          </div>
        </div>
      </div>

      <AlumniMap alumni={graduatesList} lang={lang} />

      {graduateFilters.length > 1 && (
        <div class="filter-controls-wrap" style="margin-bottom:2rem;">
          <div class="segmented-control-bar" id="alumni-category-filters">
            <button class="segmented-btn active" data-filter="ALL">
              <i class="fas fa-layer-group"></i> {t.team_all} <span class="segmented-count">{graduatesList.length}</span>
            </button>
            {graduateFilters.map(f => (
              <button class="segmented-btn" data-filter={f.key}>
                <i class={f.icon}></i> {f.label} <span class="segmented-count">{f.count}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Filtro activo por ubicación (lo rellena el script) -->
      <div class="alumni-place-status" id="alumni-place-status" hidden>
        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
        <span>{t.alumni_map_filtering} <strong id="alumni-place-status-name"></strong></span>
        <button type="button" class="alumni-place-clear" id="alumni-place-clear">
          <i class="fas fa-times" aria-hidden="true"></i> {t.alumni_map_clear}
        </button>
      </div>

      <div class="alumni-grid-inst" id="alumni-grid">
        {graduatesList.map((alumni: any) => (
          <div class="alumni-item" data-category={alumni.category} data-place={placesData.places.some(p => p.id === alumni.place) ? alumni.place : 'none'}>
            <AlumniCard alumni={alumni} lang={lang} />
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Dos filtros combinables: categoría (botones) y ubicación (puntos del mapa o «sin ubicación precisa»)
    const state = { category: 'ALL', place: null };
    const categoryButtons = document.querySelectorAll('#alumni-category-filters .segmented-btn');
    const placeControls = document.querySelectorAll('[data-place-filter]');
    const items = document.querySelectorAll('#alumni-grid .alumni-item');
    const status = document.getElementById('alumni-place-status');
    const statusName = document.getElementById('alumni-place-status-name');

    const render = () => {
      items.forEach(item => {
        const okCategory = state.category === 'ALL' || item.dataset.category === state.category;
        const okPlace = !state.place || item.dataset.place === state.place;
        item.style.display = okCategory && okPlace ? '' : 'none';
      });
      placeControls.forEach(el => {
        const on = el.dataset.placeFilter === state.place;
        el.classList.toggle('active', on);
        el.setAttribute('aria-pressed', String(on));
      });
      if (status) {
        status.hidden = !state.place;
        const source = document.querySelector(`[data-place-filter="${state.place}"][data-place-name]`);
        if (statusName) statusName.textContent = source ? source.dataset.placeName : '';
      }
    };

    categoryButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        state.category = btn.getAttribute('data-filter');
        render();
      });
    });

    const togglePlace = id => { state.place = state.place === id ? null : id; render(); };
    placeControls.forEach(el => {
      el.addEventListener('click', () => togglePlace(el.dataset.placeFilter));
      el.addEventListener('keydown', e => {
        if (el.tagName !== 'BUTTON' && (e.key === 'Enter' || e.key === ' ')) {
          e.preventDefault();
          togglePlace(el.dataset.placeFilter);
        }
      });
    });
    document.getElementById('alumni-place-clear')?.addEventListener('click', () => { state.place = null; render(); });
  });
</script>
