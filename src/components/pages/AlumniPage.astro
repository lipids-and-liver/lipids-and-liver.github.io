---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import AlumniCard from '../cards/AlumniCard.astro';
import alumniData from '../../data/alumni.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const rawAlumni = (alumniData as any).alumni || alumniData;
const alumniList: any[] = Array.isArray(rawAlumni) ? rawAlumni : [];

const founder = alumniList.find((a: any) => a.isFounder);
const standardAlumni = alumniList.filter((a: any) => !a.isFounder);

const academiaCount = alumniList.filter((a: any) => a.category === 'academia').length;
const industryCount = alumniList.filter((a: any) => a.category === 'industry').length;
---

<Layout currentPage="alumni" lang={lang} title={`${t.alumni_page_title || 'Antiguos Miembros'} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-users-cog"></i> {t.alumni_title || 'Antiguos Miembros y Trayectoria'}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Header Section -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-award"></i> Registro Institucional UPV/EHU & Trayectoria Científica
        </span>
        <h1 class="catalog-title">{t.alumni_page_title || 'Antiguos Miembros'}</h1>
        <p class="catalog-subtitle">{t.alumni_page_sub || 'Investigadores y doctores del Grupo Consolidado Lipids & Liver registrados oficialmente en la Universidad del País Vasco'}</p>
      </div>

      <!-- Segmented Category Filters -->
      <div class="filter-controls-wrap">
        <div class="segmented-control-bar" id="alumni-category-filters">
          <button class="segmented-btn active" data-filter="ALL">
            <i class="fas fa-layer-group"></i> {t.team_all || 'Todos'} <span class="segmented-count">{alumniList.length}</span>
          </button>
          <button class="segmented-btn" data-filter="academia">
            <i class="fas fa-university"></i> Academia & Investigación <span class="segmented-count">{academiaCount}</span>
          </button>
          <button class="segmented-btn" data-filter="industry">
            <i class="fas fa-industry"></i> Industria & Biotecnología <span class="segmented-count">{industryCount}</span>
          </button>
          <button class="segmented-btn" data-filter="emerita">
            <i class="fas fa-crown"></i> Cátedra Emérita <span class="segmented-count">1</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Alumni Grid Section -->
  <section class="page-section">
    <div class="container">
      <!-- Institutional Registry Badge Banner -->
      <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 5px solid var(--logo-green); border-radius: 8px; padding: 1.25rem 1.6rem; margin-bottom: 2.5rem; display: flex; align-items: flex-start; gap: 1.2rem; box-shadow: 0 2px 4px rgba(104,159,56,0.08);">
        <i class="fas fa-university" style="color: var(--logo-green); font-size: 1.6rem; margin-top: 2px; flex-shrink:0;"></i>
        <div>
          <div style="color: #14532d; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.25rem;">
            Registro Oficial de Investigadores • Universidad del País Vasco (UPV/EHU)
          </div>
          <p style="color: #166534; margin: 0; font-size: 0.92rem; line-height: 1.55;">
            Datos de adscripción histórica y trayectoria académica contrastados con el <strong>Portal de Producción Científica de la UPV/EHU</strong> (Grupo Consolidado Lipids & Liver IT1560-22). Incluye enlaces directos a sus tesis doctorales defendidas en el grupo y perfiles curriculares institucionales.
          </p>
        </div>
      </div>

      <!-- Honorary Card: Dra. Begoña Ochoa Olascoaga -->
      {founder && (
        <div class="alumni-founder-card" style="background: linear-gradient(135deg, #002B49 0%, #1E3A5F 100%); color: #ffffff; border-radius: 12px; padding: 2.25rem; margin-bottom: 3rem; box-shadow: 0 10px 25px -5px rgba(0, 43, 73, 0.2); position: relative; overflow: hidden; border-left: 6px solid var(--logo-green);">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1.5rem; position:relative; z-index:2;">
            <div style="flex:1; min-width:300px;">
              <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.15); padding:4px 12px; border-radius:20px; font-size:0.8rem; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:1rem; color:#8AC63F;">
                <i class="fas fa-crown"></i> Reconocimiento Honorífico e Histórico
              </div>
              <h2 style="font-size:1.85rem; font-weight:800; color:#ffffff; margin:0 0 0.5rem 0;">{founder.name}</h2>
              <p style="color:#93c5fd; font-size:1.05rem; font-weight:600; margin-bottom:0.75rem;">
                {founder.role} • Grupo Lipids & Liver ({founder.period})
              </p>
              <p style="color:#e2e8f0; font-size:0.95rem; line-height:1.65; margin-bottom:1.5rem; max-width:850px;">
                {founder.description}
              </p>
              <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center;">
                <span style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); padding:6px 14px; border-radius:6px; font-size:0.85rem; color:#f1f5f9;">
                  <i class="fas fa-graduation-cap" style="color:#8AC63F; margin-right:6px;"></i> 6+ Tesis Doctorales Dirigidas
                </span>
                <span style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); padding:6px 14px; border-radius:6px; font-size:0.85rem; color:#f1f5f9;">
                  <i class="fas fa-certificate" style="color:#8AC63F; margin-right:6px;"></i> Cotitular Patente P201831028 (OEPM)
                </span>
                {founder.ehuUrl && (
                  <a href={founder.ehuUrl} target="_blank" rel="noopener noreferrer" class="btn-inst-primary" style="padding:7px 18px; font-size:0.85rem; border-radius:6px; text-decoration:none; display:inline-flex; align-items:center; gap:8px;">
                    <i class="fas fa-external-link-alt"></i> Perfil Producción Científica UPV/EHU
                  </a>
                )}
              </div>
            </div>
            <div style="font-size:5rem; color:rgba(255,255,255,0.1); line-height:1; align-self:center;">
              <i class="fas fa-award"></i>
            </div>
          </div>
        </div>
      )}

      <!-- Career Impact Highlight -->
      <div class="about-card" style="padding:2rem; margin-bottom:3rem; background:linear-gradient(135deg, rgba(0, 43, 73, 0.04) 0%, rgba(104, 159, 56, 0.08) 100%); border-left: 4px solid var(--logo-green);">
        <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
          <div style="font-size:2.8rem; color:var(--logo-green); line-height:1;">
            <i class="fas fa-chart-line"></i>
          </div>
          <div style="flex:1; min-width:260px;">
            <h3 style="font-size:1.25rem; color:var(--ehu-navy); margin-bottom:0.4rem;">
              Impacto de la Formación Doctoral en Lipids & Liver
            </h3>
            <p style="font-size:0.95rem; color:var(--text-secondary); line-height:1.6; margin:0;">
              Las doctoras e investigadores formados en nuestro laboratorio continúan su trayectoria profesional en centros de excelencia internacional (como la <strong>Universidad de Yale</strong>, <strong>Biocruces Bizkaia</strong>, <strong>CIC bioGUNE</strong>), facultades universitarias y compañías punteras del sector biotecnológico, de ensayos clínicos y de tecnologías ómicas.
            </p>
          </div>
        </div>
      </div>

      <div class="alumni-grid-inst" id="alumni-grid">
        {alumniList.map((alumni: any) => (
          <div class="alumni-item" data-category={alumni.category}>
            <AlumniCard alumni={alumni} lang={lang} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#alumni-category-filters .segmented-btn');
    const alumniItems = document.querySelectorAll('#alumni-grid .alumni-item');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        alumniItems.forEach(item => {
          const category = item.getAttribute('data-category');
          if (filter === 'ALL' || category === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
