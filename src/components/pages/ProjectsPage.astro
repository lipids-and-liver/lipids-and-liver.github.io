---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import ProjectCard from '../cards/ProjectCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const allProjects = await getLocalizedCollection('projects', lang);
allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const activeCount = allProjects.filter(p => p.data.status === 'active').length;
const completedCount = allProjects.filter(p => p.data.status === 'completed').length;
---

<Layout currentPage="projects" lang={lang} title={`${t.projects_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-hand-holding-usd"></i> {t.projects_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Page Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-award"></i> {t.hero_tag || 'Grupo Consolidado IT1560-22'}
        </span>
        <h1 class="catalog-title">{t.projects_page_title}</h1>
        <p class="catalog-subtitle">{t.projects_page_sub}</p>
      </div>

      <!-- Segmented Status Filter -->
      <div class="filter-controls-wrap">
        <div class="segmented-control-bar" id="projects-status-filters">
          <button class="segmented-btn active" data-filter="ALL">
            <i class="fas fa-layer-group"></i> {t.projects_all} <span class="segmented-count">{allProjects.length}</span>
          </button>
          <button class="segmented-btn" data-filter="ACTIVE">
            <i class="fas fa-spinner fa-spin"></i> {t.projects_active} <span class="segmented-count">{activeCount}</span>
          </button>
          <button class="segmented-btn" data-filter="COMPLETED">
            <i class="fas fa-check-circle"></i> {t.projects_completed} <span class="segmented-count">{completedCount}</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Grid Section -->
  <section class="page-section">
    <div class="container">
      <div class="projects-grid-inst" id="projects-grid">
        {allProjects.map(project => (
          <div class="project-item" data-status={project.data.status.toUpperCase()} data-type={project.data.fundingType}>
            <ProjectCard project={project} lang={lang} />
          </div>
        ))}
      </div>

      <!-- Institutional Transparency Notice -->
      <div class="institutional-funding-notice">
        <div class="funding-notice-icon">
          <i class="fas fa-shield-alt"></i>
        </div>
        <div class="funding-notice-text">
          <h4>Compromiso con la Transparencia y la Investigación de Impacto</h4>
          <p>
            Los proyectos del grupo Lipids & Liver están auditados y cofinanciados por entidades públicas y fundaciones científicas de máximo prestigio bajo directivas europeas de ciencia abierta y excelencia biomédica.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#projects-status-filters .segmented-btn');
    const projectItems = document.querySelectorAll('#projects-grid .project-item');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        projectItems.forEach(item => {
          const status = item.getAttribute('data-status');
          if (filter === 'ALL' || status === filter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>
