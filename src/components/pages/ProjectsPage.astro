---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import { formatProjectCode } from '../../utils/projects';
import ProjectCard from '../cards/ProjectCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const allProjects = await getLocalizedCollection('projects', lang);
allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const activeProjects = allProjects.filter(p => p.data.status === 'active');
const completedProjects = allProjects.filter(p => p.data.status === 'completed');

// Sort completed by year descending
completedProjects.sort((a, b) => {
  const yA = a.data.year || (a.data.period ? parseInt(a.data.period.match(/\b(20\d\d)\b/)?.[1] || '0') : 0);
  const yB = b.data.year || (b.data.period ? parseInt(b.data.period.match(/\b(20\d\d)\b/)?.[1] || '0') : 0);
  if (yB !== yA) return yB - yA;
  return (a.data.order || 99) - (b.data.order || 99);
});
---

<Layout currentPage="projects" lang={lang} title={`${t.projects_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-hand-holding-usd"></i> {t.projects_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Page Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-award"></i> {t.hero_tag || 'Grupo Consolidado IT1560-22'}
        </span>
        <h1 class="catalog-title">{t.projects_page_title}</h1>
        <p class="catalog-subtitle">{t.projects_page_sub}</p>
      </div>
    </div>
  </section>

  <!-- Main Content: Active Cards + Compact Archive Table -->
  <section class="page-section" style="padding-top: 1rem;">
    <div class="container">

      <!-- ==========================================
           SECCIÓN 1: PROYECTOS EN EJECUCIÓN (TARJETAS)
           ========================================== -->
      <div class="projects-block-header">
        <div class="projects-block-title-wrap">
          <h2 class="projects-block-title">
            <i class="fas fa-spinner fa-pulse" style="color:var(--logo-green);"></i>
            {t.projects_active_section_title || 'Proyectos en Ejecución'}
            <span class="projects-block-badge">{activeProjects.length}</span>
          </h2>
          <p class="projects-block-sub">
            {t.projects_active_section_sub || 'Proyectos competitivos y ayudas estructurales con dotación presupuestaria activa'}
          </p>
        </div>
      </div>

      <!-- Active Projects Grid (Clean & Impactful) -->
      <div class="projects-grid-inst" id="active-projects-grid">
        {activeProjects.map(project => (
          <div class="project-item">
            <ProjectCard project={project} lang={lang} />
          </div>
        ))}
      </div>

      <!-- ==========================================
           SECCIÓN 2: HISTÓRICO EN TABLA COMPACTA
           ========================================== -->
      <div class="projects-archive-box" id="historico">
        <!-- Archive Header & Toolbar -->
        <div class="projects-archive-toolbar">
          <div class="archive-search-row">
            <div>
              <h3 style="font-size:1.25rem; font-weight:700; color:var(--ehu-navy); margin:0 0 4px 0; display:flex; align-items:center; gap:8px;">
                <i class="fas fa-archive" style="color:var(--logo-green);"></i>
                {t.projects_archive_section_title || 'Histórico de Convocatorias y Proyectos Finalizados'}
                <span class="projects-block-badge" style="font-size:0.75rem;">{completedProjects.length}</span>
              </h3>
              <p style="font-size:0.86rem; color:var(--text-secondary); margin:0;">
                {t.projects_archive_section_sub || 'Registro auditado de proyectos concluidos con participación del equipo'}
              </p>
            </div>

            <!-- Instant Search Input -->
            <div class="archive-search-box">
              <i class="fas fa-search"></i>
              <input 
                type="text" 
                id="archive-search-input" 
                class="archive-search-input" 
                placeholder={t.projects_search_placeholder || 'Buscar por título, acrónimo, código, IP...'} 
                aria-label="Buscar en histórico de proyectos"
              />
            </div>
          </div>

          <!-- Entity Filter Pills & Counter Row -->
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div class="projects-entity-filters" id="archive-entity-filters" style="justify-content:flex-start;">
              <button class="entity-pill-btn active" data-type-filter="ALL">
                <i class="fas fa-th"></i> {lang === 'eu' ? 'Guztiak' : (lang === 'en' ? 'All' : 'Todas las entidades')}
              </button>
              <button class="entity-pill-btn" data-type-filter="national">
                <i class="fas fa-landmark"></i> {lang === 'eu' ? 'MCIU / Estatua' : (lang === 'en' ? 'National' : 'Nacional (MCIU/ISCIII)')}
              </button>
              <button class="entity-pill-btn" data-type-filter="regional">
                <i class="fas fa-map-marker-alt"></i> {lang === 'eu' ? 'Eusko Jaurlaritza' : (lang === 'en' ? 'Regional' : 'Autonómico (Gob. Vasco)')}
              </button>
              <button class="entity-pill-btn" data-type-filter="european">
                <i class="fas fa-globe-europe"></i> {lang === 'eu' ? 'FEDER / Europa' : (lang === 'en' ? 'European' : 'Europeo (FEDER)')}
              </button>
              <button class="entity-pill-btn" data-type-filter="foundation">
                <i class="fas fa-hand-holding-heart"></i> {lang === 'eu' ? 'Fundazioak' : (lang === 'en' ? 'Foundations' : 'Fundaciones (AECC)')}
              </button>
            </div>

            <div class="archive-counter">
              {lang === 'eu' ? 'Erakusten:' : (lang === 'en' ? 'Showing:' : 'Mostrando:')} <strong id="archive-visible-count">{completedProjects.length}</strong> / {completedProjects.length}
            </div>
          </div>
        </div>

        <!-- Compact Table Scroll Container -->
        <div class="archive-table-scroll">
          <table class="projects-compact-table" id="archive-table">
            <thead>
              <tr>
                <th class="col-year">{t.projects_col_year || 'Año / Periodo'}</th>
                <th class="col-code">{t.projects_col_code || 'Acrónimo / Ref.'}</th>
                <th class="col-title">{t.projects_col_title || 'Título del Proyecto'}</th>
                <th class="col-pi">{t.projects_col_pi || 'IP / Dirección'}</th>
                <th class="col-entity">{t.projects_col_entity || 'Entidad'}</th>
                <th class="col-budget">{t.projects_col_budget || 'Presupuesto'}</th>
                <th class="col-action">{t.projects_col_link || 'Ficha UPV/EHU'}</th>
              </tr>
            </thead>
            <tbody>
              {completedProjects.map(project => {
                const yearVal = project.data.year || project.data.period?.match(/\b(20\d\d)\b/)?.[1] || '-';
                const formattedCode = formatProjectCode(project.data.code);
                return (
                  <tr 
                    class="archive-row" 
                    data-type={project.data.fundingType}
                    data-search={`${project.data.title} ${project.data.acronym || ''} ${project.data.code || ''} ${project.data.pi || ''} ${project.data.fundingBody || ''} ${yearVal}`.toLowerCase()}
                  >
                    <td class="col-year">
                      <span class="archive-year-tag">{yearVal}</span>
                    </td>
                    <td class="col-code">
                      {project.data.acronym && (
                        <span class="archive-acronym-badge">{project.data.acronym}</span>
                      )}
                      {formattedCode.displayCode && (
                        <span 
                          class="archive-code-sub" 
                          title={formattedCode.extraCount > 0 ? `Subproyectos vinculados: ${formattedCode.fullCode}` : 'Código de referencia oficial'}
                        >
                          {formattedCode.displayCode}
                          {formattedCode.extraCount > 0 && (
                            <span class="code-more-badge">+{formattedCode.extraCount}</span>
                          )}
                        </span>
                      )}
                    </td>
                    <td class="col-title">
                      <span class="archive-title-link">{project.data.title}</span>
                    </td>
                    <td class="col-pi">
                      <span class="archive-pi-name">
                        <i class="fas fa-user-circle"></i>
                        {project.data.pi.split(',')[0]}
                      </span>
                    </td>
                    <td class="col-entity">
                      <span class="archive-entity-label" title={project.data.fundingBody}>
                        {project.data.fundingBody.length > 32 ? `${project.data.fundingBody.slice(0, 32)}...` : project.data.fundingBody}
                      </span>
                    </td>
                    <td class="col-budget">
                      {project.data.budget && project.data.budget.includes('€') ? (
                        <span class="archive-budget-val">{project.data.budget}</span>
                      ) : (
                        <span class="archive-budget-na">-</span>
                      )}
                    </td>
                    <td class="col-action">
                      {project.data.officialUrl ? (
                        <a 
                          href={project.data.officialUrl} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="archive-link-btn" 
                          title="Abrir ficha oficial en el portal de la UPV/EHU"
                        >
                          <span>UPV/EHU</span>
                          <i class="fas fa-external-link-alt" style="font-size:0.7rem;"></i>
                        </a>
                      ) : (
                        <span style="color:var(--text-muted); font-size:0.8rem;">-</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- No Archive Results Row -->
        <div id="no-archive-results" style="display:none; text-align:center; padding: 3rem 1rem;">
          <i class="fas fa-search" style="font-size:2rem; color:var(--text-muted); margin-bottom:0.75rem; display:block;"></i>
          <p style="color:var(--text-secondary); margin:0;">
            {lang === 'eu' ? 'Ez da proiekturik aurkitu irizpide hauekin' : (lang === 'en' ? 'No historical projects match your criteria' : 'No se han encontrado proyectos históricos con estos criterios')}
          </p>
        </div>
      </div>

      <!-- ==========================================
           SECCIÓN 3: BANNER OFICIAL UPV/EHU & TRANSPARENCIA
           ========================================== -->
      <div class="projects-official-hub-card" style="margin-top: 3.5rem;">
        <div class="projects-official-hub-info">
          <div class="projects-official-hub-icon">
            <i class="fas fa-university"></i>
          </div>
          <div>
            <h3 class="projects-official-hub-title">{t.projects_official_portal_btn || 'Portal de Producción Científica UPV/EHU'}</h3>
            <p class="projects-official-hub-desc">
              {t.projects_official_portal_desc || 'Registro oficial auditado de subvenciones del Grupo Lipids & Liver (Código 10483). Acceda a las fichas oficiales y al histórico institucional en la base de datos universitaria.'}
            </p>
          </div>
        </div>
        <div>
          <a 
            href="https://ekoizpen-zientifikoa.ehu.eus/grupos/10483/proyectos" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-inst-primary"
            style="white-space:nowrap; padding:12px 22px; font-size:0.92rem; border-radius:30px; display:inline-flex; align-items:center; gap:8px;"
          >
            <span>{lang === 'eu' ? 'UPV/EHU Erregistro Ofiziala' : (lang === 'en' ? 'Official UPV/EHU Portal' : 'Ver Registro Oficial UPV/EHU')}</span>
            <i class="fas fa-external-link-alt" style="font-size:0.8rem;"></i>
          </a>
        </div>
      </div>

      <!-- Institutional Transparency Notice -->
      <div class="institutional-funding-notice">
        <div class="funding-notice-icon">
          <i class="fas fa-shield-alt"></i>
        </div>
        <div class="funding-notice-text">
          <h4>{lang === 'eu' ? 'Gardentasunarekin eta Eraginpeko Ikerketarekin Konpromisoa' : (lang === 'en' ? 'Commitment to Transparency & High-Impact Research' : 'Compromiso con la Transparencia y la Investigación de Impacto')}</h4>
          <p>
            {lang === 'eu' 
              ? 'Lipids & Liver taldearen proiektuak entitate publikoek eta ospe goreneko fundazio zientifikoek ikuskatu eta finantzatzen dituzte, zientzia irekiaren eta bikaintasun biomedikoaren europar zuzentarauen pean.'
              : (lang === 'en'
                ? 'All research projects in the Lipids & Liver group are audited and co-funded by prestigious public bodies and scientific foundations in full compliance with European open-science directives and biomedical excellence.'
                : 'Los proyectos del grupo Lipids & Liver están auditados y cofinanciados por entidades públicas y fundaciones científicas de máximo prestigio bajo directivas europeas de ciencia abierta y excelencia biomédica.')
            }
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('archive-search-input');
    const entityButtons = document.querySelectorAll('#archive-entity-filters .entity-pill-btn');
    const rows = document.querySelectorAll('#archive-table tbody tr.archive-row');
    const visibleCounter = document.getElementById('archive-visible-count');
    const noResults = document.getElementById('no-archive-results');
    const tableElement = document.getElementById('archive-table');

    let selectedType = 'ALL';
    let searchQuery = '';

    function filterArchive() {
      let count = 0;

      rows.forEach(row => {
        const rowType = row.getAttribute('data-type');
        const rowSearch = row.getAttribute('data-search') || '';

        const typeMatch = (selectedType === 'ALL' || rowType === selectedType);
        const searchMatch = !searchQuery || rowSearch.includes(searchQuery);

        if (typeMatch && searchMatch) {
          row.style.display = '';
          count++;
        } else {
          row.style.display = 'none';
        }
      });

      if (visibleCounter) {
        visibleCounter.textContent = count;
      }

      if (noResults) {
        noResults.style.display = count === 0 ? 'block' : 'none';
      }
      if (tableElement) {
        tableElement.style.display = count === 0 ? 'none' : 'table';
      }
    }

    entityButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        entityButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedType = btn.getAttribute('data-type-filter') || 'ALL';
        filterArchive();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterArchive();
      });
    }
  });
</script>
