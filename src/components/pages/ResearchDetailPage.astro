---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedEntry, getLocalizedCollection, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import { render } from 'astro:content';
import PublicationCard from '../cards/PublicationCard.astro';

interface Props {
  id: string;
  lang: Locale;
}

const { id, lang } = Astro.props;
const t = getTranslations(lang);

const line = await getLocalizedEntry('research', id, lang);
if (!line) {
  throw new Error(`Research line with id "${id}" not found.`);
}

const allLines = await getLocalizedCollection('research', lang);
allLines.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const allPubs = await getLocalizedCollection('publications', lang);
const relatedPubs = allPubs.filter(p => p.data.topic === id);
relatedPubs.sort((a, b) => Number(b.data.year) - Number(a.data.year));

const MAX_LINE_PUBS = 5;
const displayedPubs = relatedPubs.slice(0, MAX_LINE_PUBS);
const hasMorePubs = relatedPubs.length > MAX_LINE_PUBS;

const currentSlug = line.slug;
const { Content } = await render(line);
---

<Layout title={`${line.data.title} - ${t.lines_title} | Lipids & Liver`} currentPage="lines" lang={lang}>
  <!-- Nav Extra: Research Line Dropdown Selector -->
  <div slot="nav-extra" class="nav-quick-select-group">
    <label for="line-select"><i class="fas fa-microscope"></i> {t.lines_select_label}</label>
    <select id="line-select" data-lang={lang} class="nav-quick-select">
      {allLines.map(item => (
        <option value={item.slug} selected={item.slug === currentSlug}>
          {item.data.title.substring(0, 50)}...
        </option>
      ))}
    </select>
  </div>

  <div class="container cv-container">
    <div class="cv-top-bar">
      <a href={getLocalizedPath('/#lines', lang)} class="btn-inst-secondary" style="padding:6px 14px; font-size:0.85rem; display:inline-flex; align-items:center; gap:8px;">
        <i class="fas fa-arrow-left"></i> {t.lines_back}
      </a>
    </div>

    <!-- Main Research Line Card: Mismo estilo limpio editorial que la carta de presentación -->
    <div class="cv-card">
      <!-- Columna Izquierda: Imagen de la línea, Distintivo, Metadatos clave -->
      <aside class="cv-aside">
        <div class="cv-aside-sticky">
          <div class="research-portrait">
            <img 
              src={line.data.image} 
              alt={line.data.title} 
              class="research-photo"
              loading="lazy"
            />
          </div>

          <div class="cv-aside-badge">
            <span class="research-badge">{line.data.badge}</span>
          </div>

          <div class="cv-contacts-box">
            <div class="cv-contact-item">
              <i class="fas fa-dna"></i>
              <div>
                <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.lines_title || 'Línea'}</div>
                <strong style="color:var(--ehu-navy);">{line.data.badge}</strong>
              </div>
            </div>

            <div class="cv-contact-item">
              <i class="fas fa-book-open"></i>
              <div>
                <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.nav_pubs || 'Publicaciones'}</div>
                <span>{relatedPubs.length} {t.pubs_of ? 'publicaciones' : 'artículos JCR'}</span>
              </div>
            </div>

            <div class="cv-contact-item">
              <i class="fas fa-university"></i>
              <div>
                <div style="font-size:0.7rem; text-transform:uppercase; font-weight:700; color:var(--text-muted);">{t.theses_affiliation_title || 'Filiación'}</div>
                <span>UPV/EHU • Biocruces</span>
              </div>
            </div>

            {hasMorePubs && (
              <a href={`${getLocalizedPath('/publicaciones', lang)}?topic=${id}`} class="cv-contact-item" style="color:var(--logo-green); font-weight:600; margin-top:4px;">
                <i class="fas fa-layer-group"></i>
                <span>{t.lines_view_all_pubs} ({relatedPubs.length})</span>
              </a>
            )}
          </div>
        </div>
      </aside>

      <!-- Columna Derecha: Contenido completo de la Línea de Investigación -->
      <article class="cv-main">
        <div class="cv-kicker">
          <span class="cv-dot"></span>
          {line.data.badge} • {t.lines_title || 'Líneas de Investigación'}
        </div>

        <h1 class="cv-main-name">
          {line.data.title}
        </h1>

        <div class="cv-main-title" style="font-size:1.05rem; line-height:1.6; color:var(--text-secondary); font-weight:400;">
          {line.data.shortDesc}
        </div>

        <!-- Descripción / Contenido Markdown -->
        <div class="cv-bio">
          <h3 class="cv-block-title" style="margin-bottom:0.85rem;"><i class="fas fa-file-alt"></i> {t.lines_desc_title}</h3>
          <Content />
        </div>

        <!-- Filiación Institucional -->
        <div class="cv-block">
          <h3 class="cv-block-title"><i class="fas fa-university"></i> {t.lines_affiliation_title}</h3>
          <p class="cv-block-text">
            {line.data.affiliation || t.lines_affiliation_val}
          </p>
        </div>

        <!-- Publicaciones Relacionadas -->
        {relatedPubs.length > 0 && (
          <div class="cv-block">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:1.25rem;">
              <h3 class="cv-block-title" style="margin:0;">
                <i class="fas fa-book-open"></i> {t.lines_recent_pubs} ({displayedPubs.length} {t.pubs_of} {relatedPubs.length})
              </h3>
              {hasMorePubs && (
                <a 
                  href={`${getLocalizedPath('/publicaciones', lang)}?topic=${id}`} 
                  class="btn-inst-primary" 
                  style="padding:5px 14px; font-size:0.82rem; border-radius:20px; display:inline-flex; align-items:center; gap:6px;"
                >
                  <i class="fas fa-layer-group"></i> {t.lines_view_all_pubs} ({relatedPubs.length}) <i class="fas fa-arrow-right"></i>
                </a>
              )}
            </div>

            <div class="pubs-list" style="margin-top:0.75rem;">
              {displayedPubs.map(pub => (
                <PublicationCard pub={pub} />
              ))}
            </div>

            {hasMorePubs && (
              <div style="text-align:center; margin-top:1.5rem; padding-top:1.25rem; border-top:1px dashed var(--border-color);">
                <a 
                  href={`${getLocalizedPath('/publicaciones', lang)}?topic=${id}`} 
                  class="btn-inst-primary" 
                  style="padding:9px 22px; font-size:0.9rem; border-radius:30px; display:inline-flex; align-items:center; gap:8px;"
                >
                  <i class="fas fa-book-open"></i> {t.lines_view_all_pubs} ({relatedPubs.length}) <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            )}
          </div>
        )}
      </article>
    </div>
  </div>

  <script is:inline>
    const select = document.getElementById('line-select');
    if (select) {
      const lang = select.dataset.lang || 'es';
      const prefix = lang === 'es' ? '/portal' : '/portal/' + lang;
      select.addEventListener('change', (e) => {
        if (e.target.value) {
          window.location.href = prefix + '/lineas/' + e.target.value;
        }
      });
    }
  </script>
</Layout>
