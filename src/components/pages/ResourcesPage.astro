---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Layout currentPage="resources" lang={lang} title={`${t.resources_page_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-lock-open"></i> {t.resources_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Hero Header -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-code-branch"></i> Open Science & Principios FAIR
        </span>
        <h1 class="catalog-title">{t.resources_page_title}</h1>
        <p class="catalog-subtitle">{t.resources_page_sub}</p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="page-section">
    <div class="container">
      <!-- Open Science Declaration -->
      <div class="about-grid" style="margin-bottom: 3.5rem;">
        <div class="about-text">
          <h2 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.6rem;">
            Compromiso con la Ciencia Abierta y la Reproducibilidad
          </h2>
          <p style="font-size:1.05rem; line-height:1.75; color:var(--text-secondary); margin-bottom:1.25rem;">
            El Grupo <strong>Lipids & Liver</strong> apoya de manera activa los principios de <strong>Ciencia Abierta (*Open Science*)</strong> promovidos por la Comisión Europea, el Plan Estatal de Investigación y la UPV/EHU. Creemos firmemente que compartir protocolos estandarizados, datos brutos y código analítico acelera el descubrimiento biomédico.
          </p>
          <p style="font-size:1rem; line-height:1.7; color:var(--text-secondary);">
            Todos los conjuntos de datos derivados de nuestras publicaciones son depositados en repositorios públicos abiertos (GEO, MetaboLights, Zenodo), y nuestros procedimientos normalizados de trabajo (SOPs) se encuentran documentados para su libre consulta por la comunidad investigadora.
          </p>
        </div>

        <div style="background:var(--bg-surface-alt); padding:2rem; border-radius:var(--radius-md); border:1px solid var(--border-color); display:flex; flex-direction:column; justify-content:center;">
          <h4 style="color:var(--ehu-navy); margin-bottom:1rem; font-size:1.15rem;">
            <i class="fas fa-certificate" style="color:var(--logo-green);"></i> Principios FAIR
          </h4>
          <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:10px; font-size:0.9rem; color:var(--text-secondary);">
            <li><strong>F - Findable:</strong> Identificadores persistentes (DOIs, códigos de acceso GEO/BioStudies).</li>
            <li><strong>A - Accessible:</strong> Acceso abierto libre de barreras para manuscritos y metadatos.</li>
            <li><strong>I - Interoperable:</strong> Formatos estándar de espectrometría (mzML, netCDF, tablas CSV).</li>
            <li><strong>R - Reusable:</strong> Licencias abiertas Creative Commons y documentación de réplicas.</li>
          </ul>
        </div>
      </div>

      <!-- Lab Protocols Section -->
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">Protocolos de Laboratorio Estandarizados (SOPs)</h2>
          <span class="section-subtitle-inst">Metodologías wet-lab optimizadas en el Departamento de Fisiología</span>
        </div>
      </div>

      <div class="research-grid-inst" style="margin-bottom:3.5rem;">
        <!-- Protocol 1 -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#e0f2fe; color:#0369a1;"><i class="fas fa-file-alt"></i> SOP-01</span>
              <h3 class="research-card-title">Extracción de Lípidos Totales (Folch Modificado)</h3>
            </div>
            <p class="research-card-desc">
              Protocolo optimizado en fase bifásica (cloroformo/metanol 2:1 v/v) con cloruro de potasio para máxima recuperación de fosfolípidos y lípidos neutros en tejido hepático murino y biopsias humanas.
            </p>
            <div style="margin-top:1.25rem;">
              <span class="specialty-chip"><i class="fas fa-check"></i> Validado por Lipidómica</span>
            </div>
          </div>
        </div>

        <!-- Protocol 2 -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#fef3c7; color:#92400e;"><i class="fas fa-file-alt"></i> SOP-02</span>
              <h3 class="research-card-title">Aislamiento de Hepatocitos Murinos Primarios</h3>
            </div>
            <p class="research-card-desc">
              Técnica de perfusión hepática in situ en dos pasos (tampón quelante EGTA seguido de solución enzimática de colagenasa tipo IV) para la obtención de hepatocitos viables (&gt;85% azul de tripano).
            </p>
            <div style="margin-top:1.25rem;">
              <span class="specialty-chip"><i class="fas fa-check"></i> Cultivo Primario</span>
            </div>
          </div>
        </div>

        <!-- Protocol 3 -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#dcfce7; color:#166534;"><i class="fas fa-file-alt"></i> SOP-03</span>
              <h3 class="research-card-title">Tinción y Análisis Cuantitativo de Gotas Lipídicas</h3>
            </div>
            <p class="research-card-desc">
              Detección de esteatosis celular en hepatocitos y líneas tumorales mediante tinción con Oil Red O y fluorescencia vital con sondas BODIPY 493/503 acoplada a microscopía confocal y citometría.
            </p>
            <div style="margin-top:1.25rem;">
              <span class="specialty-chip"><i class="fas fa-check"></i> Microscopía Confocal</span>
            </div>
          </div>
        </div>

        <!-- Protocol 4 -->
        <div class="research-card-inst">
          <div class="research-card-content">
            <div class="research-card-header">
              <span class="research-badge" style="background:#f3e8ff; color:#6b21a8;"><i class="fas fa-file-alt"></i> SOP-04</span>
              <h3 class="research-card-title">Fraccionamiento Subcelular (Mitocondrias y Microsomas)</h3>
            </div>
            <p class="research-card-desc">
              Homogeneización isotónica suave y centrifugación diferencial para separar mitocondrias intactas, microsomas (retículo endoplásmico) y fracción citosólica en modelos de estrés metabólico.
            </p>
            <div style="margin-top:1.25rem;">
              <span class="specialty-chip"><i class="fas fa-check"></i> Bioquímica Celular</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Public Repositories & Data Section -->
      <div class="section-header-inst">
        <div>
          <h2 class="section-title-inst">Repositorios Públicos y Código Abierto</h2>
          <span class="section-subtitle-inst">Bases de datos y canales de acceso a recursos de investigación</span>
        </div>
      </div>

      <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        <div class="stat-box" style="text-align:left; padding:2rem;">
          <div style="font-size:2.2rem; color:var(--ehu-navy); margin-bottom:0.75rem;"><i class="fab fa-github"></i></div>
          <h4 style="font-size:1.15rem; color:var(--ehu-navy); margin-bottom:0.5rem;">GitHub & Bioinformática</h4>
          <p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.6; margin-bottom:1rem;">
            Pipelines y scripts en R/Bioconductor para el preprocesamiento de espectrometría de masas, imputación de valores faltantes y análisis ómico espacial.
          </p>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" style="font-size:0.85rem; font-weight:700; color:var(--logo-green); text-decoration:none;">
            Explorar en GitHub <i class="fas fa-arrow-right"></i>
          </a>
        </div>

        <div class="stat-box" style="text-align:left; padding:2rem;">
          <div style="font-size:2.2rem; color:var(--ehu-navy); margin-bottom:0.75rem;"><i class="fas fa-database"></i></div>
          <h4 style="font-size:1.15rem; color:var(--ehu-navy); margin-bottom:0.5rem;">GEO & MetaboLights</h4>
          <p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.6; margin-bottom:1rem;">
            Matrices de expresión génica (microarrays y RNA-seq) y perfiles metabolómicos/lipidómicos depositados y referenciados con identificadores públicos.
          </p>
          <a href="https://www.ncbi.nlm.nih.gov/geo/" target="_blank" rel="noopener noreferrer" style="font-size:0.85rem; font-weight:700; color:var(--logo-green); text-decoration:none;">
            Consultar GEO NCBI <i class="fas fa-arrow-right"></i>
          </a>
        </div>

        <div class="stat-box" style="text-align:left; padding:2rem;">
          <div style="font-size:2.2rem; color:var(--ehu-navy); margin-bottom:0.75rem;"><i class="fas fa-book"></i></div>
          <h4 style="font-size:1.15rem; color:var(--ehu-navy); margin-bottom:0.5rem;">LIPID MAPS Gateway</h4>
          <p style="font-size:0.9rem; color:var(--text-secondary); line-height:1.6; margin-bottom:1rem;">
            Anotación de especies lipídicas siguiendo la clasificación estándar internacional de la iniciativa LIPID MAPS (LMSD).
          </p>
          <a href="https://www.lipidmaps.org" target="_blank" rel="noopener noreferrer" style="font-size:0.85rem; font-weight:700; color:var(--logo-green); text-decoration:none;">
            Visitar LIPID MAPS <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
