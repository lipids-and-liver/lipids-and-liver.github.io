---
import Layout from '../../layouts/Layout.astro';
import ContentLangNotice from '../ContentLangNotice.astro';
import { getLocalizedCollection, getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';
import { render } from 'astro:content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const entries = await getLocalizedCollection('sciresources', lang);
entries.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const resources = await Promise.all(entries.map(async entry => ({ entry, Content: (await render(entry)).Content })));

const providers = [
  { key: 'sgiker', title: t.sciresources_provider_sgiker, icon: 'fas fa-university' },
  { key: 'biobizkaia', title: t.sciresources_provider_biobizkaia, icon: 'fas fa-hospital-user' },
] as const;
---

<Layout currentPage="sciresources" lang={lang} title={`${t.sciresources_title} | Lipids & Liver`}>
  <!-- Contextual Sub-bar -->
  <div class="nav-sub-bar">
    <div class="container nav-sub-container">
      <div class="nav-sub-context">
        <span class="nav-sub-badge">
          <i class="fas fa-flask-vial"></i> {t.sciresources_title}
        </span>
      </div>
      <div class="nav-sub-actions">
        <a href={getLocalizedPath('/', lang)} class="btn-inst-outline-light">
          <i class="fas fa-home"></i> {t.nav_home}
        </a>
      </div>
    </div>
  </div>

  <!-- Header Section -->
  <section class="catalog-header-section">
    <div class="container">
      <div class="catalog-header-content">
        <span class="catalog-badge">
          <i class="fas fa-flask"></i> {t.nav_group_research}
        </span>
        <h1 class="catalog-title">{t.sciresources_title}</h1>
        <p class="catalog-subtitle">{t.sciresources_page_sub}</p>
      </div>
    </div>
  </section>

  {providers.map(provider => {
    const items = resources.filter(r => r.entry.data.provider === provider.key);
    return items.length > 0 && (
      <section class="page-section sciresources-section">
        <div class="container">
          <div class="section-header-inst">
            <div>
              <h2 class="section-title-inst"><i class={provider.icon}></i> {provider.title}</h2>
            </div>
          </div>
          <div class="sciresources-grid">
            {items.map(({ entry, Content }) => (
              <article class="sciresource-card" lang={entry.locale !== lang ? entry.locale : undefined}>
                <header class="sciresource-card-header">
                  <span class="sciresource-card-icon"><i class={entry.data.icon} aria-hidden="true"></i></span>
                  <div>
                    <h3 class="sciresource-card-title">{entry.data.title}</h3>
                    {entry.data.location && (
                      <span class="sciresource-card-location"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {entry.data.location}</span>
                    )}
                  </div>
                </header>
                <ContentLangNotice contentLang={entry.locale} lang={lang} variant="banner" />
                {entry.data.draft && (
                  <p class="content-lang-notice" role="note"><i class="fas fa-pen-nib" aria-hidden="true"></i> {t.content_draft_public_sources}</p>
                )}
                <div class="sciresource-card-body">
                  <Content />
                </div>
                <a href={entry.data.url} target="_blank" rel="noopener noreferrer" class="sciresource-card-link">
                  {t.sciresources_official_link} <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })}
</Layout>
