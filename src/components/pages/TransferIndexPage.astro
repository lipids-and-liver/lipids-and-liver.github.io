---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getTranslations, type Locale } from '../../utils/i18n';
import PatentCard from '../cards/PatentCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const allTransfer = await getLocalizedCollection('transfer', lang);
allTransfer.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const patents = allTransfer.filter(item => item.data.type === 'patent');
const services = allTransfer.filter(item => item.data.type === 'service');
---

<Layout title={`${t.transfer_page_title} | Lipids & Liver (UPV/EHU)`} currentPage="transfer" lang={lang}>
  <div slot="nav-extra" class="nav-quick-select-group">
    <span class="nav-sub-badge"><i class="fas fa-lightbulb"></i> {t.transfer_title}</span>
  </div>

  <section class="page-section">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h1 class="section-title-inst">{t.transfer_title} <span class="badge-new">{t.badge_new}</span></h1>
          <span class="section-subtitle-inst">{t.transfer_subtitle}</span>
        </div>
      </div>

      <p style="font-size:1.02rem; color:var(--text-secondary); max-width:840px; margin-bottom:2.5rem; line-height:1.6;">
        {t.transfer_desc}
      </p>

      <!-- Patentes Registradas -->
      <div style="margin-bottom:3.5rem;">
        <h2 style="font-size:1.4rem; color:var(--ehu-navy); margin-bottom:1.25rem; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-certificate" style="color:var(--logo-green);"></i> {t.transfer_patents_title}
        </h2>
        <div class="grid-2">
          {patents.map(item => (
            <PatentCard item={item} lang={lang} />
          ))}
        </div>
      </div>

      <!-- Servicios a Empresa / OTRI -->
      <div class="card card-highlight" style="margin-top:2rem;">
        <h2 style="color:var(--ehu-navy); font-size:1.3rem; margin-bottom:0.5rem; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-handshake" style="color:var(--logo-green);"></i> {t.transfer_services_title}
        </h2>
        <p style="font-size:0.95rem; color:var(--text-secondary); margin-bottom:1.5rem; line-height:1.6;">
          {t.transfer_services_desc}
        </p>
        <div class="grid-3" style="margin-top:1rem;">
          <div style="background:var(--bg-surface-alt); padding:1.25rem; border-radius:var(--radius-md); border:1px solid var(--border-light);">
            <div style="font-weight:700; color:var(--ehu-navy); font-size:0.95rem; margin-bottom:0.4rem;">
              <i class="fas fa-vial" style="color:var(--logo-green); margin-right:4px;"></i> {t.transfer_service1_title}
            </div>
            <div style="font-size:0.84rem; color:var(--text-muted); line-height:1.5;">{t.transfer_service1_desc}</div>
          </div>
          <div style="background:var(--bg-surface-alt); padding:1.25rem; border-radius:var(--radius-md); border:1px solid var(--border-light);">
            <div style="font-weight:700; color:var(--ehu-navy); font-size:0.95rem; margin-bottom:0.4rem;">
              <i class="fas fa-chart-line" style="color:var(--logo-green); margin-right:4px;"></i> {t.transfer_service2_title}
            </div>
            <div style="font-size:0.84rem; color:var(--text-muted); line-height:1.5;">{t.transfer_service2_desc}</div>
          </div>
          <div style="background:var(--bg-surface-alt); padding:1.25rem; border-radius:var(--radius-md); border:1px solid var(--border-light);">
            <div style="font-weight:700; color:var(--ehu-navy); font-size:0.95rem; margin-bottom:0.4rem;">
              <i class="fas fa-stethoscope" style="color:var(--logo-green); margin-right:4px;"></i> {t.transfer_service3_title}
            </div>
            <div style="font-size:0.84rem; color:var(--text-muted); line-height:1.5;">{t.transfer_service3_desc}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
