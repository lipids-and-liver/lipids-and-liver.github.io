---
import Layout from '../../layouts/Layout.astro';
import { getLocalizedCollection, getTranslations, type Locale } from '../../utils/i18n';
import OutreachCard from '../cards/OutreachCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const allOutreach = await getLocalizedCollection('outreach', lang);
allOutreach.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<Layout title={`${t.outreach_page_title} | Lipids & Liver (UPV/EHU)`} currentPage="outreach" lang={lang}>
  <div slot="nav-extra" class="nav-quick-select-group">
    <span class="nav-sub-badge"><i class="fas fa-heartbeat"></i> {t.outreach_title}</span>
  </div>

  <section class="page-section">
    <div class="container">
      <div class="section-header-inst">
        <div>
          <h1 class="section-title-inst">{t.outreach_title} <span class="badge-new">{t.badge_new}</span></h1>
          <span class="section-subtitle-inst">{t.outreach_subtitle}</span>
        </div>
      </div>

      <p style="font-size:1.02rem; color:var(--text-secondary); max-width:840px; margin-bottom:2.5rem; line-height:1.6;">
        {t.outreach_desc}
      </p>

      <div class="grid-3">
        {allOutreach.map(item => (
          <OutreachCard item={item} lang={lang} />
        ))}
      </div>
    </div>
  </section>
</Layout>
