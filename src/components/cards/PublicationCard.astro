---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../utils/i18n';

interface Props {
  pub: CollectionEntry<'publications'> & { slug: string; locale: Locale };
}

const { pub } = Astro.props;

const topicLabels: Record<string, { label: string; icon: string }> = {
  'mafld': { label: 'MAFLD / MASH', icon: 'fa-notes-medical' },
  'cancer': { label: 'Cáncer Hepático', icon: 'fa-dna' },
  'lipidomics': { label: 'Lipidómica SGIker', icon: 'fa-vial' },
  'e2f': { label: 'Daño Hepático (E2F)', icon: 'fa-chart-line' },
  'exposome': { label: 'Exposoma & MDCs', icon: 'fa-globe-americas' },
  'spatial-omics': { label: 'Spatial Omics', icon: 'fa-microscope' }
};

const topicInfo = topicLabels[pub.data.topic] || { label: pub.data.topic, icon: 'fa-tag' };
---

<div class="pub-card" data-topic={pub.data.topic} data-year={pub.data.year}>
  <div class="pub-header">
    <h4 class="pub-title">{pub.data.title}</h4>
    <span class="pub-year">{pub.data.year}</span>
  </div>
  <div class="pub-authors">{pub.data.authors}</div>
  <div class="pub-meta-row">
    <div class="pub-journal">
      <i class="fas fa-book-open" style="color:var(--logo-green); font-size:0.85rem;"></i>
      <em>{pub.data.journal}</em>
    </div>
    <span class="pub-topic-badge">
      <i class={`fas ${topicInfo.icon}`}></i> {topicInfo.label}
    </span>
  </div>
  {pub.body && pub.body.trim().length > 0 && (
    <details class="pub-abstract-details">
      <summary class="pub-abstract-summary">
        <i class="fas fa-align-left"></i> Resumen / Abstract
      </summary>
      <div class="pub-abstract-content">
        <p>{pub.body.trim()}</p>
      </div>
    </details>
  )}
  <div class="pub-actions">
    {pub.data.doi && (
      <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener" class="pub-doi-link">
        <i class="fas fa-external-link-alt"></i> DOI: {pub.data.doi}
      </a>
    )}
  </div>
</div>
