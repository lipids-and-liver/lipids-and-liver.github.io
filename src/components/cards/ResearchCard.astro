---
import { getLocalizedPath, getTranslations, type Locale } from '../../utils/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  line: CollectionEntry<'research'> & { slug: string; locale: Locale };
  lang: Locale;
}

const { line, lang } = Astro.props;
const t = getTranslations(lang);
---

<div class="research-card-inst">
  <img src={line.data.image} alt={line.data.title} class="research-card-img" />
  <div class="research-card-content">
    <div style="display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-bottom:0.75rem;">
      <span class="research-badge">{line.data.badge}</span>
      {(line.data.id === 'lipidomics' || line.slug?.includes('lipidomics')) && (
        <span style="background:#fee2e2; color:#b91c1c; font-size:0.68rem; font-weight:700; padding:2px 7px; border-radius:4px; border:1px solid #fca5a5;">
          ¿Sustituir por EHU-iBio?
        </span>
      )}
    </div>
    <h3 style="font-size:1.15rem; font-weight:700; margin-bottom:0.75rem; color:var(--ehu-navy);">{line.data.title}</h3>
    <p style="font-size:0.9rem; color:var(--text-secondary); margin-bottom:1.25rem; flex-grow:1; line-height:1.6;">{line.data.shortDesc}</p>
    <div class="research-card-footer">
      <a 
        href={getLocalizedPath(`/lineas/${line.slug}`, lang)} 
        class="card-btn-compact" 
        title={t.research_btn_page}
      >
        <i class="fas fa-microscope"></i>
        <span>{t.research_card_btn || 'Ver línea'}</span>
        <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</div>
