---
import { getLocalizedPath, getTranslations, getTeamCategoryInfo, localizeTeamRole, localizeTeamDepartment, type Locale } from '../../utils/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  member: CollectionEntry<'team'> & { slug: string; locale: Locale };
  lang: Locale;
}

const { member, lang } = Astro.props;
const t = getTranslations(lang);

const catInfo = getTeamCategoryInfo(member.data.category, lang);
const catKey = catInfo.key;
const catLabel = catInfo.label;
const catBadge = `<i class="${catInfo.icon}" style="margin-right:4px;"></i> ${catLabel}`;

const currentSlug = member.slug;
const localizedRole = member.locale === lang ? member.data.role : localizeTeamRole(member.data.role, lang);
const localizedDept = member.locale === lang ? member.data.department : localizeTeamDepartment(member.data.department || '', lang);

const searchIndex = `${member.data.name} ${localizedRole} ${catLabel} ${member.data.role} ${member.data.category} ${member.data.department || ''}`.toLowerCase();
const imageSrc = member.data.image ? (member.data.image.startsWith('/') ? member.data.image : `/${member.data.image}`) : '/assets/images/team/placeholder.jpg';
---

<div class={`team-card-inst team-card-${catKey}`} data-category={member.data.category} data-catkey={catKey} data-search={searchIndex}>
  <div class={`team-photo-box photo-${catKey}`}>
    <img src={imageSrc} alt={member.data.name} class="team-photo-img" />
  </div>
  <div class="team-card-info">
    <h4 class="team-member-name">{member.data.name}</h4>
    <div class="team-member-role">{localizedRole}</div>
    <div class="team-member-dept">{localizedDept}</div>
    
    <div class="team-card-footer">
      <span class={`team-category-badge badge-${catKey}`} set:html={catBadge} />
      <a href={getLocalizedPath(`/curriculum/${currentSlug}`, lang)} class="team-cv-btn-icon" title={t.team_view_cv || 'CV'}>
        <i class="fas fa-id-card"></i> CV
      </a>
    </div>
  </div>
</div>
