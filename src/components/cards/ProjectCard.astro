---
import type { CollectionEntry } from 'astro:content';
import { getTranslations, type Locale } from '../../utils/i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  lang?: Locale;
}

const { project, lang = 'es' } = Astro.props;
const {
  title,
  acronym,
  code,
  fundingBody,
  pi,
  period,
  status,
  badge,
  summary,
  fundingType,
  budget,
  officialUrl,
  researchers
} = project.data;
const t = getTranslations(lang);

const isActive = status === 'active';
const statusLabel = isActive ? (t.projects_status_active || 'En Activo') : (t.projects_status_completed || 'Finalizado');
---

<div class={`project-card-inst ${isActive ? 'status-active' : 'status-completed'}`}>
  <div class="project-card-header">
    <div class="project-badges">
      <span class={`project-status-badge ${isActive ? 'badge-active' : 'badge-completed'}`}>
        <i class={`fas ${isActive ? 'fa-dot-circle' : 'fa-check-circle'}`}></i>
        {statusLabel}
      </span>
      {acronym && (
        <span class="project-acronym-badge" title="Acrónimo oficial">
          <i class="fas fa-bookmark"></i> {acronym}
        </span>
      )}
      {badge && <span class="project-type-badge">{badge}</span>}
    </div>
    {code && (
      <span class="project-code-tag" title="Código de referencia oficial">
        <i class="fas fa-hashtag"></i> {code}
      </span>
    )}
  </div>

  <h3 class="project-title">{title}</h3>

  <div class="project-meta-grid">
    <div class="project-meta-item">
      <i class="fas fa-user-tie"></i>
      <div>
        <span class="meta-label">{t.projects_pi_label || 'Investigador/a Principal:'}</span>
        <span class="meta-value">{pi}</span>
      </div>
    </div>

    <div class="project-meta-item">
      <i class="fas fa-landmark"></i>
      <div>
        <span class="meta-label">{t.projects_entity_label || 'Entidad Financiadora:'}</span>
        <span class="meta-value">{fundingBody}</span>
      </div>
    </div>

    {budget && (
      <div class="project-meta-item project-budget-highlight">
        <i class="fas fa-coins"></i>
        <div>
          <span class="meta-label">{t.projects_budget_label || 'Presupuesto Concedido:'}</span>
          <span class="meta-value budget-amount">{budget}</span>
        </div>
      </div>
    )}

    <div class="project-meta-item">
      <i class="fas fa-calendar-alt"></i>
      <div>
        <span class="meta-label">{t.projects_period_label || 'Periodo:'}</span>
        <span class="meta-value">{period}</span>
      </div>
    </div>
  </div>

  {summary && (
    <p class="project-summary">
      {summary}
    </p>
  )}

  <div class="project-card-footer">
    {officialUrl ? (
      <a 
        href={officialUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn-project-official"
        title="Consultar ficha en el Portal de Producción Científica UPV/EHU"
      >
        <i class="fas fa-university"></i>
        <span>{t.projects_official_link || 'Ficha oficial UPV/EHU'}</span>
        <i class="fas fa-external-link-alt ext-icon"></i>
      </a>
    ) : (
      <span class="official-verified-badge">
        <i class="fas fa-shield-alt"></i> Registrado UPV/EHU
      </span>
    )}

    {researchers && researchers.length > 1 && (
      <span class="project-team-chip" title={researchers.join(', ')}>
        <i class="fas fa-users"></i> {researchers.length} miembros
      </span>
    )}
  </div>
</div>
