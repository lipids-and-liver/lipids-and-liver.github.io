---
import type { CollectionEntry } from 'astro:content';
import { getTranslations, type Locale } from '../../utils/i18n';

interface Props {
  alumni: CollectionEntry<'alumni'> & { slug: string; locale: Locale };
  lang: Locale;
}

const { alumni, lang } = Astro.props;
const t = getTranslations(lang);
const { data, body } = alumni;
---

<div class="card alumni-card">
  <div class="alumni-avatar">
    <i class={data.icon || 'fas fa-user-graduate'}></i>
  </div>
  
  <h4 class="alumni-name">{data.name}</h4>
  <div class="alumni-period">{data.period}</div>
  
  <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:0.75rem; font-style:italic; line-height:1.4;">
    "{data.thesisTitle}"
  </p>

  {body && (
    <p style="font-size:0.82rem; color:var(--text-secondary); margin-bottom:1rem; line-height:1.5;">
      {body}
    </p>
  )}
  
  <div class="alumni-destination">
    <i class="fas fa-briefcase"></i> <strong>{data.destinationRole}</strong><br />
    <span style="color:var(--text-muted); font-size:0.8rem;">{data.destinationOrg}</span>
  </div>
</div>
