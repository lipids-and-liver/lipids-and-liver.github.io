---
import type { CollectionEntry } from 'astro:content';
import { getTranslations, getLocalizedPath, type Locale } from '../../utils/i18n';

interface Props {
  patent: CollectionEntry<'patents'>;
  lang?: Locale;
}

const { patent, lang = 'es' } = Astro.props;
const {
  title,
  applicationNumber,
  publicationNumber,
  year,
  applicationDate,
  publicationDate,
  applicant,
  inventors,
  groupInventors,
  scope,
  status,
  badge,
  abstract,
  invenesUrl,
  pdfUrl,
  ehuUrl
} = patent.data;

const t = getTranslations(lang);

// Format dates nicely
const formatDate = (dateStr?: string | null) => {
  if (!dateStr) return '';
  const [year, month, day] = dateStr.split('-');
  return `${day}/${month}/${year}`;
};
---

<article class="patent-card-inst">
  <div class="patent-card-header">
    <div class="patent-badges">
      <span class="patent-status-badge">
        <i class="fas fa-certificate"></i> {status}
      </span>
      <span class="patent-badge-type">
        <i class="fas fa-shield-alt"></i> {badge}
      </span>
      <span class="patent-scope-badge">
        <i class="fas fa-globe-europe"></i> {scope}
      </span>
    </div>
    <div class="patent-year-tag">
      <i class="fas fa-calendar-check"></i> {year}
    </div>
  </div>

  <div class="patent-card-body">
    <h3 class="patent-card-title">
      {pdfUrl ? (
        <a href={pdfUrl} target="_blank" rel="noopener" title={t.patents_download_pdf}>
          {title} <i class="fas fa-external-link-alt title-ext-icon"></i>
        </a>
      ) : (
        <span>{title}</span>
      )}
    </h3>

    <!-- Identification Grid -->
    <div class="patent-meta-grid">
      <div class="patent-meta-item">
        <span class="patent-meta-label"><i class="fas fa-file-signature"></i> {t.patents_publication_num}:</span>
        <span class="patent-meta-val code-highlight">{publicationNumber}</span>
        {publicationDate && <span class="patent-meta-sub">({formatDate(publicationDate)})</span>}
      </div>

      <div class="patent-meta-item">
        <span class="patent-meta-label"><i class="fas fa-hashtag"></i> {t.patents_application_num}:</span>
        <span class="patent-meta-val code-highlight">{applicationNumber}</span>
        {applicationDate && <span class="patent-meta-sub">({formatDate(applicationDate)})</span>}
      </div>

      <div class="patent-meta-item full-width">
        <span class="patent-meta-label"><i class="fas fa-university"></i> {t.patents_applicant}:</span>
        <span class="patent-meta-val">{applicant}</span>
      </div>
    </div>

    <!-- Inventors Box -->
    <div class="patent-inventors-box">
      <span class="patent-inventors-title">
        <i class="fas fa-users-cog"></i> {t.patents_inventors}:
      </span>
      <div class="patent-inventors-list">
        {inventors.map((inv: string) => {
          const isGroupMember = groupInventors && groupInventors.some((g: string) => inv.toLowerCase().includes(g.toLowerCase()) || g.toLowerCase().includes(inv.toLowerCase()));
          const isYuri = inv.toLowerCase().includes('yuri') || inv.toLowerCase().includes('rueda');
          
          return (
            <span class={`inventor-tag ${isGroupMember ? 'inventor-group-member' : ''}`}>
              {isGroupMember && <i class="fas fa-star" title="Investigador/a Lipids & Liver"></i>}
              {isYuri ? (
                <a href={getLocalizedPath('/curriculum/yuri-rueda', lang)} class="inventor-link" title="Ver CV de Yuri Rueda">
                  {inv}
                </a>
              ) : (
                <span>{inv}</span>
              )}
            </span>
          );
        })}
      </div>
    </div>

    <!-- Abstract -->
    {abstract && (
      <div class="patent-abstract-box">
        <span class="patent-abstract-title"><i class="fas fa-align-left"></i> {t.patents_abstract}</span>
        <p class="patent-abstract-text">{abstract}</p>
      </div>
    )}
  </div>

  <!-- Footer Actions -->
  <div class="patent-card-footer">
    <div class="patent-footer-links">
      {pdfUrl && (
        <a href={pdfUrl} target="_blank" rel="noopener" class="btn-patent-primary">
          <i class="fas fa-file-pdf"></i> {t.patents_download_pdf}
        </a>
      )}
      {invenesUrl && (
        <a href={invenesUrl} target="_blank" rel="noopener" class="btn-patent-secondary">
          <i class="fas fa-database"></i> {t.patents_view_oepm}
        </a>
      )}
      {ehuUrl && (
        <a href={ehuUrl} target="_blank" rel="noopener" class="btn-patent-secondary">
          <i class="fas fa-university"></i> {t.patents_ehu_portal}
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .patent-card-inst {
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .patent-card-inst:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
    border-color: var(--logo-green, #689F38);
  }

  .patent-card-header {
    background: var(--bg-surface-alt, #f8fafc);
    border-bottom: 1px solid var(--border-color, #e2e8f0);
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .patent-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .patent-status-badge {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global([data-theme="dark"]) .patent-status-badge {
    background: rgba(6, 95, 70, 0.25);
    color: #6ee7b7;
    border-color: rgba(110, 231, 183, 0.3);
  }

  .patent-badge-type {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global([data-theme="dark"]) .patent-badge-type {
    background: rgba(30, 64, 175, 0.25);
    color: #93c5fd;
    border-color: rgba(147, 197, 253, 0.3);
  }

  .patent-scope-badge {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global([data-theme="dark"]) .patent-scope-badge {
    background: rgba(71, 85, 105, 0.3);
    color: #cbd5e1;
    border-color: rgba(203, 213, 225, 0.2);
  }

  .patent-year-tag {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ehu-navy, #002B49);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global([data-theme="dark"]) .patent-year-tag {
    color: #93c5fd;
  }

  .patent-card-body {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .patent-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ehu-navy, #002B49);
    line-height: 1.4;
    margin: 0;
  }

  :global([data-theme="dark"]) .patent-card-title {
    color: #f8fafc;
  }

  .patent-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .patent-card-title a:hover {
    color: var(--logo-green, #689F38);
  }

  .title-ext-icon {
    font-size: 0.8rem;
    opacity: 0.6;
    margin-left: 0.35rem;
    vertical-align: middle;
  }

  .patent-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem 1.5rem;
    background: var(--bg-surface-alt, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.88rem;
  }

  .patent-meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .patent-meta-item.full-width {
    grid-column: 1 / -1;
  }

  .patent-meta-label {
    color: var(--text-muted, #64748b);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .patent-meta-val {
    color: var(--text-primary, #0f172a);
    font-weight: 600;
  }

  .patent-meta-val.code-highlight {
    font-family: monospace;
    background: #e2e8f0;
    color: #0f172a;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  :global([data-theme="dark"]) .patent-meta-val.code-highlight {
    background: #334155;
    color: #e2e8f0;
  }

  .patent-meta-sub {
    color: var(--text-muted, #64748b);
    font-size: 0.8rem;
  }

  .patent-inventors-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .patent-inventors-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .patent-inventors-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .inventor-tag {
    background: var(--bg-surface-alt, #f1f5f9);
    border: 1px solid var(--border-color, #cbd5e1);
    color: var(--text-secondary, #334155);
    font-size: 0.82rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  :global([data-theme="dark"]) .inventor-tag {
    background: #1e293b;
    border-color: #334155;
    color: #cbd5e1;
  }

  .inventor-tag.inventor-group-member {
    background: #f0fdf4;
    border-color: #86efac;
    color: #166534;
    font-weight: 600;
  }

  :global([data-theme="dark"]) .inventor-tag.inventor-group-member {
    background: rgba(22, 101, 52, 0.25);
    border-color: rgba(134, 239, 172, 0.3);
    color: #86efac;
  }

  .inventor-tag.inventor-group-member i {
    color: #eab308;
    font-size: 0.75rem;
  }

  .inventor-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dashed currentColor;
  }

  .inventor-link:hover {
    color: var(--logo-green, #689F38);
  }

  .patent-abstract-box {
    background: var(--bg-surface-alt, #f8fafc);
    border-left: 3px solid var(--logo-green, #689F38);
    padding: 0.85rem 1rem;
    border-radius: 0 6px 6px 0;
  }

  .patent-abstract-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .patent-abstract-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary, #475569);
    margin: 0;
  }

  .patent-card-footer {
    padding: 1rem 1.5rem;
    background: var(--bg-surface-alt, #f8fafc);
    border-top: 1px solid var(--border-color, #e2e8f0);
  }

  .patent-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .btn-patent-primary {
    background: var(--logo-green, #689F38);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn-patent-primary:hover {
    background: #558b2f;
    transform: translateY(-1px);
    color: #ffffff;
  }

  .btn-patent-secondary {
    background: var(--bg-surface, #ffffff);
    color: var(--ehu-navy, #002B49);
    border: 1px solid var(--border-color, #cbd5e1);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  :global([data-theme="dark"]) .btn-patent-secondary {
    background: #1e293b;
    color: #e2e8f0;
    border-color: #334155;
  }

  .btn-patent-secondary:hover {
    border-color: var(--logo-green, #689F38);
    color: var(--logo-green, #689F38);
  }
</style>
